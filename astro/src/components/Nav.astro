---
// Nav: fixed top bar with logo, responsive desktop menu, language switcher, mobile menu toggle.
// Menu activates at lg (≥1024px). Below that, the hamburger dropdown handles navigation.
// Links point to "#" for pages not yet ported.
---
<nav class="fixed top-0 w-full z-50 bg-neutral-950/80 backdrop-blur-md tonal-shift">
  <div class="flex items-center justify-between gap-4 w-full px-4 sm:px-6 py-3 lg:grid lg:grid-cols-[1fr_auto_1fr]">
    <a href="/" class="flex items-center shrink-0 lg:justify-self-start">
      <img
        src="/assets/images/logo-horizontal.png"
        alt="Aristurtle Logo"
        class="h-12 sm:h-14 md:h-16 lg:h-20 w-auto"
      />
    </a>

    <div class="hidden lg:flex justify-center items-center gap-4 xl:gap-6 min-w-0">
      <a class="font-headline tracking-tight font-bold uppercase text-sm xl:text-base text-secondary border-b-2 border-secondary pb-1 whitespace-nowrap" href="/">Home</a>
      <a class="font-headline tracking-tight font-bold uppercase text-sm xl:text-base text-neutral-400 hover:text-white transition-colors whitespace-nowrap" href="#">About</a>
      <a class="font-headline tracking-tight font-bold uppercase text-sm xl:text-base text-neutral-400 hover:text-white transition-colors whitespace-nowrap" href="#">Cars</a>
      <a class="font-headline tracking-tight font-bold uppercase text-sm xl:text-base text-neutral-400 hover:text-white transition-colors whitespace-nowrap" href="#">Divisions</a>
      <a class="font-headline tracking-tight font-bold uppercase text-sm xl:text-base text-neutral-400 hover:text-white transition-colors whitespace-nowrap" href="#">Partners</a>
      <a class="font-headline tracking-tight font-bold uppercase text-sm xl:text-base text-neutral-400 hover:text-white transition-colors whitespace-nowrap" href="#">Recruitment</a>
      <a class="font-headline tracking-tight font-bold uppercase text-sm xl:text-base text-neutral-400 hover:text-white transition-colors whitespace-nowrap" href="#">Contact</a>
    </div>

    <div class="flex items-center gap-3 sm:gap-4 shrink-0 lg:justify-self-end">
      <div class="text-neutral-400 font-label text-sm sm:text-base tracking-widest hover:text-secondary cursor-pointer transition-all lang-switcher">EN/GR</div>
      <button class="lg:hidden text-white mobile-menu-btn" aria-label="Toggle menu">
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu hidden lg:hidden bg-neutral-950 border-t border-outline-variant/20">
    <div class="flex flex-col px-6 py-3 gap-3">
      <a class="text-secondary font-bold uppercase text-base" href="/">Home</a>
      <a class="text-neutral-400 hover:text-white uppercase text-base" href="#">About</a>
      <a class="text-neutral-400 hover:text-white uppercase text-base" href="#">Cars</a>
      <a class="text-neutral-400 hover:text-white uppercase text-base" href="#">Divisions</a>
      <a class="text-neutral-400 hover:text-white uppercase text-base" href="#">Partners</a>
      <a class="text-neutral-400 hover:text-white uppercase text-base" href="#">Recruitment</a>
      <a class="text-neutral-400 hover:text-white uppercase text-base" href="#">Contact</a>
    </div>
  </div>
</nav>

<style>
  /* Scoped to Nav: dark gradient behind the fixed bar */
  .tonal-shift {
    background: linear-gradient(180deg, rgba(27, 28, 28, 1) 0%, rgba(19, 19, 19, 1) 100%);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector('.mobile-menu-btn');
    const menu = document.querySelector('.mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => menu.classList.toggle('hidden'));
    }
    const lang = document.querySelector('.lang-switcher');
    if (lang) {
      lang.addEventListener('click', () => alert('Greek language support coming soon!'));
    }
  });
</script>
