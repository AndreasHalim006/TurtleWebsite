---
<footer class="bg-neutral-900 border-t border-neutral-800">
  <div class="grid grid-cols-1 lg:grid-cols-[auto_auto_1fr] gap-6 lg:gap-10 px-6 sm:px-10 lg:px-12 py-6 lg:py-8 w-full lg:items-stretch">
    <!-- Column 1: Logo — absolute inside a self-stretch wrapper so its intrinsic
         size does NOT drive the grid row height; the content column does. -->
    <div class="flex justify-center lg:block lg:relative lg:self-stretch lg:w-56 xl:w-64">
      <Image
        src={logo}
        alt="Aristurtle Racing Team logo"
        width={400}
        height={400}
        class="w-40 h-auto lg:absolute lg:inset-0 lg:w-full lg:h-full object-contain"
      />
    </div>

    <!-- Column 2: Brand + tagline + location + socials -->
    <div class="flex flex-col gap-3 min-w-0 lg:w-80 lg:max-w-xs">
      <div>
        <div class="text-xl lg:text-2xl font-black text-white font-headline tracking-tight leading-none">ARISTURTLE</div>
        <p class="text-neutral-400 font-body text-xs leading-snug mt-1.5 max-w-xl">
          The premier electric and autonomous racing team of Aristotle University of Thessaloniki.
        </p>
      </div>

      <address class="not-italic text-neutral-500 font-body text-xs leading-snug">
        <div class="text-neutral-300">Aristotle University of Thessaloniki</div>
        <div>University Campus, 54124 Thessaloniki, Greece</div>
      </address>

      <ul class="flex flex-col gap-1.5">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-link group inline-flex items-center gap-3 text-neutral-500 hover:text-secondary transition-colors"
              aria-label={`${s.name} — ${s.hostPath}`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox={s.viewBox}
                width="16"
                height="16"
                fill="currentColor"
                aria-hidden="true"
                class="shrink-0"
              >
                <path d={s.path} />
              </svg>
              <span class="font-label text-[11px] uppercase tracking-widest text-neutral-300 group-hover:text-secondary transition-colors w-20 shrink-0">
                {s.name}
              </span>
              <span class="social-url font-label text-[11px] lowercase tracking-wide truncate">
                {s.hostPath}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 3: Map (fills remaining horizontal space) -->
    <div class="w-full lg:h-full lg:min-w-0">
      <a
        href={mapShortUrl}
        target="_blank"
        rel="noopener"
        class="map-link relative block w-full lg:h-full overflow-hidden rounded-lg border border-neutral-800 hover:border-secondary transition-colors"
        aria-label="Open Aristurtle workshop location in Google Maps"
      >
        <div class="map-frame relative w-full lg:h-full">
          <iframe
            src={mapSrc}
            title="Map showing Aristurtle workshop location"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            frameborder="0"
            style="border:0"
            class="absolute inset-0 w-full h-full"
          ></iframe>
          <span class="map-overlay absolute inset-0 cursor-pointer" aria-hidden="true"></span>
        </div>
      </a>
    </div>
  </div>

  <div class="px-6 sm:px-10 lg:px-12 py-4 border-t border-neutral-800/50">
    <div class="text-neutral-500 font-label text-[10px] sm:text-xs tracking-widest uppercase text-center lg:text-left">
      © 2026 ARISTOTLE UNIVERSITY RACING TEAM ELECTRIC AND DRIVERLESS
    </div>
  </div>
</footer>

<style>
  /* Map: on mobile, fixed aspect ratio; on lg+ it stretches to fill the grid row height */
  .map-frame {
    aspect-ratio: 16 / 10;
    min-height: 256px;
  }
  @media (min-width: 1024px) {
    .map-frame {
      aspect-ratio: auto;
      min-height: 0;
    }
  }

  /* Make iframe a static thumbnail — all clicks go to the parent <a> via the overlay */
  .map-frame iframe {
    pointer-events: none;
  }
  .map-overlay {
    pointer-events: auto;
  }
</style>
