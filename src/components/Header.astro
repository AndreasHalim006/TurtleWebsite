---
import logo from "../images/Turtle_logo_only.svg";
import { navLinks, joinLink, contact, socials } from "../data/site";

interface Props {
    forceCompact?: boolean;
}

const { forceCompact = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
const href = (path: string) =>
    path === "/" ? baseUrl : `${baseUrl}${path.replace(/^\//, "")}`;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (path: string) =>
    path === "/"
        ? current === "/" || current === baseUrl.replace(/\/$/, "")
        : current.endsWith(path);
---

<header
    id="site-header"
    class="site-header"
    data-solid={forceCompact ? "true" : "false"}
    data-force-solid={forceCompact ? "true" : "false"}
>
    <div class="site-header__bar container-site">
        <div class="site-header__left">
            <button
                type="button"
                id="menu-toggle"
                class="site-header__burger"
                aria-expanded="false"
                aria-controls="menu-overlay"
                aria-label="Open menu"
            >
                <span></span>
                <span></span>
            </button>
        </div>

        <a
            href={href("/")}
            class="site-header__logo"
            aria-label="ARISTURTLE home"
        >
            <img
                src={logo.src}
                width={logo.width}
                height={logo.height}
                alt="ARISTURTLE"
            />
        </a>

        <div class="site-header__right">
            <a href={href(joinLink.href)} class="btn site-header__cta">
                {joinLink.label}
            </a>
        </div>
    </div>

    <div
        id="menu-overlay"
        class="menu-overlay"
        role="dialog"
        aria-modal="true"
        aria-label="Site menu"
        aria-hidden="true"
        inert
    >
        <div class="menu-overlay__inner container-site">
            <nav aria-label="Primary" class="menu-overlay__nav">
                <ul>
                    {navLinks.map((l) => (
                        <li>
                            <a
                                href={href(l.href)}
                                aria-current={
                                    isCurrent(l.href) ? "page" : undefined
                                }
                            >
                                {l.label}
                            </a>
                        </li>
                    ))}
                    <li>
                        <a
                            href={href(joinLink.href)}
                            aria-current={
                                isCurrent(joinLink.href) ? "page" : undefined
                            }
                        >
                            {joinLink.label}
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="menu-overlay__side">
                <p class="eyebrow">Contact</p>
                <a href={`mailto:${contact.email}`} class="link-inline">
                    {contact.email}
                </a>
                <p class="eyebrow">Follow</p>
                <ul>
                    {socials.map((s) => (
                        <li>
                            <a
                                href={s.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="link-inline"
                            >
                                {s.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </div>
</header>

<style is:global>
    .site-header {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 60;
        background: transparent;
        border-bottom: 1px solid transparent;
        transition:
            background-color 0.4s ease,
            border-color 0.4s ease;
    }
    .site-header[data-solid="true"] {
        background: var(--color-void);
        border-bottom-color: var(--color-line);
    }
    .site-header__bar {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        height: 4.5rem;
    }
    .site-header__left {
        display: flex;
        align-items: center;
    }
    .site-header__right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }
    .site-header__logo img {
        display: block;
        height: 28px;
        width: auto;
    }
    @media (min-width: 768px) {
        .site-header__logo img {
            height: 34px;
        }
    }
    .site-header__cta {
        min-height: 2.5rem;
        padding: 0.5rem 1.25rem;
    }

    .site-header__burger {
        position: relative;
        width: 2.75rem;
        height: 2.75rem;
        border: 0.5px solid var(--button-border);
        border-radius: 2px;
        background: var(--button-bg);
        -webkit-backdrop-filter: blur(5px);
        backdrop-filter: blur(5px);
        cursor: pointer;
        transition: border-color 0.3s ease;
    }
    .site-header__burger:hover {
        border-color: var(--color-brand-orange);
    }
    .site-header__burger span {
        position: absolute;
        left: 50%;
        width: 1.1rem;
        height: 1.5px;
        background: #fff;
        transform: translateX(-50%);
        transition:
            transform 0.35s ease,
            top 0.35s ease;
    }
    .site-header__burger span:nth-child(1) {
        top: calc(50% - 4px);
    }
    .site-header__burger span:nth-child(2) {
        top: calc(50% + 3px);
    }
    .site-header__burger[aria-expanded="true"] span:nth-child(1) {
        top: calc(50% - 1px);
        transform: translateX(-50%) rotate(45deg);
    }
    .site-header__burger[aria-expanded="true"] span:nth-child(2) {
        top: calc(50% - 1px);
        transform: translateX(-50%) rotate(-45deg);
    }

    .menu-overlay {
        position: fixed;
        inset: 0;
        z-index: 1;
        padding-top: 6rem;
        background: var(--color-void);
        overflow-y: auto;
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.35s ease,
            visibility 0s linear 0.35s;
    }
    html.menu-open .menu-overlay {
        opacity: 1;
        visibility: visible;
        transition:
            opacity 0.35s ease,
            visibility 0s;
    }
    .menu-overlay__inner {
        display: grid;
        gap: 3rem;
        padding-block: 1rem 4rem;
        grid-template-columns: 1fr;
    }
    @media (min-width: 1024px) {
        .menu-overlay__inner {
            grid-template-columns: 2fr 1fr;
            align-items: end;
            min-height: calc(100svh - 8rem);
        }
    }
    .menu-overlay__nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .menu-overlay__nav a {
        display: block;
        padding-block: 0.5rem;
        border-bottom: 1px solid var(--color-line);
        color: #fff;
        text-decoration: none;
        font-family: var(--font-display);
        font-weight: 700;
        text-transform: uppercase;
        line-height: 1.1;
        font-size: clamp(1.75rem, 4.5vw, 3rem);
        transition:
            color 0.3s ease,
            padding-left 0.35s ease;
    }
    .menu-overlay__nav a:hover,
    .menu-overlay__nav a[aria-current="page"] {
        color: var(--color-brand-orange);
        padding-left: 0.5rem;
    }
    .menu-overlay__side {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
    }
    .menu-overlay__side ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
</style>

<script>
    import "../scripts/header";
</script>
