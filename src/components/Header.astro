---
import logo from "../images/Turtle_logo_only.svg";
import { navLinks, joinLink } from "../data/site";

interface Props { forceCompact?: boolean; }
const { forceCompact = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => path === "/" ? baseUrl : `${baseUrl}${path.replace(/^\//, "")}`;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (path: string) => path === "/"
    ? current === "/" || current === baseUrl.replace(/\/$/, "")
    : current.endsWith(path);
---

<header id="site-header" class="site-header" data-solid={forceCompact ? "true" : "false"} data-force-solid={forceCompact ? "true" : "false"}>
    <div class="site-header__bar container-site">
        <a href={href("/")} class="site-header__logo" aria-label="ARISTURTLE home">
            <img src={logo.src} width={logo.width} height={logo.height} alt="ARISTURTLE" />
        </a>
        <nav class="site-header__nav" aria-label="Primary">
            <ul>
                {[...navLinks, joinLink].map((link) => (
                    <li>
                        <a href={href(link.href)} aria-current={isCurrent(link.href) ? "page" : undefined} class:list={["site-header__link", { "site-header__link--join": link.href === joinLink.href }]}>
                            {link.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>

<style is:global>
    html { scroll-padding-top: calc(var(--site-header-height, 7.5rem) + 1rem); }
    .site-header {
        position: fixed;
        inset: 0 0 auto;
        z-index: 60;
        background: linear-gradient(180deg, rgba(10,10,10,.9), rgba(10,10,10,.35));
        border-bottom: 1px solid rgba(255,255,255,.12);
        transition: background-color .3s ease, border-color .3s ease;
    }
    .site-header[data-solid="true"] { background: var(--color-void); border-bottom-color: var(--color-line); }
    .site-header__bar { display: flex; flex-direction: column; align-items: center; min-width: 0; padding-top: 1rem; }
    .site-header__logo { flex: 0 0 auto; }
    .site-header__logo img { display: block; width: auto; height: 28px; }
    .site-header__nav {
        width: 100%;
        min-width: 0;
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--color-brand-orange) transparent;
        overscroll-behavior-inline: contain;
    }
    .site-header__nav ul { display: flex; align-items: center; gap: clamp(.4rem, 1vw, 1.25rem); width: max-content; min-width: 100%; justify-content: center; list-style: none; margin: 0; padding: .65rem 0; }
    .site-header__nav li { flex: 0 0 auto; }
    .site-header__link {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: .5rem .4rem;
        color: white;
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .03em;
        text-decoration: none;
        white-space: nowrap;
        border-bottom: 1px solid transparent;
        transition: color .2s ease, border-color .2s ease;
    }
    .site-header__link:hover, .site-header__link[aria-current="page"] { color: var(--color-brand-orange); border-bottom-color: var(--color-brand-orange); }
    .site-header__link--join { padding-inline: .8rem; border: 1px solid var(--button-border); }
    .site-header__link:focus-visible { outline-offset: -3px; }
    @media (min-width: 1024px) {
        .site-header__bar { min-height: 5rem; flex-direction: row; justify-content: space-between; gap: 2rem; padding-top: 0; }
        .site-header__logo img { height: 34px; }
        .site-header__nav { width: auto; }
        .site-header__nav ul { justify-content: flex-end; }
        .site-header__link { font-size: .8rem; }
    }
    @media (prefers-reduced-motion: reduce) { .site-header, .site-header__link { transition: none; } }
</style>

<script>
    import "../scripts/header";
</script>
