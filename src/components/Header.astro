---
import logo from '../images/Turtle_logo_only.svg';
import { navLinks, joinLink, contact, socials } from '../data/site';

interface Props {
  forceCompact?: boolean;
}

const { forceCompact = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => (path === '/' ? baseUrl : `${baseUrl}${path.replace(/^\//, '')}`);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (path: string) => (path === '/' ? current === '/' || current === baseUrl.replace(/\/$/, '') : current.endsWith(path));
---

<header
  id="site-header"
  class="site-header"
  data-compact={forceCompact ? 'true' : 'false'}
  data-force-compact={forceCompact ? 'true' : 'false'}
>
  <div class="site-header__bar container-site">
    <a href={href('/')} class="site-header__logo" aria-label="ARISTURTLE home">
      <img src={logo.src} width={logo.width} height={logo.height} alt="ARISTURTLE" />
    </a>

    <div class="site-header__actions">
      <a href={href(joinLink.href)} class="btn btn--solid site-header__cta">{joinLink.label}</a>
      <button
        type="button"
        id="menu-toggle"
        class="site-header__burger"
        aria-expanded="false"
        aria-controls="menu-overlay"
        aria-label="Open menu"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div id="menu-overlay" class="menu-overlay" role="dialog" aria-modal="true" aria-label="Site menu" aria-hidden="true" inert data-lenis-prevent>
    <div class="menu-overlay__inner container-site">
      <nav aria-label="Primary" class="menu-overlay__nav">
        <ul>
          {navLinks.map((l, i) => (
            <li>
              <a href={href(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                <span class="menu-overlay__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="menu-overlay__label">{l.label}</span>
              </a>
            </li>
          ))}
          <li>
            <a href={href(joinLink.href)} aria-current={isCurrent(joinLink.href) ? 'page' : undefined}>
              <span class="menu-overlay__num">{String(navLinks.length + 1).padStart(2, '0')}</span>
              <span class="menu-overlay__label">{joinLink.label}</span>
            </a>
          </li>
        </ul>
      </nav>
      <div class="menu-overlay__side">
        <p class="eyebrow">Contact</p>
        <a href={`mailto:${contact.email}`} class="link-inline">{contact.email}</a>
        <p class="eyebrow">Follow</p>
        <ul>
          {socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener noreferrer" class="link-inline">{s.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>

<style is:global>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    --bar-h: 112px;
    --logo-h: 52px;
    transition: background-color 0.6s var(--ease-luxe), border-color 0.6s var(--ease-luxe);
    background: transparent;
    border-bottom: 1px solid transparent;
  }
  .site-header[data-compact='true'] {
    --bar-h: 68px;
    --logo-h: 30px;
    background: var(--color-void);
    border-bottom-color: var(--color-line);
  }
  .site-header__bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--bar-h);
    transition: height 0.6s var(--ease-luxe);
  }
  .site-header__logo img {
    display: block;
    height: var(--logo-h);
    width: auto;
    transition: height 0.6s var(--ease-luxe);
  }
  .site-header__actions { display: flex; align-items: center; gap: 1rem; }
  .site-header__cta { min-height: 2.75rem; padding: 0.5rem 1.4rem; }
  @media (max-width: 639px) { .site-header__cta { display: none; } }

  .site-header__burger {
    position: relative;
    width: 3rem;
    height: 3rem;
    background: transparent;
    border: 2px solid #fff;
    cursor: pointer;
    transition: border-color 0.4s var(--ease-luxe);
  }
  .site-header__burger:hover { border-color: var(--color-brand-orange); }
  .site-header__burger span {
    position: absolute;
    left: 50%;
    width: 1.25rem;
    height: 2px;
    background: #fff;
    transform: translateX(-50%);
    transition: transform 0.5s var(--ease-luxe), top 0.5s var(--ease-luxe);
  }
  .site-header__burger span:nth-child(1) { top: calc(50% - 5px); }
  .site-header__burger span:nth-child(2) { top: calc(50% + 3px); }
  .site-header__burger[aria-expanded='true'] span:nth-child(1) { top: calc(50% - 1px); transform: translateX(-50%) rotate(45deg); }
  .site-header__burger[aria-expanded='true'] span:nth-child(2) { top: calc(50% - 1px); transform: translateX(-50%) rotate(-45deg); }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
    padding-top: calc(var(--bar-h) + 1rem);
    background: var(--color-void);
    overflow-y: auto;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition: clip-path 0.9s var(--ease-luxe), visibility 0s linear 0.9s;
  }
  html.menu-open .menu-overlay {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition: clip-path 0.9s var(--ease-luxe), visibility 0s;
  }
  .menu-overlay__inner {
    display: grid;
    gap: 3rem;
    padding-block: 2rem 4rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 1024px) {
    .menu-overlay__inner { grid-template-columns: 2fr 1fr; align-items: end; min-height: calc(100svh - var(--bar-h) - 3rem); }
  }
  .menu-overlay__nav ul { list-style: none; padding: 0; margin: 0; }
  .menu-overlay__nav a {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 0.35rem;
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    transition: color 0.4s var(--ease-luxe), padding-left 0.5s var(--ease-luxe);
  }
  .menu-overlay__nav a:hover,
  .menu-overlay__nav a[aria-current='page'] { color: var(--color-brand-orange); padding-left: 0.75rem; }
  .menu-overlay__num { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.2em; color: var(--color-muted); }
  .menu-overlay__label {
    font-weight: 700;
    text-transform: lowercase;
    line-height: 1.1;
    font-size: clamp(1.9rem, 5vw, 4rem);
  }
  .menu-overlay__side { display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }
  .menu-overlay__side ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
</style>

<script>
  import '../scripts/header';
</script>
