---
import { Image } from 'astro:assets';
import { cars } from '../data/cars';
const [latest, ...archive] = cars;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="journey border-t border-line bg-void section-pad" aria-labelledby="journey-title">
  <div class="container-site">
    <div class="journey__head">
      <div>
        <p class="eyebrow mb-4">Our evolution</p>
        <h2 id="journey-title" class="h-section" data-reveal>one car at a time</h2>
        <p class="lead mt-4" data-reveal>Every car a new chapter. Every season a step forward.</p>
      </div>
      <a href={`${base}/cars`} class="btn self-start">Explore Our Cars &rarr;</a>
    </div>

    <a href={`${base}/cars#${latest.id}`} class="journey__feature" aria-label={`Explore ${latest.name}, ${latest.years}`}>
      {latest.image && <Image src={latest.image} alt={`${latest.name} race car`} class="journey__photo" widths={[600, 1000, 1600]} sizes="90vw" loading="lazy" />}
      <div class="journey__caption">
        <p class="eyebrow">{latest.years}</p>
        <h3>{latest.name}</h3>
        <span class="journey__discover">Discover the car &nearr;</span>
      </div>
    </a>

    <div class="journey__archive mt-10">
      <h3 class="eyebrow mb-5">The cars that came before</h3>
      <ol class="journey__names" aria-label="Previous cars, newest first">
        {archive.map((car, index) => (
          <li>
            <a href={`${base}/cars#${car.id}`}>
              <span class="journey__number" aria-hidden="true">{String(archive.length - index).padStart(2, '0')}</span>
              <span class="journey__name">{car.name}</span>
              <span class="journey__year">{car.years}</span>
              <span class="journey__arrow" aria-hidden="true">&nearr;</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .journey__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.5rem; margin-bottom: 2.5rem; }
  .journey__feature { position: relative; isolation: isolate; display: flex; align-items: end; min-height: 25rem; aspect-ratio: 16/9; padding: clamp(1.5rem, 4vw, 4rem); overflow: hidden; background: var(--color-panel); color: white; text-decoration: none; }
  .journey__feature::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 25%, rgb(0 0 0 / 0.9)); }
  .journey__photo { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .journey__feature:hover .journey__photo { transform: scale(1.025); }
  .journey__caption h3 { font-family: var(--font-display); text-transform: uppercase; font-size: clamp(2rem, 6vw, 5rem); font-weight: 700; line-height: 1.1; margin-top: 0.5rem; overflow-wrap: anywhere; }
  .journey__discover { display: block; margin-top: 1.25rem; font-size: 0.875rem; color: rgb(255 255 255 / 0.8); }
  .journey__names { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: 3rem; list-style: none; padding: 0; margin: 0; }
  .journey__names a { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr) auto; align-items: center; gap: 1rem; min-height: 6rem; padding-block: 1.25rem; border-top: 1px solid var(--color-line); color: var(--color-foreground); text-decoration: none; }
  .journey__number { color: var(--color-muted); font-size: 0.65rem; }
  .journey__name { font-family: var(--font-display); font-size: clamp(1.25rem, 2.3vw, 2rem); font-weight: 700; overflow-wrap: anywhere; transition: color 0.2s ease; }
  .journey__year { color: var(--color-muted); font-size: 0.75rem; grid-column: 2; }
  .journey__arrow { grid-column: 3; grid-row: 1 / span 2; color: var(--color-brand-orange); font-size: 1.5rem; transition: transform 0.2s ease; }
  .journey__names a:hover .journey__name, .journey__names a:focus-visible .journey__name { color: var(--color-brand-orange); }
  .journey__names a:hover .journey__arrow { transform: translate(2px, -2px); }
  @media (min-width: 768px) { .journey__names { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 639px) { .journey__feature { aspect-ratio: 4/5; min-height: 22rem; } }
  @media (prefers-reduced-motion: reduce) { .journey__photo, .journey__name, .journey__arrow { transition: none; } }
</style>
