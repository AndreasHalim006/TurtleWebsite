---
import BlindsHero from '../BlindsHero.astro';

export interface Props {
  totalSponsors: number;
  totalTiers: number;
}

const { totalSponsors, totalTiers } = Astro.props;
---

<section id="hero" class="relative min-h-[100svh] w-full flex flex-col items-center justify-center isolate">
  
  <BlindsHero title="SPONSORS" description="The technical, industrial, academic, and media partners powering Aristurtle on and off track." gradientColors={['#9FFF10', '#00F3CB']} />

</section>
