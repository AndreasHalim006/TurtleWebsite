---
import Grainient from '../reactbits/Grainient';

export interface Sponsor {
  name: string;
  logo: string;
  website?: string;
  alt: string;
}

export interface Tier {
  id: string;
  title: string;
  description: string;
  countLabel: string;
  sponsors: Sponsor[];
}

export interface Props {
  tiers: Tier[];
}

const { tiers } = Astro.props;
const tierCount = tiers.length;
---

<section 
  id="sponsor-assembly" 
  class="relative bg-[var(--void)] min-h-[calc(var(--tier-count)*160svh)] max-lg:min-h-fit max-lg:pt-4 motion-reduce:min-h-fit"
  style={`--tier-count: ${tierCount};`}
>
  <div id="assembly-data" data-tiers={JSON.stringify(tiers)} style="display: none;"></div>

  <div class="assembly-shell sticky top-0 min-h-[100svh] overflow-hidden isolate [--assembly-progress:0] motion-reduce:relative motion-reduce:grid motion-reduce:gap-[4rem] motion-reduce:min-h-fit motion-reduce:px-[clamp(1.25rem,5vw,5rem)] motion-reduce:py-[6rem] max-lg:relative max-lg:grid max-lg:gap-0 max-lg:min-h-fit max-lg:overflow-visible max-lg:px-[var(--mobile-gutter)] max-lg:py-12">
    <div class="absolute inset-0 -z-30 max-lg:hidden" aria-hidden="true">
      <Grainient
        client:media="(min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference)"
        color1="#2D2D2D"
        color2="#1A1A1A"
        color3="#0C0C0C"
        timeSpeed={0.08}
        colorBalance={0.35}
        warpStrength={0.28}
        warpFrequency={1.8}
        warpSpeed={0.35}
        warpAmplitude={42}
        blendSoftness={0.18}
        noiseScale={1.1}
        grainAmount={0.08}
        contrast={1.35}
        saturation={0.72}
        zoom={1.05}
      />
      
      <!-- grid-overlay -->
      <div 
        class="absolute inset-0 -z-20 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(circle_at_55%_52%,#000_0%,rgba(0,0,0,0.74)_44%,transparent_82%)] opacity-[calc(0.22+(var(--assembly-progress)*0.12))]"
      ></div>
      
      <!-- assembly-vignette -->
      <div 
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_44%,transparent_0%,rgba(10,10,10,0.16)_50%,#0A0A0A_100%),linear-gradient(90deg,rgba(10,10,10,0.91)_0%,transparent_28%,transparent_70%,rgba(10,10,10,0.92)_100%)]"
      ></div>
    </div>

    <!-- Main HUD (Top Left) -->
    <header class="assembly-hud absolute left-[clamp(1.25rem,4vw,4rem)] top-[clamp(8rem,14vh,12rem)] z-10 grid max-w-[min(30rem,36vw)] gap-2.5 pointer-events-none xl:max-w-[28rem] max-lg:hidden motion-reduce:hidden" aria-live="polite">
      <h2 id="active-tier-title" class="text-white text-[clamp(2.25rem,5vw,5.8rem)] font-bold leading-[0.88] uppercase">{tiers[0]?.title}</h2>
      
      <nav class="flex flex-col items-start gap-1.5 mt-4 mb-4 pointer-events-auto" aria-label="Micro tier index">
        {tiers.map((tier, index) => (
          <a 
            href={`#tier-step-${tier.id}`}
            class:list={[
              'micro-tier-link group flex items-center gap-2 transition-all duration-300',
              index === 0 ? 'is-active' : ''
            ]}
            data-micro-link={index}
            aria-label={`Go to ${tier.title} tier`}
          >
            <span class="block w-[2px] transition-all duration-300 h-2 bg-white/20 group-hover:bg-white/60 group-[.is-active]:h-4 group-[.is-active]:bg-[var(--brand-orange)]"></span>
            <span class="text-[0.65rem] font-bold tracking-[0.15em] uppercase transition-colors duration-300 text-white/30 group-hover:text-white/60 group-[.is-active]:text-white">{tier.title}</span>
          </a>
        ))}
      </nav>
    </header>

    <!-- Info HUD (Bottom Left) -->
    <div class="absolute left-[clamp(1.25rem,4vw,4rem)] bottom-[clamp(2rem,6vh,4rem)] z-10 flex flex-col gap-1.5 pointer-events-none max-lg:hidden motion-reduce:hidden" aria-live="polite">
      <p id="active-tier-count" class="text-white/58 text-[0.72rem] font-bold tracking-[0.26em] uppercase">{tiers[0]?.sponsors.length ?? 0} partners indexed</p>
      <p class="text-[var(--brand-orange)] text-[clamp(0.65rem,0.58rem+0.2vw,0.82rem)] font-bold tracking-[0.48em] leading-relaxed uppercase">// ACTIVE_TIER</p>
    </div>

    <!-- Rail -->
    <nav class="tier-rail absolute right-[clamp(1rem,3vw,3rem)] top-1/2 z-10 grid w-[min(13rem,18vw)] -translate-y-1/2 xl:hidden max-lg:hidden motion-reduce:hidden" aria-label="Sponsor tiers">
      {tiers.map((tier, index) => (
        <a href={`#tier-step-${tier.id}`} class:list={[
            'tier-rail-link grid grid-cols-[2rem_1fr] gap-2.5 border-l border-white/15 py-[0.55rem] pr-0 pl-[0.8rem] text-white/46 text-[clamp(0.58rem,0.7vw,0.72rem)] tracking-[0.1em] uppercase transition-all duration-200 ease-out', 
            index === 0 ? 'is-active border-[var(--brand-orange)] text-white -translate-x-[0.35rem]' : ''
          ]} data-tier-link={index}>
          <span class="text-[var(--brand-orange)]">{String(index + 1).padStart(2, '0')}</span>
          <strong>{tier.title}</strong>
        </a>
      ))}
    </nav>

    <!-- Honeycomb Field -->
    <div id="honeycomb-field" class="honeycomb-field absolute inset-0 z-0 overflow-hidden max-lg:hidden motion-reduce:hidden" aria-label="Interactive sponsor honeycomb">
      <svg class="honeycomb-idle-layer absolute inset-0 h-full w-full pointer-events-none" aria-hidden="true"></svg>
      <div class="honeycomb-active-layer absolute inset-0 h-full w-full z-[1]"></div>
    </div>

    <!-- Fallback Stage -->
    <div class="fallback-stage hidden max-lg:block motion-reduce:block w-full">
      {tiers.map((tier, index) => (
        <section id={`tier-${tier.id}`} class="fallback-tier border-b border-white/12 py-8 first:pt-2" aria-labelledby={`tier-title-${tier.id}`}>
          <header class="flex min-h-[72px] items-center gap-4 pb-5">
          <div class="grid gap-1.5 min-w-0">
            <p class="text-[var(--brand-orange)] text-[clamp(0.65rem,0.58rem+0.2vw,0.82rem)] font-bold tracking-[0.48em] leading-relaxed uppercase">// {String(index + 1).padStart(2, '0')}</p>
            <h2 id={`tier-title-${tier.id}`} class="text-white text-[clamp(1.7rem,9vw,3rem)] font-bold leading-[0.92] uppercase">{tier.title}</h2>
          </div>
          </header>

          <div class:list={['fallback-logo-grid grid w-full grid-cols-2 gap-x-3 gap-y-4 pb-4', tier.sponsors.length >= 18 && 'is-dense']}>
            {tier.sponsors.map((sponsor, sponsorIndex) => {
              const isCritical = index === 0 && sponsorIndex < 6;
              const content = (
                <>
                  <img
                    class="mobile-sponsor-logo relative z-[2] block object-contain"
                    src={sponsor.logo}
                    alt={sponsor.alt}
                    width="320"
                    height="180"
                    loading={isCritical ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={isCritical ? 'high' : 'low'}
                    data-critical-asset={isCritical ? '' : undefined}
                  />
                  <span class="logo-fallback relative z-[1] hidden px-3 text-center text-xs font-bold uppercase tracking-wider text-black">{sponsor.name}</span>
                </>
              );

              const cellClasses = "mobile-sponsor-hex relative grid place-items-center";

              return sponsor.website ? (
                <a
                  class={cellClasses}
                  href={sponsor.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Visit ${sponsor.name}`}
                >
                  {content}
                </a>
              ) : (
                <div class={cellClasses} aria-label={sponsor.name}>
                  {content}
                </div>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>

  <div class="assembly-steps absolute inset-0 -z-10 pointer-events-none max-lg:hidden motion-reduce:hidden" aria-hidden="true">
    {tiers.map((tier) => (
      <div id={`tier-step-${tier.id}`} class="tier-step min-h-[160svh]"></div>
    ))}
  </div>
</section>

<style is:global>
  /* Necessary styles that can't be easily put in Tailwind due to dynamic creation or highly specific interactions */
  .honeycomb-idle-hex {
    fill: rgba(255, 255, 255, 0.72);
  }

  .honeycomb-slot {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
    background: rgba(255, 255, 255, 0.72);
    pointer-events: none;
    transform-origin: center;
    will-change: transform, opacity;
    contain: layout paint style;
    backface-visibility: hidden;
  }

  .honeycomb-slot.is-active {
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 0.55rem 1.35rem rgba(0, 0, 0, 0.18);
    pointer-events: auto;
    transition: box-shadow 220ms ease, background 220ms ease, filter 220ms ease;
  }

  .honeycomb-slot[href] {
    cursor: pointer;
  }

  .honeycomb-slot.is-active:hover,
  .honeycomb-slot[href]:focus-visible {
    background: #fff;
    box-shadow: 0 0.6rem 1.5rem rgba(0, 0, 0, 0.24);
    outline: none;
  }

  .honeycomb-slot img {
    position: relative;
    z-index: 1;
    display: block;
    max-height: 82%;
    max-width: 82%;
    object-fit: contain;
    opacity: 0;
    pointer-events: none;
  }
  
  noscript .honeycomb-field,
  noscript .tier-rail,
  noscript .assembly-hud,
  noscript .assembly-steps {
    display: none !important;
  }

  noscript .fallback-stage {
    display: grid !important;
  }

  noscript #sponsor-assembly,
  noscript .assembly-shell {
    min-height: auto !important;
  }

  noscript .assembly-shell {
    position: relative !important;
    padding: 6rem clamp(1.25rem, 5vw, 5rem) !important;
  }

  @media (max-width: 1023px) {
    .fallback-stage,
    .fallback-tier,
    .fallback-logo-grid { width: 100%; min-width: 0; max-width: 100%; }
    .fallback-stage { overflow: hidden; }
    .fallback-tier h2 { overflow-wrap: anywhere; }
    .fallback-tier { scroll-margin-top: calc(var(--mobile-nav-height) + 1rem); }

    .mobile-sponsor-hex {
      aspect-ratio: 2 / 1.7320508076;
      min-width: 0;
      isolation: isolate;
      background: var(--brand-orange);
      clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
    }

    .mobile-sponsor-hex::before {
      content: '';
      position: absolute;
      inset: 1px;
      z-index: 0;
      background: rgba(255, 255, 255, 0.96);
      clip-path: inherit;
    }

    .mobile-sponsor-logo {
      width: 68%;
      height: 52%;
      max-width: 68%;
      max-height: 52%;
      object-fit: contain;
      object-position: center;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initSponsorAssembly = () => {
    const dataEl = document.getElementById('assembly-data');
    if (!dataEl) return;
    
    const tiers = JSON.parse(dataEl.getAttribute('data-tiers') || '[]');
    const field = document.querySelector<HTMLElement>('#honeycomb-field');
    const idleLayer = document.querySelector<SVGSVGElement>('.honeycomb-idle-layer');
    const activeLayer = document.querySelector<HTMLElement>('.honeycomb-active-layer');
    const steps = gsap.utils.toArray<HTMLElement>('.tier-step');
    const railLinks = gsap.utils.toArray<HTMLElement>('[data-tier-link]');
    const microLinks = gsap.utils.toArray<HTMLElement>('[data-micro-link]');
    const title = document.querySelector<HTMLElement>('#active-tier-title');
    const count = document.querySelector<HTMLElement>('#active-tier-count');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = window.matchMedia('(max-width: 1023px), (pointer: coarse)').matches;

    document.querySelectorAll<HTMLImageElement>('.fallback-logo-grid img').forEach((image) => {
      image.addEventListener('error', () => {
        image.classList.add('hidden');
        image.parentElement?.querySelector<HTMLElement>('.logo-fallback')?.classList.remove('hidden');
      }, { once: true });
    });

    const focusHashTier = () => {
      if (!location.hash.startsWith('#tier-')) return;
      const target = document.querySelector<HTMLElement>(location.hash);
      if (!target?.classList.contains('fallback-tier')) return;
      requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
    };

    window.addEventListener('hashchange', focusHashTier);
    focusHashTier();

    if (!field || !idleLayer || !activeLayer || reduceMotion || mobile || tiers.length === 0) {
      return;
    }

    const IDLE_SCALE = 0.16;
    const ACTIVE_SEED_SCALE = 0.42;
    const IDLE_OPACITY = 0.46;
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const maxSponsorCount = Math.max(...tiers.map((tier: any) => tier.sponsors.length));
    let slots: any[] = [];
    let activeSlots: any[] = [];
    let activePool: any[] = [];
    let activeTimeline: gsap.core.Timeline | null = null;
    let activeIndex = -1;
    let requestedIndex = -1;
    let activationToken = 0;
    let geometry = { w: 104, h: 90 };
    const logoCache = new Map<string, { image: HTMLImageElement; ready: Promise<void> }>();

    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

    const preloadLogo = (src: string, highPriority = false) => {
      const cached = logoCache.get(src);
      if (cached) {
        if (highPriority) cached.image.fetchPriority = 'high';
        return cached.ready;
      }

      const image = new Image();
      image.decoding = 'async';
      image.loading = 'eager';
      image.fetchPriority = highPriority ? 'high' : 'low';
      image.src = src;

      const ready = image.decode()
        .catch(() => new Promise<void>((resolve) => {
          if (image.complete) {
            resolve();
            return;
          }
          image.addEventListener('load', () => resolve(), { once: true });
          image.addEventListener('error', () => resolve(), { once: true });
        }));

      logoCache.set(src, { image, ready });
      return ready;
    };

    tiers.forEach((tier: any, tierIndex: number) => {
      tier.sponsors.forEach((sponsor: any) => preloadLogo(sponsor.logo, tierIndex === 0));
    });

    const resetSlot = (slot: any) => {
      if (!slot?.el) return;
      slot.el.classList.remove('is-active');
      slot.el.removeAttribute('href');
      slot.el.removeAttribute('target');
      slot.el.removeAttribute('rel');
      slot.el.removeAttribute('aria-label');
      slot.el.setAttribute('aria-hidden', 'true');
      slot.img.removeAttribute('src');
      slot.img.removeAttribute('alt');
    };

    const setRail = (index: number) => {
      const tier = tiers[index];
      if (!tier) return;
      if (title) title.textContent = tier.title;
      if (count) count.textContent = tier.countLabel;
      railLinks.forEach((link, linkIndex) => {
        if(linkIndex === index) {
          link.classList.add('is-active', 'border-[var(--brand-orange)]', 'text-white', '-translate-x-[0.35rem]');
          link.classList.remove('border-white/15');
        } else {
          link.classList.remove('is-active', 'border-[var(--brand-orange)]', 'text-white', '-translate-x-[0.35rem]');
          link.classList.add('border-white/15');
        }
      });
      microLinks.forEach((link, linkIndex) => {
        if(linkIndex === index) {
          link.classList.add('is-active');
        } else {
          link.classList.remove('is-active');
        }
      });
    };

    const createActiveSlot = (parent: DocumentFragment) => {
      const el = document.createElement('a');
      el.className = 'honeycomb-slot';
      el.setAttribute('aria-hidden', 'true');
      el.innerHTML = `
        <img loading="eager" decoding="async" fetchpriority="high" />
      `;
      parent.appendChild(el);
      return { el, img: el.querySelector('img') };
    };

    const createIdleHex = (parent: DocumentFragment, slot: any, index: number) => {
      const polygon = document.createElementNS(SVG_NS, 'polygon');
      const cx = slot.x + geometry.w / 2;
      const cy = slot.y + geometry.h / 2;
      const radius = Math.min(geometry.w, geometry.h) * 0.5 * IDLE_SCALE;
      const points = Array.from({ length: 6 }, (_, i) => {
        const angle = (Math.PI / 180) * (60 * i);
        return `${(cx + Math.cos(angle) * radius).toFixed(2)},${(cy + Math.sin(angle) * radius).toFixed(2)}`;
      }).join(' ');

      polygon.setAttribute('points', points);
      polygon.setAttribute('class', 'honeycomb-idle-hex');
      polygon.setAttribute('opacity', String(IDLE_OPACITY * slot.idleTone));
      polygon.setAttribute('data-slot-index', String(index));
      parent.appendChild(polygon);
      slot.idleEl = polygon;
    };

    const buildField = () => {
      idleLayer.innerHTML = '';
      activeLayer.innerHTML = '';
      activeSlots = [];
      slots = [];
      activePool = [];

      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const w = clamp(vw / 11, 92, 128);
      const h = w * 0.8660254;
      const gap = clamp(vw / 100, 10, 16);
      const centerDistance = h + gap;
      const dx = centerDistance * 0.8660254;
      const dy = centerDistance;
      const cols = Math.ceil(vw / dx) + 4;
      const rows = Math.ceil(vh / dy) + 4;
      const startX = -w;
      const startY = -h;
      const centerX = vw / 2;
      const centerY = vh / 2;
      const idleFragment = document.createDocumentFragment();
      const activeFragment = document.createDocumentFragment();

      geometry = { w, h };
      idleLayer.setAttribute('viewBox', `0 0 ${vw} ${vh}`);
      idleLayer.setAttribute('width', String(vw));
      idleLayer.setAttribute('height', String(vh));

      for (let c = 0; c < cols; c++) {
        for (let r = 0; r < rows; r++) {
          const x = startX + c * dx;
          const y = startY + r * dy + (c % 2 === 1 ? dy / 2 : 0);
          const dist = Math.hypot(x + w / 2 - centerX, y + h / 2 - centerY);
          const idleTone = clamp(1 - dist / Math.hypot(centerX, centerY), 0.16, 0.82);
          const slot = { x, y, dist, idleTone, idleEl: null, el: null, img: null, activeScale: 1 };
          slots.push(slot);
        }
      }

      slots.sort((a, b) => a.dist - b.dist);
      // Background idle hexagons removed per user request
      // slots.forEach((slot, index) => createIdleHex(idleFragment, slot, index));

      for (let i = 0; i < maxSponsorCount; i++) {
        const active = createActiveSlot(activeFragment);
        const poolSlot = { ...active, activeScale: 1 };

        poolSlot.el.addEventListener('mouseenter', () => {
          if (!poolSlot.el.classList.contains('is-active')) return;
          // Easing is omitted to use global default
          gsap.to(poolSlot.el, { scale: (poolSlot.activeScale || 1) * 1.035, duration: 0.18, overwrite: 'auto' });
        });
        poolSlot.el.addEventListener('mouseleave', () => {
          if (!poolSlot.el.classList.contains('is-active')) return;
          // Easing is omitted to use global default
          gsap.to(poolSlot.el, { scale: poolSlot.activeScale || 1, duration: 0.18, overwrite: 'auto' });
        });

        poolSlot.el.style.width = `${w}px`;
        poolSlot.el.style.height = `${h}px`;
        gsap.set(poolSlot.el, { autoAlpha: 0, scale: IDLE_SCALE, x: -9999, y: -9999 });
        activePool.push(poolSlot);
      }

      idleLayer.appendChild(idleFragment);
      activeLayer.appendChild(activeFragment);
    };

    const getActiveScale = (selected: any[]) => {
      if (!selected.length) return 1;
      const minX = Math.min(...selected.map((slot) => slot.x));
      const maxX = Math.max(...selected.map((slot) => slot.x + geometry.w));
      const minY = Math.min(...selected.map((slot) => slot.y));
      const maxY = Math.max(...selected.map((slot) => slot.y + geometry.h));
      const clusterW = maxX - minX;
      const clusterH = maxY - minY;
      
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const boxW = vw * 0.96 - vw * 0.30;
      const boxH = vh * 0.85; // 85% of screen height
      const maxScale = selected.length <= 4 ? 1.5 : selected.length <= 12 ? 1.3 : 1.15;

      return clamp(Math.min(maxScale, boxW / clusterW, boxH / clusterH), 0.3, maxScale);
    };

    const ACADEMIA_PATTERN = [
      [0, 0],
      [-1, -0.5], [1, -0.5],
      [-1, 0.5], [1, 0.5],
      [0, -1], [0, 1],
      [-2, -1], [2, -1],
      [-2, 0], [2, 0],
    ] as const;

    const getAcademiaLayout = (count: number) => {
      if (count < 1 || count > ACADEMIA_PATTERN.length) return null;

      const pattern = ACADEMIA_PATTERN.slice(0, count);
      const columns = pattern.map(([column]) => column);
      const rows = pattern.map(([, row]) => row);
      const minColumn = Math.min(...columns);
      const maxColumn = Math.max(...columns);
      const minRow = Math.min(...rows);
      const maxRow = Math.max(...rows);
      const columnSpan = (maxColumn - minColumn) * 0.75;
      const rowSpan = maxRow - minRow;
      const gap = clamp(window.innerWidth / 180, 6, 9);
      const boxLeft = window.innerWidth * 0.30;
      const boxRight = window.innerWidth * 0.96;
      const boxWidth = boxRight - boxLeft;
      const boxHeight = window.innerHeight * 0.85;
      const widthScale = (boxWidth - columnSpan * gap) / (geometry.w * (columnSpan + 1));
      const heightScale = (boxHeight - rowSpan * gap * 0.8660254) / (geometry.h * (rowSpan + 1));
      const scale = clamp(Math.min(1.85, widthScale, heightScale), 0.3, 1.85);
      const pitchWidth = geometry.w * scale + gap;
      const pitchHeight = pitchWidth * 0.8660254;
      const targetCenterX = boxLeft + boxWidth / 2;
      const targetCenterY = window.innerHeight / 2;
      const patternCenterColumn = (minColumn + maxColumn) / 2;
      const patternCenterRow = (minRow + maxRow) / 2;

      return {
        scale,
        centers: pattern.map(([column, row]) => ({
          x: targetCenterX + (column - patternCenterColumn) * 0.75 * pitchWidth,
          y: targetCenterY + (row - patternCenterRow) * pitchHeight,
        })),
      };
    };

    const prepareSlot = (slot: any, sponsor: any) => {
      slot.activeScale = slot.activeScale || 1;
      slot.el.classList.add('is-active');
      slot.el.removeAttribute('aria-hidden');
      slot.el.setAttribute('aria-label', sponsor.website ? `Visit ${sponsor.name}` : sponsor.name);
      if (sponsor.website) {
        slot.el.href = sponsor.website;
        slot.el.target = '_blank';
        slot.el.rel = 'noopener noreferrer';
      } else {
        slot.el.removeAttribute('href');
        slot.el.removeAttribute('target');
        slot.el.removeAttribute('rel');
      }
      slot.img.src = sponsor.logo;
      slot.img.alt = sponsor.alt || sponsor.name;
    };

    const setActiveTier = async (index: number, immediate = false) => {
      const tier = tiers[index];
      if (!tier || index === activeIndex || index === requestedIndex || slots.length === 0) return;

      requestedIndex = index;
      const requestToken = ++activationToken;
      await Promise.all(tier.sponsors.map((sponsor: any) => preloadLogo(sponsor.logo, true)));

      if (requestToken !== activationToken) return;
      requestedIndex = -1;

      activeTimeline?.kill();
      activeTimeline = gsap.timeline();
      setRail(index);

      const selectedGeometry = slots.slice(0, tier.sponsors.length);
      const selected = activePool.slice(0, tier.sponsors.length);
      const academiaLayout = tier.id === 'academia' ? getAcademiaLayout(selectedGeometry.length) : null;
      const activeScale = academiaLayout?.scale ?? getActiveScale(selectedGeometry);
      const previous = [...activeSlots];

      if (previous.length) {
        activeTimeline.to(previous.map((slot) => slot.el), {
          x: (i) => previous[i].rawX,
          y: (i) => previous[i].rawY,
          scale: IDLE_SCALE,
          autoAlpha: 0,
          duration: immediate ? 0 : 0.34,
          stagger: immediate ? 0 : { each: 0.008, from: 'center' },
          onComplete: () => {
            previous.forEach((slot) => {
              resetSlot(slot);
              gsap.set(slot.el, { x: -9999, y: -9999 });
            });
          },
        });
      }

      activeTimeline.add(() => {
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        
        const boxLeft = vw * 0.30;
        const boxRight = vw * 0.96;
        const targetCx = boxLeft + (boxRight - boxLeft) / 2;
        const targetCy = vh / 2;

        const minX = Math.min(...selectedGeometry.map(s => s.x));
        const maxX = Math.max(...selectedGeometry.map(s => s.x + geometry.w));
        const minY = Math.min(...selectedGeometry.map(s => s.y));
        const maxY = Math.max(...selectedGeometry.map(s => s.y + geometry.h));
        const rawCx = (minX + maxX) / 2;
        const rawCy = (minY + maxY) / 2;

        selected.forEach((slot, slotIndex) => {
          slot.activeScale = activeScale;
          const rawX = selectedGeometry[slotIndex].x;
          const rawY = selectedGeometry[slotIndex].y;
          
          slot.rawX = rawX;
          slot.rawY = rawY;
          
          const cx = rawX + geometry.w / 2;
          const cy = rawY + geometry.h / 2;
          const customCenter = academiaLayout?.centers[slotIndex];
          const newCx = customCenter?.x ?? targetCx + (cx - rawCx) * activeScale;
          const newCy = customCenter?.y ?? targetCy + (cy - rawCy) * activeScale;
          
          slot.targetX = newCx - geometry.w / 2;
          slot.targetY = newCy - geometry.h / 2;

          prepareSlot(slot, tier.sponsors[slotIndex]);
          gsap.set(slot.el, {
            x: immediate ? slot.targetX : rawX,
            y: immediate ? slot.targetY : rawY,
            width: geometry.w,
            height: geometry.h,
            scale: immediate ? activeScale : ACTIVE_SEED_SCALE,
            autoAlpha: immediate ? 1 : 0,
          });
          gsap.set(slot.img, { opacity: 1, scale: 1 });
        });
        activeSlots = selected;
      });

      const growDuration = immediate ? 0 : 0.66;
      const waveStep = immediate ? 0 : 0.025;

      activeTimeline.addLabel('hexGrow');
      activeTimeline.to(
        selected.map((slot) => slot.el),
        {
          x: (i) => selected[i].targetX,
          y: (i) => selected[i].targetY,
          scale: activeScale,
          autoAlpha: 1,
          duration: growDuration,
          stagger: immediate ? 0 : { each: waveStep, from: 0 },
          overwrite: true,
        },
        'hexGrow'
      );
      activeIndex = index;
    };

    buildField();
    setActiveTier(0, true);

    steps.forEach((step, index) => {
      ScrollTrigger.create({
        trigger: step,
        start: 'top center',
        end: 'bottom center',
        onEnter: () => setActiveTier(index),
        onEnterBack: () => setActiveTier(index),
      });
    });

    const scrollToTier = (id: string) => {
      if (!id) return;
      let target = document.getElementById(id);
      if (!target && id.startsWith('tier-step-')) {
        const altId = id.replace('tier-step-', 'tier-');
        target = document.getElementById(altId);
      } else if (!target && id.startsWith('tier-')) {
        const altId = id.replace('tier-', 'tier-step-');
        target = document.getElementById(altId);
      }
      if (!target) return;

      const lenis = (window as any).lenis;
      if (lenis) {
        lenis.scrollTo(target, { duration: 1.2 });
      } else {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    const tierLinks = document.querySelectorAll<HTMLAnchorElement>('.micro-tier-link, .tier-rail-link, a[href^="#tier-"]');
    tierLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('#') && href.length > 1) {
          e.preventDefault();
          const id = href.slice(1);
          history.pushState(null, '', href);
          scrollToTier(id);
        }
      });
    });

    const handleSponsorHash = () => {
      if (location.hash && location.hash.length > 1) {
        const id = location.hash.slice(1);
        setTimeout(() => scrollToTier(id), 250);
      }
    };

    window.addEventListener('hashchange', handleSponsorHash);
    handleSponsorHash();

    gsap.to('.assembly-shell', {
      scrollTrigger: {
        trigger: '#sponsor-assembly',
        start: 'top top',
        end: 'bottom bottom',
        scrub: true,
      },
      '--assembly-progress': 1,
      ease: 'none',
    });

    let resizeTimer = 0;
    let cachedWidth = window.innerWidth;
    
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        const newWidth = window.innerWidth;
        if (newWidth === cachedWidth) return; // Prevent layout thrashing from mobile toolbars (height change)
        cachedWidth = newWidth;
        
        buildField();
        const indexToRestore = Math.max(activeIndex, 0);
        activeIndex = -1;
        setActiveTier(indexToRestore, true);
        ScrollTrigger.refresh();
      }, 180);
    });
  };

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', initSponsorAssembly, { once: true });
  } else {
    initSponsorAssembly();
  }
</script>
