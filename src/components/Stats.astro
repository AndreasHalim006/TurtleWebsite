---
// Stats: 4-column metrics row that separates the hero from the rest of the page.
// Ported verbatim from legacy src/index.html (lines 61-82).
const items = [
  { value: '12+ Years', label: 'Innovation' },
  { value: '8 Cars', label: 'Engineered & Built' },
  { value: '40+ Members', label: 'Active Engineers' },
  { value: 'No. 1', label: 'Driverless in Greece' },
];
---
<section class="bg-surface-container-low py-12 relative overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {items.map(({ value, label }) => (
        <div class="flex flex-col border-l border-outline-variant/20 pl-6">
          <span class="text-secondary font-headline text-[34.5px] font-bold">{value}</span>
          <span class="text-on-surface-variant font-label text-[13.8px] uppercase tracking-widest mt-2">{label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
