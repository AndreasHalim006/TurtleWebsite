---
// Rhea: current prototype spotlight. Large hero image + "Track Ready" sticker
// + 3 fact tiles (0-100 time, powertrain, torque vectoring). Inspired by the
// legacy Calypso section but slimmed down to the 3 facts Jason asked for.
import { Image } from 'astro:assets';
import rheaImage from '../assets/cars/rhea.jpg';

const facts = [
  {
    label: 'Telemetry 01',
    title: '0 - 100 KM/H',
    value: '3.2 s',
    caption: 'Launch performance delivered by a fully electric powertrain.',
  },
  {
    label: 'Telemetry 02',
    title: '4WD',
    value: 'Asymmetric Powertrain',
    caption: 'Independent front and rear torque split for optimal grip.',
  },
  {
    label: 'Telemetry 03',
    title: 'Torque Vectoring',
    value: 'First In-House',
    caption: 'Aristurtle\'s first car with active per-wheel torque control.',
  },
];
---

<section class="py-24 bg-surface-container-lowest overflow-hidden">
  <div class="max-w-7xl mx-auto px-8">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
      <div>
        <span class="text-tertiary font-label text-xs uppercase tracking-[0.2em] mb-4 block">Current Prototype</span>
        <h2 class="font-headline text-5xl md:text-7xl font-bold text-white uppercase tracking-tighter italic">RHEA</h2>
      </div>
      <div class="md:text-right">
        <p class="text-on-surface-variant text-sm max-w-xs md:ml-auto mb-4 font-body">The definitive evolution of Aristurtle racing DNA. Built for pure velocity and autonomous mastery.</p>
        <span class="text-white font-headline text-xl font-medium tracking-widest">2024 - 2025</span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 relative group overflow-hidden">
        <Image
          src={rheaImage}
          alt="Rhea — Aristurtle's current prototype"
          class="w-full h-[500px] object-cover grayscale hover:grayscale-0 transition-all duration-700"
          widths={[768, 1200, 1600]}
          sizes="(max-width: 1024px) 100vw, 66vw"
        />
        <div class="absolute top-6 left-6 bg-neutral-950/80 backdrop-blur px-4 py-2 border-l-2 border-secondary">
          <span class="text-secondary font-label text-[10px] uppercase tracking-widest font-bold">Track Ready</span>
        </div>
      </div>

      <div class="space-y-4">
        {facts.map((fact) => (
          <div class="bg-surface-container-high p-8 flex flex-col justify-between h-[156px]">
            <span class="text-tertiary font-label text-[10px] uppercase tracking-widest">{fact.label}</span>
            <div>
              <h3 class="text-white font-headline text-xl font-bold uppercase mb-1">{fact.title}</h3>
              <p class="text-secondary font-headline text-sm font-bold uppercase tracking-wider mb-2">{fact.value}</p>
              <p class="text-on-surface-variant text-xs font-body leading-relaxed">{fact.caption}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
