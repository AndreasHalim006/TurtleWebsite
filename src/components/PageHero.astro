---
// Compact page hero used by every inner page. Provides the [data-hero] sentinel
// that drives the header's large -> compact switch.
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
}
const { title, subtitle, eyebrow } = Astro.props;
---

<section data-hero class="relative flex min-h-[56svh] items-end border-b border-line bg-void pt-40 pb-14 md:pb-20">
  <div class="container-site">
    {eyebrow && <p class="eyebrow mb-5" data-reveal>{eyebrow}</p>}
    <h1 class="h-hero max-w-[18ch]" data-reveal>{title}</h1>
    {subtitle && <p class="lead mt-6" data-reveal>{subtitle}</p>}
  </div>
</section>
