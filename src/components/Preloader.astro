---
import logoSvg from '../images/Turtle_logo_svg.svg';
---

<div
  id="preloader-container"
  class="fixed inset-0 z-[2000] flex items-center justify-center overflow-hidden bg-[#0A0A0A] pointer-events-auto select-none"
  role="status"
  aria-live="polite"
  aria-label="Loading ARISTURTLE"
>
  <div id="preloader-content" class="aristurtle-loader">
    <img
      src={logoSvg.src}
      alt=""
      aria-hidden="true"
      class="aristurtle-loader__logo"
    />

    <div class="aristurtle-loader__track" aria-hidden="true">
      <div class="aristurtle-loader__runner">
        {[0, 1].map(() => (
          <svg
            class="aristurtle-loader__segment"
            viewBox="0 0 360 64"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              class="aristurtle-loader__circuit"
              d="M0 32H21L33 11H57L69 32L57 53H33L21 32H91L103 11H127L139 32L127 53H103L91 32H161L173 11H197L209 32L197 53H173L161 32H231L243 11H267L279 32L267 53H243L231 32H301L313 11H337L349 32H360"
            />
            <path
              class="aristurtle-loader__shell"
              d="M103 32L115 21L127 32L115 43L103 32ZM173 32L185 21L197 32L185 43L173 32ZM243 32L255 21L267 32L255 43L243 32Z"
            />
            <path
              class="aristurtle-loader__energy"
              d="M91 32L103 11H127L139 32L127 53H103L91 32H161"
            />
          </svg>
        ))}
      </div>
    </div>

    <div class="aristurtle-loader__status">
      <span class="aristurtle-loader__signal" aria-hidden="true"></span>
      <span>ENGINEERING IN MOTION</span>
      <span class="aristurtle-loader__location">AUTh / THESSALONIKI</span>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';
  import { CustomEase } from 'gsap/CustomEase';

  gsap.registerPlugin(CustomEase);
  CustomEase.create('preloader-luxe', '0.16, 1, 0.3, 1');

  const container = document.getElementById('preloader-container');
  const content = document.getElementById('preloader-content');

  if (container && content) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let repeat = false;
    let finished = false;

    try {
      repeat = sessionStorage.getItem('aristurtle-loader-seen') === '1';
      sessionStorage.setItem('aristurtle-loader-seen', '1');
    } catch {
      // Storage is optional; the loader still exits through its hard timeout.
    }

    const readinessTimeout = 3000;
    const maxDuration = readinessTimeout + 1400;
    const minimumDuration = repeat ? 180 : 720;
    const startedAt = performance.now();
    (window as any).lenis?.stop();

    const finish = () => {
      if (finished) return;
      finished = true;
      document.documentElement.classList.remove('preloader-active');
      container.remove();
      requestAnimationFrame(() => {
        window.dispatchEvent(new CustomEvent('preloader-complete'));
        (window as any).lenis?.start();
      });
    };

    const isVisible = (element: Element) => {
      const style = window.getComputedStyle(element);
      return style.display !== 'none' && style.visibility !== 'hidden' && element.getClientRects().length > 0;
    };

    const waitForDocument = () => {
      if (document.readyState === 'complete') return Promise.resolve();
      return new Promise<void>((resolve) => window.addEventListener('load', () => resolve(), { once: true }));
    };

    const waitForImage = (image: HTMLImageElement) => {
      if (image.complete) {
        return image.naturalWidth > 0 && typeof image.decode === 'function'
          ? image.decode().catch(() => undefined)
          : Promise.resolve();
      }

      return new Promise<void>((resolve) => {
        const settle = async () => {
          image.removeEventListener('load', settle);
          image.removeEventListener('error', settle);
          if (image.naturalWidth > 0 && typeof image.decode === 'function') {
            await image.decode().catch(() => undefined);
          }
          resolve();
        };
        image.addEventListener('load', settle, { once: true });
        image.addEventListener('error', settle, { once: true });
        if (image.complete) void settle();
      });
    };

    const waitForVideo = (video: HTMLVideoElement) => {
      if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) return Promise.resolve();
      return new Promise<void>((resolve) => {
        const settle = () => {
          video.removeEventListener('loadeddata', settle);
          video.removeEventListener('canplay', settle);
          video.removeEventListener('error', settle);
          resolve();
        };
        video.addEventListener('loadeddata', settle, { once: true });
        video.addEventListener('canplay', settle, { once: true });
        video.addEventListener('error', settle, { once: true });
        if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) settle();
      });
    };

    const waitForRender = (surface: HTMLElement) => {
      if (surface.dataset.criticalReady === 'true') return Promise.resolve();
      return new Promise<void>((resolve) => {
        const settle = () => {
          surface.removeEventListener('critical-asset-ready', settle);
          resolve();
        };
        surface.addEventListener('critical-asset-ready', settle, { once: true });
        if (surface.dataset.criticalReady === 'true') settle();
      });
    };

    const criticalReady = async () => {
      const media = Array.from(document.querySelectorAll<HTMLImageElement | HTMLVideoElement>('[data-critical-asset]'))
        .filter(isVisible);
      const renderSurfaces = Array.from(document.querySelectorAll<HTMLElement>('[data-critical-render]'))
        .filter((surface) => isVisible(surface)
          && (!surface.dataset.criticalMedia || window.matchMedia(surface.dataset.criticalMedia).matches));
      const readiness = Promise.allSettled([
        waitForDocument(),
        ...media.map((asset) => asset instanceof HTMLVideoElement ? waitForVideo(asset) : waitForImage(asset)),
        ...renderSurfaces.map(waitForRender),
      ]);

      await Promise.race([
        readiness,
        new Promise((resolve) => window.setTimeout(resolve, readinessTimeout)),
      ]);
    };

    const hardTimeout = window.setTimeout(finish, reducedMotion ? 0 : maxDuration);

    if (reducedMotion) {
      finish();
    } else {
      Promise.all([
        criticalReady(),
        new Promise((resolve) => window.setTimeout(resolve, Math.max(0, minimumDuration - (performance.now() - startedAt)))),
      ]).then(() => {
        if (finished) return;

        gsap.timeline({
          onComplete: () => {
            window.clearTimeout(hardTimeout);
            finish();
          },
        })
          .to(content, {
            autoAlpha: 0,
            y: -12,
            duration: repeat ? 0.1 : 0.18,
            ease: 'power2.out',
          })
          .to(container, {
            yPercent: -100,
            duration: repeat ? 0.25 : 0.68,
            ease: 'preloader-luxe',
          }, repeat ? '<' : '-=0.02');
      });
    }
  }
</script>

<style>
  .aristurtle-loader {
    display: flex;
    width: min(82vw, 480px);
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  .aristurtle-loader__logo {
    width: min(72vw, 340px);
    height: auto;
    filter: brightness(0) invert(1);
  }

  .aristurtle-loader__track {
    width: 100%;
    overflow: hidden;
  }

  .aristurtle-loader__runner {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: aristurtle-loader-loop 2.4s linear infinite;
  }

  .aristurtle-loader__segment {
    display: block;
    width: 360px;
    height: 64px;
    flex: none;
  }

  .aristurtle-loader__circuit {
    stroke: rgba(255, 255, 255, 0.2);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .aristurtle-loader__shell {
    stroke: rgba(255, 255, 255, 0.42);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .aristurtle-loader__energy {
    stroke: #9FFF10;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .aristurtle-loader__status {
    display: grid;
    width: 100%;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.52);
    font-family: 'Jura', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
  }

  .aristurtle-loader__signal {
    width: 5px;
    height: 5px;
    background: #9FFF10;
    box-shadow: 0 0 12px rgba(159, 255, 16, 0.65);
  }

  .aristurtle-loader__location {
    color: rgba(255, 255, 255, 0.22);
    text-align: right;
  }

  @keyframes aristurtle-loader-loop {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (max-width: 420px) {
    .aristurtle-loader {
      width: min(86vw, 360px);
      gap: 22px;
    }

    .aristurtle-loader__segment {
      width: 300px;
      height: auto;
    }

    .aristurtle-loader__status {
      grid-template-columns: auto 1fr;
      font-size: 9px;
    }

    .aristurtle-loader__location {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #preloader-container {
      opacity: 0;
    }

    .aristurtle-loader__runner {
      animation: none;
    }
  }
</style>
