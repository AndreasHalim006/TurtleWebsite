---
// JoinTheTeam: split CTA — Join Team / Become a Partner.
// Ported verbatim from legacy src/index.html:359-385.
---
<section class="py-24 bg-surface">
  <div class="max-w-7xl mx-auto px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-0 border border-outline-variant/20">
      <!-- Join the Team -->
      <div class="p-12 md:p-16 border-b md:border-b-0 md:border-r border-outline-variant/20 hover:bg-surface-container-low transition-colors group">
        <span class="material-symbols-outlined text-secondary text-4xl mb-6 block">groups</span>
        <h3 class="font-headline text-3xl font-bold text-white mb-4 uppercase">Join the Team</h3>
        <p class="text-on-surface-variant text-sm mb-8 leading-relaxed max-w-md">
          Build the future of electric and autonomous racing. We're looking for passionate engineers, designers, and operators ready to push limits.
        </p>
        <a class="inline-flex items-center gap-2 text-secondary font-label font-bold uppercase tracking-wider text-sm group-hover:gap-4 transition-all" href="#">
          Apply Now
          <span class="material-symbols-outlined text-lg">arrow_forward</span>
        </a>
      </div>

      <!-- Become a Partner -->
      <div class="p-12 md:p-16 hover:bg-surface-container-low transition-colors group">
        <span class="material-symbols-outlined text-secondary text-4xl mb-6 block">handshake</span>
        <h3 class="font-headline text-3xl font-bold text-white mb-4 uppercase">Become a Partner</h3>
        <p class="text-on-surface-variant text-sm mb-8 leading-relaxed max-w-md">
          Power innovation and gain visibility among the next generation of engineers. Partner with us to drive the future of mobility.
        </p>
        <a class="inline-flex items-center gap-2 text-secondary font-label font-bold uppercase tracking-wider text-sm group-hover:gap-4 transition-all" href="#">
          Partner With Us
          <span class="material-symbols-outlined text-lg">arrow_forward</span>
        </a>
      </div>
    </div>
  </div>
</section>
