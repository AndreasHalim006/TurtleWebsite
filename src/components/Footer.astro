---
import { contact, socials, footerColumns } from '../data/site';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => (path === '/' ? baseUrl : `${baseUrl}${path.replace(/^\//, '')}`);
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-panel">
  <div class="container-site py-16 md:py-24">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-5">
      <div class="flex flex-col gap-3">
        <h3 class="eyebrow">Contact</h3>
        <a href={`mailto:${contact.email}`} class="link-inline self-start">{contact.email}</a>
        <p class="mt-3 text-sm text-muted">{contact.leaderRole}</p>
        <p class="font-bold">{contact.leaderName}</p>
        <a href={contact.phoneHref} class="text-sm text-muted hover:text-brand-orange transition-colors">{contact.phone}</a>
      </div>

      <div class="flex flex-col gap-1 text-sm text-muted">
        <h3 class="eyebrow mb-2">Address</h3>
        {contact.address.map((line) => <p>{line}</p>)}
        <p class="mt-3">{contact.legal}</p>
      </div>

      <div class="flex flex-col gap-2">
        <h3 class="eyebrow mb-1">General</h3>
        {footerColumns.general.map((l) => <a href={href(l.href)} class="text-muted hover:text-white transition-colors">{l.label}</a>)}
      </div>

      <div class="flex flex-col gap-2">
        <h3 class="eyebrow mb-1">Events</h3>
        {footerColumns.events.map((l) => <a href={href(l.href)} class="text-muted hover:text-white transition-colors">{l.label}</a>)}
      </div>

      <div class="flex flex-col gap-2">
        <h3 class="eyebrow mb-1">Media</h3>
        {footerColumns.media.map((l) => <a href={href(l.href)} class="text-muted hover:text-white transition-colors">{l.label}</a>)}
        <h3 class="eyebrow mb-1 mt-6">Follow</h3>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-brand-orange transition-colors">{s.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-3 border-t border-line pt-8 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} ARISTURTLE. All rights reserved.</p>
      <a href={href('/analytics-privacy')} class="hover:text-white transition-colors">Analytics privacy</a>
    </div>
  </div>
</footer>
