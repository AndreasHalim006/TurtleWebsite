---
// src/components/Footer.astro
import { Image } from 'astro:assets';

// Use placeholders for now as per user request
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-brand-midnight text-white py-16 px-[5vw] border-t border-[#1a1a1a]">
    <div class="max-w-[1800px] mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
            
            {/* Column 1: Brand & Mission */}
            <div class="flex flex-col gap-6 md:col-span-1">
                <h2 class="font-sans text-[min(6cqw,3cqh)] font-black uppercase tracking-widest text-white">ARIS<span class="text-brand-orange">TURTLE</span></h2>
                <p class="font-sans text-sm md:text-base text-gray-400 leading-relaxed font-bold tracking-tight" style="text-wrap: balance;">
                    Pushing the boundaries of electric and autonomous mobility through rigorous engineering and innovation.
                </p>
                <div class="flex gap-4 mt-2">
                    <a href="#" class="w-10 h-10 rounded-full border border-[#333] flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
                        <span class="sr-only">Instagram</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                    </a>
                    <a href="#" class="w-10 h-10 rounded-full border border-[#333] flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
                        <span class="sr-only">LinkedIn</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                    </a>
                    <a href="#" class="w-10 h-10 rounded-full border border-[#333] flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
                        <span class="sr-only">Facebook</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                    </a>
                </div>
            </div>

            {/* Column 2: Navigation */}
            <div class="flex flex-col gap-4">
                <h3 class="font-sans text-sm font-bold uppercase tracking-widest text-brand-orange mb-2">Explore</h3>
                <nav class="flex flex-col gap-3">
                    <a href="#" class="font-sans text-gray-400 hover:text-white uppercase font-bold tracking-wider text-sm transition-colors">Home</a>
                    <a href="#" class="font-sans text-gray-400 hover:text-white uppercase font-bold tracking-wider text-sm transition-colors">The Team</a>
                    <a href="#" class="font-sans text-gray-400 hover:text-white uppercase font-bold tracking-wider text-sm transition-colors">The Cars</a>
                    <a href="/sponsors" class="font-sans text-gray-400 hover:text-white uppercase font-bold tracking-wider text-sm transition-colors">Sponsors</a>
                    <a href="/contact" class="font-sans text-gray-400 hover:text-white uppercase font-bold tracking-wider text-sm transition-colors">Contact</a>
                </nav>
            </div>

            {/* Column 3: Contact */}
            <div class="flex flex-col gap-4">
                <h3 class="font-sans text-sm font-bold uppercase tracking-widest text-brand-orange mb-2">Contact Us</h3>
                <div class="flex flex-col gap-3 font-sans text-sm font-bold tracking-wider text-gray-400">
                    <p class="uppercase">Aristotle University of Thessaloniki</p>
                    <p class="uppercase">Faculty of Engineering</p>
                    <p class="uppercase">Thessaloniki 541 24, Greece</p>
                    <a href="mailto:info@aristurtle.gr" class="text-white hover:text-brand-orange transition-colors mt-2 uppercase">info@aristurtle.gr</a>
                </div>
            </div>

            {/* Column 4: Newsletter */}
            <div class="flex flex-col gap-4">
                <h3 class="font-sans text-sm font-bold uppercase tracking-widest text-brand-orange mb-2">Stay Updated</h3>
                <p class="font-sans text-sm text-gray-400 font-bold tracking-tight mb-2">Subscribe to our newsletter for the latest team updates and race results.</p>
                <form class="flex w-full" onsubmit="event.preventDefault();">
                    <input type="email" placeholder="YOUR EMAIL" class="w-full bg-[#111] border border-[#333] border-r-0 px-4 py-3 font-sans text-sm text-white placeholder-gray-600 focus:outline-none focus:border-brand-orange" required />
                    <button type="submit" class="bg-brand-orange text-black px-6 font-sans font-black uppercase text-sm hover:bg-white transition-colors">
                        Join
                    </button>
                </form>
            </div>

        </div>

        {/* Bottom Strip */}
        <div class="pt-8 border-t border-[#1a1a1a] flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="font-sans text-xs font-bold text-gray-600 uppercase tracking-widest">
                &copy; {currentYear} ARISTURTLE. All rights reserved.
            </p>
            <div class="flex gap-6">
                <a href="#" class="font-sans text-xs font-bold text-gray-600 hover:text-white uppercase tracking-widest transition-colors">Privacy Policy</a>
                <a href="#" class="font-sans text-xs font-bold text-gray-600 hover:text-white uppercase tracking-widest transition-colors">Terms of Service</a>
            </div>
        </div>
    </div>
</footer>
