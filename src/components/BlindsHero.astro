---
// src/components/BlindsHero.astro
import GradientBlinds from './reactbits/GradientBlinds.jsx';

export interface Props {
    title: string;
    description?: string;
    bgClass?: string;
    heightClass?: string;
    gradientColors?: string[];
}

const { 
    title, 
    description = "Engineering precision meets human connection.", 
    bgClass = "bg-brand-midnight", 
    heightClass = "min-h-[100svh]",
    gradientColors = ['#FF8900', '#FF5500'] 
} = Astro.props;
---

<div id="hero" class={`blinds-hero-container relative w-full ${heightClass} flex flex-col items-center justify-center border-b border-white/10 overflow-hidden ${bgClass}`}>
    
    <!-- React Bits Gradient Blinds Background -->
    <div class="absolute inset-0 z-0">
        <GradientBlinds 
            client:visible 
            gradientColors={gradientColors}
            angle={20}
            noise={0.5}
            blindCount={16}
            blindMinWidth={60}
            spotlightRadius={0.5}
            spotlightSoftness={1}
            spotlightOpacity={1}
            mouseDampening={0.15}
            distortAmount={0}
            shineDirection="left"
            mixBlendMode="lighten"
        />
    </div>

    <!-- Vignette legibility overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A]/90 via-[#0A0A0A]/20 to-transparent z-10 pointer-events-none"></div>

    <!-- Page Title & Small Description -->
    <div class="absolute bottom-12 left-[6vw] right-[6vw] md:left-auto md:right-12 md:bottom-12 z-20 text-left items-start md:text-right md:items-end flex flex-col pointer-events-none">
        <h1 class="font-black uppercase tracking-tight text-white text-4xl sm:text-5xl md:text-6xl lg:text-[5rem] leading-none mb-2 drop-shadow-lg font-jura">
            {title}
        </h1>
        {description && (
            <p class="font-jura text-sm md:text-base text-gray-300 max-w-lg md:max-w-[400px] leading-relaxed drop-shadow-md">
                {description}
            </p>
        )}
    </div>
    
</div>


