---
// src/components/BlindsHero.astro
import GradientBlinds from './reactbits/GradientBlinds.jsx';
import type { ImageMetadata } from 'astro';

export interface Props {
    title: string;
    description?: string;
    bgClass?: string;
    heightClass?: string;
    mobileHeightClass?: string;
    mobileFallbackImage?: ImageMetadata | string;
    gradientColors?: string[];
}

const { 
    title, 
    description = "Engineering precision meets human connection.", 
    bgClass = "bg-brand-midnight", 
    heightClass = "min-h-[100svh]",
    mobileHeightClass = "h-[100svh] min-h-[100svh]",
    mobileFallbackImage,
    gradientColors = ['#9FFF10', '#00F3CB'] 
} = Astro.props;
---

<div id="hero" class={`blinds-hero-container relative w-full ${mobileHeightClass} ${heightClass} flex flex-col items-center justify-center border-b border-white/10 overflow-hidden ${bgClass}`}>
    
    <!-- React Bits Gradient Blinds Background -->
    <div class="mobile-hero-field absolute inset-0 z-0 lg:hidden" data-mobile-static>
        {mobileFallbackImage && (
            <img
                src={typeof mobileFallbackImage === 'string' ? mobileFallbackImage : mobileFallbackImage.src}
                width={typeof mobileFallbackImage === 'string' ? 1200 : mobileFallbackImage.width}
                height={typeof mobileFallbackImage === 'string' ? 800 : mobileFallbackImage.height}
                alt=""
                aria-hidden="true"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                data-critical-asset
                class="absolute inset-0 h-full w-full object-cover opacity-55"
            />
        )}
    </div>
    <div
        class="absolute inset-0 z-0 hidden lg:block"
        data-critical-render
        data-critical-media="(min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference)"
    >
        <GradientBlinds 
            client:media="(min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference)"
            gradientColors={gradientColors}
            angle={20}
            noise={0.5}
            blindCount={16}
            blindMinWidth={60}
            spotlightRadius={0.5}
            spotlightSoftness={1}
            spotlightOpacity={1}
            mouseDampening={0.15}
            distortAmount={0}
            shineDirection="left"
            mixBlendMode="lighten"
        />
    </div>


    <!-- Page Title & Small Description -->
    <div class="absolute bottom-12 left-[6vw] right-[6vw] md:left-auto md:right-12 md:bottom-12 z-20 text-left items-start md:text-right md:items-end flex flex-col pointer-events-none">
        <h1 class="font-black uppercase tracking-tight text-white text-4xl sm:text-5xl md:text-6xl lg:text-[5rem] leading-none mb-2 drop-shadow-lg font-jura">
            {title}
        </h1>
        {description && (
            <p class="font-jura text-sm md:text-base text-gray-300 max-w-lg md:max-w-[400px] leading-relaxed drop-shadow-md">
                {description}
            </p>
        )}
    </div>
    
</div>

<style>
    .mobile-hero-field {
        background:
            linear-gradient(180deg, rgba(10, 10, 10, .08), rgba(10, 10, 10, .82)),
            repeating-linear-gradient(110deg, transparent 0 34px, rgba(159, 255, 16, .08) 35px 36px),
            #141414;
    }
</style>


