---
import { achievements, achievementsSource } from '../data/site';

const month = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<div class="podiums mt-14">
  <h3 class="eyebrow mb-5">Podium finishes</h3>
  <ol class="podiums__grid" aria-label="Achievements, newest first">
    {achievements.map((a) => {
      const rank = Number.parseInt(a.place, 10);
      return (
        <li class={`podiums__tile podiums__tile--${rank}`} data-reveal>
          <div class="podiums__result">
            <p class="podiums__place">{a.place}</p>
            <p class="eyebrow !text-white/75"><time datetime={a.date}>{month.format(new Date(`${a.date}-01T00:00:00Z`))}</time></p>
            <p class="h-card">{a.discipline}</p>
            <p class="text-sm text-white/80">{a.competition}</p>
          </div>
        </li>
      );
    })}
  </ol>
  <p class="mt-6 text-sm text-muted">
    <a href={achievementsSource} class="link-inline" target="_blank" rel="noopener noreferrer">View results on Formula Student Germany &nearr;</a>
  </p>
</div>

<style>
  /* Justified rows fill the available width without reordering results or leaving grid holes. */
  .podiums__grid { display: flex; flex-wrap: wrap; gap: 0.75rem; list-style: none; padding: 0; margin: 0; }
  .podiums__tile { flex: 1 1 16rem; min-width: 0; display: flex; align-items: end; min-height: 17rem; border: 1px solid var(--color-line); background: rgb(10 10 10 / 0.72); }
  .podiums__result { display: grid; gap: 0.75rem; padding: clamp(1.25rem, 2.5vw, 2rem); overflow-wrap: anywhere; }
  .podiums__place { color: var(--color-brand-orange); font-family: var(--font-display); font-size: 2.5rem; line-height: 1; font-weight: 700; }
  .podiums__tile--1 { flex-grow: 2; flex-basis: 26rem; min-height: 22rem; }
  .podiums__tile--2 { flex-grow: 1.5; flex-basis: 20rem; min-height: 19rem; }
  .podiums__tile--1 .podiums__place { font-size: clamp(3rem, 6vw, 5.5rem); }
  .podiums__tile--2 .podiums__place { font-size: clamp(2.5rem, 4vw, 3.75rem); }
  @media (max-width: 639px) {
    .podiums__tile { flex-basis: 100%; }
  }
</style>
