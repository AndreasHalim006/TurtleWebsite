---
// Achievements Pit Lane: horizontal scroll-snap strip of engineering
// milestones. User-controlled (drag, wheel, arrow buttons, keyboard), no
// scroll hijack. Active card is the one nearest the strip's horizontal
// centre; drives the SECTOR readout and the segmented progress bar.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const cards = (await getCollection('showcase')).sort(
  (a, b) => a.data.order - b.data.order
);
const total = cards.length;
---

<section id="showcase" class="showcase py-24 bg-neutral-950 relative overflow-hidden">
  <!-- Header: title + sector readout + segmented bar -->
  <div class="max-w-[1440px] mx-auto px-8 mb-10">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div>
        <span class="text-secondary font-label text-xs uppercase tracking-[0.2em] mb-2 block">Engineering Milestones</span>
        <h2 class="font-headline text-3xl md:text-5xl font-bold text-white uppercase tracking-tighter leading-[0.9]">
          Our proud <span class="text-secondary">Achievements.</span>
        </h2>
      </div>
      <div class="w-full md:w-[420px] md:max-w-[40vw]">
        <div class="flex items-center justify-between mb-3">
          <span class="font-mono text-[11px] uppercase tracking-[0.25em] text-on-surface-variant">Sector</span>
          <span class="font-mono text-[11px] uppercase tracking-[0.25em] text-white">
            <span data-sector-current>01</span>
            <span class="text-neutral-600"> / {String(total).padStart(2, '0')}</span>
          </span>
        </div>
        <div class="showcase__segments flex items-center gap-2">
          {Array.from({ length: total }).map((_, i) => (
            <div class="showcase__segment flex-1 h-[3px] bg-neutral-800 rounded-full overflow-hidden" data-seg={i}>
              <div class="h-full bg-secondary transition-all duration-300 ease-out" style={i === 0 ? 'width: 100%' : 'width: 0%'}></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Pit-lane strip -->
  <div class="relative">
    <!-- Arrow buttons: hidden on mobile, shown ≥ md -->
    <button
      type="button"
      class="pitlane-btn pitlane-btn--prev"
      aria-label="Previous milestone"
      data-pitlane-prev
    >
      <span class="material-symbols-outlined">chevron_left</span>
    </button>
    <button
      type="button"
      class="pitlane-btn pitlane-btn--next"
      aria-label="Next milestone"
      data-pitlane-next
    >
      <span class="material-symbols-outlined">chevron_right</span>
    </button>

    <div class="pitlane-strip" data-pitlane-strip tabindex="0" aria-label="Engineering milestones">
      {cards.map((card, i) => (
        <article class="pitlane-card" data-index={i}>
          <div class="pitlane-card__media">
            <Image
              src={card.data.image}
              alt={card.data.alt}
              widths={[480, 720, 960]}
              sizes="(max-width: 767px) 88vw, 520px"
            />
          </div>
          <div class="pitlane-card__body">
            <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-tertiary">
              S{String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-headline text-xl font-bold text-white mt-1 mb-2 uppercase">{card.data.title}</h3>
            <p class="text-on-surface-variant text-sm leading-relaxed">{card.data.caption}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pitlane-strip {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-block: 1rem 1.5rem;
    /* padding-inline is set by JS so first/last cards can centre-snap. */
  }
  .pitlane-strip::-webkit-scrollbar { display: none; }
  .pitlane-strip:focus-visible { outline: none; }

  .pitlane-card {
    flex: 0 0 clamp(340px, 42vw, 640px);
    scroll-snap-align: center;
    scroll-snap-stop: always;
    background-color: #1b1c1c;
    border: 1px solid rgba(68, 71, 72, 0.3);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 250ms ease, transform 250ms ease;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
  }

  .pitlane-card.is-active {
    border-color: var(--color-secondary, #ff6b35);
    transform: translateY(-4px);
  }

  .pitlane-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background-color: #0f1010;
    overflow: hidden;
  }

  .pitlane-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .pitlane-card__body {
    padding: 1rem 1.25rem 1.25rem;
  }

  .pitlane-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 10, 10, 0.85);
    border: 1px solid rgba(255, 107, 53, 0.35);
    color: white;
    z-index: 10;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: background-color 180ms ease, border-color 180ms ease, opacity 180ms ease;
  }
  .pitlane-btn:hover {
    background-color: rgba(255, 107, 53, 0.2);
    border-color: var(--color-secondary, #ff6b35);
  }
  .pitlane-btn:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }
  .pitlane-btn--prev { left: 1rem; }
  .pitlane-btn--next { right: 1rem; }

  @media (min-width: 768px) {
    .pitlane-btn { display: flex; }
  }

  .pitlane-btn .material-symbols-outlined {
    font-size: 28px;
  }
</style>

<script>
  // Pit-lane controller: tracks active card (nearest centre), updates
  // sector readout + segmented bar, wires arrow buttons and keyboard.
  // No scroll hijack — purely reactive to user scroll/drag/wheel/key.
  function initPitLane() {
    const section = document.getElementById('showcase');
    if (!section) return;
    const strip = section.querySelector<HTMLElement>('[data-pitlane-strip]');
    if (!strip) return;
    const cards = Array.from(
      strip.querySelectorAll<HTMLElement>('.pitlane-card')
    );
    if (!cards.length) return;
    const prevBtn = section.querySelector<HTMLButtonElement>('[data-pitlane-prev]');
    const nextBtn = section.querySelector<HTMLButtonElement>('[data-pitlane-next]');
    const sectorEl = section.querySelector<HTMLElement>('[data-sector-current]');
    const segFills = Array.from(
      section.querySelectorAll<HTMLElement>('.showcase__segment > div')
    );

    const N = cards.length;
    let activeIndex = 0;
    let isVisible = false;
    let ticking = false;

    function padStripInline() {
      // Equal inline padding so first and last cards can reach the centre.
      const stripWidth = strip.clientWidth;
      const firstCard = cards[0];
      if (!firstCard) return;
      const cardWidth = firstCard.getBoundingClientRect().width;
      const pad = Math.max(0, (stripWidth - cardWidth) / 2);
      strip.style.paddingLeft = `${pad}px`;
      strip.style.paddingRight = `${pad}px`;
    }

    function findNearestIndex(): number {
      const rect = strip.getBoundingClientRect();
      const centre = rect.left + rect.width / 2;
      let best = 0;
      let bestDist = Infinity;
      for (let i = 0; i < N; i++) {
        const cardRect = cards[i].getBoundingClientRect();
        const cardCentre = cardRect.left + cardRect.width / 2;
        const dist = Math.abs(cardCentre - centre);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      }
      return best;
    }

    function render() {
      for (let i = 0; i < N; i++) {
        cards[i].classList.toggle('is-active', i === activeIndex);
      }
      if (sectorEl) {
        sectorEl.textContent = String(activeIndex + 1).padStart(2, '0');
      }
      for (let i = 0; i < segFills.length; i++) {
        segFills[i].style.width = i <= activeIndex ? '100%' : '0%';
      }
      if (prevBtn) prevBtn.disabled = activeIndex === 0;
      if (nextBtn) nextBtn.disabled = activeIndex === N - 1;
    }

    function updateActive() {
      const next = findNearestIndex();
      if (next !== activeIndex) {
        activeIndex = next;
        render();
      }
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateActive();
        ticking = false;
      });
    }

    function scrollToIndex(index: number) {
      const clamped = Math.max(0, Math.min(N - 1, index));
      const target = cards[clamped];
      if (!target) return;
      const stripRect = strip.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();
      const offset =
        targetRect.left - stripRect.left + strip.scrollLeft
        - (stripRect.width - targetRect.width) / 2;
      strip.scrollTo({ left: offset, behavior: 'smooth' });
    }

    prevBtn?.addEventListener('click', () => scrollToIndex(activeIndex - 1));
    nextBtn?.addEventListener('click', () => scrollToIndex(activeIndex + 1));

    strip.addEventListener('scroll', onScroll, { passive: true });

    // Keyboard: arrows advance ONLY when section is in viewport.
    window.addEventListener('keydown', (e) => {
      if (!isVisible) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        scrollToIndex(activeIndex - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        scrollToIndex(activeIndex + 1);
      }
    });

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          isVisible = entry.isIntersecting;
        }
      },
      { rootMargin: '0px', threshold: 0.2 }
    );
    io.observe(section);

    // Initial padding + state, plus recompute on resize.
    padStripInline();
    render();
    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      if (resizeTimer) window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        padStripInline();
        updateActive();
      }, 120);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPitLane);
  } else {
    initPitLane();
  }
</script>
