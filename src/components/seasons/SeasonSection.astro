---
// src/components/seasons/SeasonSection.astro
interface Props {
  season: any;
  isInitial?: boolean;
}

const { season, isInitial = false } = Astro.props;
const { title, year, heroImage, departments } = season.data;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const resolveAssetUrl = (url?: string) => {
  if (!url) return '';
  if (url.startsWith('http://') || url.startsWith('https://')) return url;
  const cleanPath = url.startsWith('/') ? url.slice(1) : url;
  return `${baseUrl}${cleanPath}`;
};

const resolvedHeroImage = resolveAssetUrl(heroImage);
---

<section class="season-content w-full flex flex-col relative lg:pt-0">
  
  {/* Hero Image & Name */}
  <div class="relative w-full h-[50vh] lg:h-[80vh] flex items-center justify-center overflow-hidden">
    {resolvedHeroImage ? (
      <img 
        src={resolvedHeroImage} 
        alt={`${year} Team`} 
        width="1600"
        height="1000"
        class="absolute inset-0 w-full h-full object-cover opacity-50" 
        loading={isInitial ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={isInitial ? 'high' : 'low'}
        data-critical-asset={isInitial ? '' : undefined}
      />
    ) : (
      <div class="absolute inset-0 w-full h-full bg-[#111] opacity-50"></div>
    )}
    
    {/* Gradient Overlay for blending */}
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-[#0A0A0A]/40 to-transparent pointer-events-none"></div>

    {/* Text Overlay */}
    <div class="relative z-10 flex flex-col items-center justify-center text-center mt-12">
      <h2 class="font-jura text-6xl sm:text-8xl lg:text-[10vw] font-black uppercase text-white tracking-tighter leading-none drop-shadow-2xl">{year}</h2>
      {title !== year && title !== 'BOARD' && (
        <span class="font-jura text-[--brand-orange] text-base lg:text-xl font-bold tracking-[0.3em] mt-4 z-20 bg-[#0A0A0A]/60 px-4 py-1 rounded backdrop-blur-sm border border-gray-800">{title}</span>
      )}
    </div>
  </div>

  {/* Content Container */}
  <div class="w-full max-w-[1800px] mx-auto px-6 lg:px-12 xl:px-24 flex flex-col py-16 gap-16 md:gap-24">
    {departments && departments.length > 0 ? (
      departments.map((dept: any) => (
        <section class="department-block w-full border-t border-white/10 pt-2 lg:pt-12 lg:grid lg:grid-cols-3 lg:gap-[5vw]">
          <div class="lg:col-span-1 min-h-[72px] flex items-center py-3 lg:block">
            <h3 class="font-jura text-2xl lg:text-5xl font-bold tracking-tight uppercase lg:sticky lg:top-[120px] text-white">
              {dept.name}
            </h3>
          </div>
          <div class="lg:col-span-2">
            <ul class="flex flex-col w-full">
              {dept.members.map((member: any) => {
                const memberImg = resolveAssetUrl(member.image) || resolvedHeroImage || `${baseUrl}favicon.svg`;
                return (
                  <li 
                    class="member-item grid grid-cols-[6.5rem_minmax(0,1fr)] items-start gap-4 group font-jura w-full border-b border-white/5 py-4 hover:border-[--brand-orange]/30 transition-colors cursor-pointer relative lg:flex lg:flex-row lg:justify-between lg:items-end"
                    data-image={memberImg}
                    data-email={member.email}
                  >
                    <img
                      src={memberImg}
                      alt={member.image ? `${member.name} portrait` : ''}
                    width="520"
                    height="650"
                    loading="lazy"
                    decoding="async"
                    class="member-mobile-image lg:hidden block w-full aspect-[4/5] object-cover bg-[#111] border border-white/10"
                  />
                  <div class="min-w-0 flex flex-col lg:contents">
                    <div class="flex min-w-0 flex-col">
                      <span class="text-xl sm:text-2xl lg:text-3xl font-bold text-gray-300 group-hover:text-white transition-colors uppercase leading-tight">{member.name}</span>
                    </div>
                    <div class="flex min-w-0 flex-col text-left lg:text-right mt-2 lg:mt-0">
                      <span class="text-xs sm:text-sm lg:text-base font-bold tracking-[0.16em] lg:tracking-[0.2em] text-[--brand-orange] uppercase break-words">{member.role || 'Position not listed'}</span>
                      <span class="email-text text-[0.68rem] sm:text-xs tracking-[0.08em] sm:tracking-widest text-gray-500 group-hover:text-gray-300 transition-colors mt-2 lg:mt-0 break-all uppercase">{member.email || 'Email not listed'}</span>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    ) : (
      <div class="w-full text-center py-20">
        <p class="font-jura text-xl text-gray-500 uppercase tracking-widest">No team members data available for this season.</p>
      </div>
    )}
  </div>
</section>
