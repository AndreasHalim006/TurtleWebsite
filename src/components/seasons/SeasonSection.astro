---
// src/components/seasons/SeasonSection.astro
interface Props {
  season: any;
}

const { season } = Astro.props;
const { title, year, heroImage, departments } = season.data;
---

<section id={year} class="w-full flex flex-col relative pt-8 lg:pt-0">
  
  {/* Hero Image & Name */}
  <div class="relative w-full h-[50vh] lg:h-[80vh] flex items-center justify-center overflow-hidden">
    {heroImage ? (
      <img 
        src={heroImage} 
        alt={`${year} Team`} 
        class="absolute inset-0 w-full h-full object-cover opacity-50" 
        loading="lazy"
      />
    ) : (
      <div class="absolute inset-0 w-full h-full bg-[#111] opacity-50"></div>
    )}
    
    {/* Gradient Overlay for blending */}
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-[#0A0A0A]/40 to-transparent pointer-events-none"></div>

    {/* Text Overlay */}
    <div class="relative z-10 flex flex-col items-center justify-center text-center mt-12">
      <h2 class="font-jura text-6xl sm:text-8xl lg:text-[10vw] font-black uppercase text-white tracking-tighter leading-none drop-shadow-2xl">{year}</h2>
      {title !== year && title !== 'BOARD' && (
        <span class="font-jura text-[--brand-orange] text-base lg:text-xl font-bold tracking-[0.3em] mt-4 z-20 bg-[#0A0A0A]/60 px-4 py-1 rounded backdrop-blur-sm border border-gray-800">{title}</span>
      )}
    </div>
  </div>

  {/* Content Container */}
  <div class="w-full max-w-[1800px] mx-auto px-6 lg:px-12 xl:px-24 flex flex-col py-16 gap-16 md:gap-24">
    {departments && departments.length > 0 ? (
      departments.map((dept: any) => (
        <div class="department-block w-full border-t border-white/10 pt-8 md:pt-12 grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-[5vw]">
          <div class="md:col-span-1">
            <h3 class="font-jura text-3xl md:text-5xl font-bold tracking-tight uppercase sticky top-[120px] text-white">
              {dept.name}
            </h3>
          </div>
          <div class="md:col-span-2">
            <ul class="flex flex-col w-full">
              {dept.members.map((member: any) => (
                <li 
                  class="member-item flex flex-col md:flex-row justify-between md:items-end group font-jura w-full border-b border-white/5 py-3 md:py-4 hover:border-[--brand-orange]/30 transition-colors cursor-pointer relative"
                  data-image={member.image || heroImage || '/favicon.svg'}
                  data-email={member.email}
                >
                  <div class="flex flex-col">
                    <span class="text-2xl md:text-3xl font-bold text-gray-300 group-hover:text-white transition-colors uppercase">{member.name}</span>
                  </div>
                  <div class="flex flex-col text-left md:text-right mt-1 md:mt-0">
                    <span class="text-sm md:text-base font-bold tracking-[0.2em] text-[--brand-orange] uppercase">{member.role}</span>
                    {member.email && (
                      <span class="email-text text-xs tracking-widest text-gray-500 group-hover:text-gray-300 transition-colors mt-1 md:mt-0 uppercase">{member.email}</span>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))
    ) : (
      <div class="w-full text-center py-20">
        <p class="font-jura text-xl text-gray-500 uppercase tracking-widest">No team members data available for this season.</p>
      </div>
    )}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // We register inside the component but it runs for all instances
  gsap.registerPlugin(ScrollTrigger);

  // We could add simple entrance animations for department blocks here,
  // but we must be careful with multiple instances.
  const blocks = document.querySelectorAll('.department-block');
  blocks.forEach((block) => {
    gsap.from(block, {
      scrollTrigger: {
        trigger: block,
        start: 'top 85%',
      },
      y: 30,
      opacity: 0,
      duration: 0.8,
      ease: 'power3.out'
    });
  });
</script>
