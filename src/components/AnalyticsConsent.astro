---
import { analyticsMeasurementId } from "../config/analytics";
const enabled = /^G-[A-Z0-9]+$/.test(analyticsMeasurementId);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

{enabled && (
    <div
        id="analytics-consent"
        data-measurement-id={analyticsMeasurementId}
        hidden
    >
        <section
            id="analytics-banner"
            class="analytics-banner"
            aria-labelledby="analytics-heading"
            data-consent-banner
            hidden
        >
            <div class="analytics-copy">
                <h2 id="analytics-heading" tabindex="-1">
                    Website analytics
                </h2>
                <p>
                    With your permission, we use Google Analytics cookies to
                    understand visits and improve our website. You can reject
                    analytics and still use every page, or change your choice
                    later in Analytics settings.
                </p>
                <a href={`${baseUrl}/analytics-privacy/`}>
                    How we use analytics
                </a>
            </div>
            <div class="analytics-actions">
                <button type="button" data-consent-reject>
                    Reject analytics
                </button>
                <button type="button" data-consent-accept>
                    Accept analytics
                </button>
            </div>
        </section>
        <div class="analytics-settings">
            <button
                type="button"
                data-consent-settings
                aria-controls="analytics-banner"
                aria-expanded="false"
            >
                Analytics settings
            </button>
            <a href={`${baseUrl}/analytics-privacy/`}>Analytics privacy</a>
            <span data-consent-status role="status"></span>
        </div>
    </div>
)}

<script>
    import { initAnalyticsConsent } from "../scripts/analytics-consent";
    initAnalyticsConsent();
</script>

<style>
    [hidden] {
        display: none !important;
    }
    .analytics-banner {
        position: fixed;
        inset: auto 0 0;
        z-index: 1500;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        max-height: 80dvh;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 1.5rem 5vw max(1.5rem, env(safe-area-inset-bottom));
        background: #141414;
        color: #fff;
        border-top: 1px solid #666;
        font-family: var(--font-sans);
    }
    .analytics-copy {
        max-width: 58rem;
    }
    h2 {
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    p {
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 0.5rem;
    }
    a {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }
    .analytics-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        flex-shrink: 0;
    }
    .analytics-actions button {
        min-height: 44px;
        border: 1px solid #aaa;
        padding: 0.75rem 1rem;
        background: #141414;
        color: #fff;
        font: inherit;
        cursor: pointer;
    }
    button:hover {
        border-color: #fff;
    }
    button:focus-visible,
    a:focus-visible {
        outline: 2px solid var(--brand-orange);
        outline-offset: 4px;
    }
    .analytics-settings {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1.5rem;
        padding: 1rem 5vw;
        background: #0a0a0a;
        color: #ccc;
        border-top: 1px solid #333;
        font-size: 0.875rem;
    }
    .analytics-settings button {
        min-height: 44px;
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }
    @media (max-width: 1023px) {
        .analytics-banner {
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
        }
        .analytics-actions button {
            flex: 1;
        }
    }
</style>
