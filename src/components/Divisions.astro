---
// Divisions: 10 project divisions in a 2×5 grid (mechanical + electrical/ops).
// Ported verbatim from legacy src/index.html:236-297.
const divisions = [
  { icon: 'precision_manufacturing', title: 'Chassis', caption: 'Structural integrity, composite materials, and driver ergonomics.' },
  { icon: 'air', title: 'Aerodynamics', caption: 'Optimizing drag and downforce through CFD and wind tunnel validation.' },
  { icon: 'tire_repair', title: 'Suspension', caption: 'Vehicle dynamics, steering geometry, and kinematic optimization.' },
  { icon: 'settings_input_component', title: 'Drivetrain', caption: 'Motor design, powertrain integration, and torque delivery systems.' },
  { icon: 'layers', title: 'Composites', caption: 'Carbon fiber layup, material science, and lightweight manufacturing.' },
  { icon: 'battery_charging_full', title: 'Powertrain', caption: 'High-voltage systems, battery management, and motor control software.' },
  { icon: 'memory', title: 'Electronics', caption: 'Wiring harnesses, PCB design, and robust telemetry networks.' },
  { icon: 'radar', title: 'Driverless', caption: 'Perception stack with LiDAR, cameras, and AI for autonomous racing.' },
  { icon: 'campaign', title: 'Marketing', caption: 'Brand identity, sponsorship management, and media production.' },
  { icon: 'account_balance', title: 'Operations', caption: 'Project management, competition planning, and finance.' },
];
---
<section class="py-24 bg-surface">
  <div class="max-w-7xl mx-auto px-8">
    <h2 class="font-headline text-4xl font-bold text-white mb-16 uppercase text-center md:text-left">
      Project <span class="text-secondary">Divisions</span>
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {divisions.map((d) => (
        <div class="bg-surface-container-low p-8 border-b-2 border-transparent hover:border-secondary transition-all group">
          <span class="material-symbols-outlined text-secondary mb-6 text-3xl">{d.icon}</span>
          <h3 class="text-white font-headline text-xl font-bold uppercase mb-4">{d.title}</h3>
          <p class="text-on-surface-variant text-xs leading-relaxed font-body">{d.caption}</p>
        </div>
      ))}
    </div>
  </div>
</section>
