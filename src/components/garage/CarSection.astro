---
// src/components/garage/CarSection.astro
import { Image } from 'astro:assets';

interface Props {
  isInitial?: boolean;
  car: {
    id: string;
    name: string;
    years: string;
    description: string;
    image: string;
    drawingImage: string;
    specs: string[];
    sponsors?: string[];
    gallery?: string[];
    categorizedSponsors?: { category: string, images: string[] }[];
  };
}

const { car, isInitial = false } = Astro.props;

// Dynamically import all images in src/images
const images = import.meta.glob<{ default: ImageMetadata }>('/src/images/*.{jpeg,jpg,png,gif,svg}');
const imagePath = `/src/images/${car.image}`;
const drawingPath = `/src/images/${car.drawingImage}`;

// Dynamically import gallery images
const galleryImages = import.meta.glob<{ default: ImageMetadata }>('/src/images/garage/gallery/*.{jpeg,jpg,png,gif,svg,webp}', { eager: true });

---

<section id={car.id} class:list={['car-section w-full flex flex-col relative lg:pt-0 scroll-mt-32', isInitial && 'is-mobile-open']}>
  <button class="car-mobile-toggle lg:hidden min-h-[76px] w-full px-[var(--mobile-gutter)] py-4 flex items-center justify-between border-b border-white/10 text-left" type="button" aria-expanded={isInitial ? 'true' : 'false'} aria-controls={`car-panel-${car.id}`}>
    <span><strong class="block text-2xl font-black uppercase leading-none">{car.name}</strong><small class="mt-1 block text-xs font-bold uppercase tracking-[.16em] text-brand-orange">{car.years}</small></span>
    <span class="car-toggle-icon text-3xl font-light text-brand-orange" aria-hidden="true">+</span>
  </button>

  <div id={`car-panel-${car.id}`} class="car-mobile-panel">
  
  {/* Hero Image & Name */}
  <div class="relative w-full h-[50vh] lg:h-[80vh] flex items-center justify-center overflow-hidden">
    {/* Background Image */}
    {car.gallery && car.gallery.length > 0 && galleryImages[`/src/images/garage/gallery/${car.gallery[0]}`] ? (
      <Image 
        src={galleryImages[`/src/images/garage/gallery/${car.gallery[0]}`].default} 
        alt={`${car.name} Hero Image`}
        widths={[480, 768, 1200, 1800]}
        sizes="(max-width: 1023px) 100vw, 100vw"
        loading={isInitial ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={isInitial ? 'high' : 'low'}
        data-critical-asset={isInitial ? '' : undefined}
        class="absolute inset-0 w-full h-full object-cover opacity-50" 
      />
    ) : (
      images[imagePath] && (
        <Image 
          src={images[imagePath]()} 
          alt={car.name} 
          widths={[480, 768, 1200, 1800]}
          sizes="100vw"
          loading={isInitial ? 'eager' : 'lazy'}
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover opacity-50" 
        />
      )
    )}
    
    {/* Gradient Overlay for blending */}
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-transparent to-transparent pointer-events-none"></div>

    {/* Text Overlay */}
    <div class="relative z-10 flex flex-col items-center justify-center text-center mt-12">
      <h2 class="font-jura text-6xl sm:text-8xl lg:text-[10vw] font-bold uppercase text-white tracking-tighter leading-none drop-shadow-2xl">{car.name}</h2>
      <span class="font-jura text-[--brand-orange] text-base lg:text-xl font-bold tracking-[0.3em] mt-4 z-20 bg-[#0A0A0A]/60 px-4 py-1 rounded backdrop-blur-sm border border-gray-800">{car.years}</span>
    </div>
  </div>

  {/* Content Container */}
  <div class="w-full max-w-[1800px] mx-auto px-6 lg:px-12 xl:px-24 flex flex-col py-16 gap-24">

    {/* Description and Specs */}
    <div class="grid grid-cols-1 lg:grid-cols-12 items-start justify-between gap-16">
      
      {/* Description */}
      <div class="w-full lg:col-span-5 flex flex-col">
        <h3 class="font-jura text-sm lg:text-base text-[--brand-orange] uppercase tracking-[0.2em] mb-6">About the Car</h3>
        <p class="font-jura text-gray-300 text-lg lg:text-xl leading-relaxed">
          {car.description}
        </p>
      </div>

      {/* Tech Specs (Bento Grid) */}
      <div class="w-full lg:col-span-7 flex flex-col">
        <h3 class="font-jura text-sm lg:text-base text-[--brand-orange] uppercase tracking-[0.2em] mb-6">Technical Specifications</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {car.specs.map(spec => {
            // Attempt to bold numbers for emphasis
            const boldedSpec = spec.replace(/(\d+(?:\.\d+)?\s*[a-zA-Z%/"\\]*)/g, '<strong class="text-white text-lg">$1</strong>');
            return (
              <div class="border-t border-gray-700 py-4 md:p-6 flex items-start lg:items-center lg:justify-center lg:text-center hover:border-gray-500 transition-colors">
                <span class="font-jura text-gray-400 text-xs md:text-sm lg:text-base leading-snug" set:html={boldedSpec} />
              </div>
            );
          })}
        </div>
      </div>
    </div>

  {/* Gallery */}
  {car.gallery && car.gallery.length > 1 && (
    <div class="car-gallery mt-16 w-full pt-8 border-t border-gray-800">
      <h3 class="font-jura text-sm lg:text-base text-[--brand-orange] uppercase tracking-[0.2em] text-center mb-12">Gallery</h3>
      <button class="car-gallery-toggle lg:hidden mb-6 min-h-12 w-full border border-white/20 text-xs font-bold uppercase tracking-[.16em]" type="button" aria-expanded="false">View gallery</button>
      <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 w-full">
        {car.gallery.slice(1).map(imgFile => {
           const imgPath = `/src/images/garage/gallery/${imgFile}`;
           const imgAsset = galleryImages[imgPath];
           if (!imgAsset) return null;
           return (
             <div class="aspect-[4/3] w-full overflow-hidden rounded-md bg-[#111] group">
               <Image
                 src={imgAsset.default}
                 alt={`${car.name} Gallery Image`}
                 widths={[320, 640, 960]}
                 sizes="(max-width: 767px) 50vw, (max-width: 1279px) 33vw, 25vw"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] opacity-80 group-hover:opacity-100"
                 loading="lazy"
                 decoding="async"
               />
             </div>
           );
        })}
      </div>
    </div>
  )}
  </div>
  </div>
</section>

<style>
  @media (max-width: 1023px) {
    .car-mobile-panel { display: none; }
    .car-section.is-mobile-open .car-mobile-panel { display: block; }
    .car-section.is-mobile-open .car-toggle-icon { transform: rotate(45deg); }
    .car-toggle-icon { transition: transform .3s cubic-bezier(.16, 1, .3, 1); }
    .car-section .car-gallery > div { display: none; }
    .car-section .car-gallery.is-open > div { display: grid; }
    .car-section .car-gallery h3 { display: none; }
  }
</style>
