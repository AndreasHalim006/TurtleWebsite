---
// src/components/HUDWindow.astro
interface Props {
    id?: string;
    class?: string;
    noPadding?: boolean;
    noBorder?: boolean;
    noRounding?: boolean;
    style?: any;
}

const { id, class: className, noPadding = false, noBorder = false, noRounding = false, style = {} } = Astro.props;

// If the window is borderless, force the corners to be sharp.
const isRounded = !noBorder && !noRounding;
---

<div 
    id={id} 
    class:list={[
        "hud-window absolute transition-opacity duration-300 hud-window-container",
        className
    ]}
    style={{ ...style, containerType: 'size' }}
>
    <!-- Solid Black Background & Content (z-10) -->
    <div class:list={[
        "absolute inset-0 bg-transparent overflow-hidden z-10",
        isRounded && "rounded-[20px] md:rounded-[40px]",
        !noBorder && "shadow-[0_0_40px_rgba(0,0,0,0.5)]"
    ]}>
        <div class:list={[
            "relative w-full h-full flex flex-col",
            noPadding ? "p-0" : "p-4 md:p-10"
        ]}>
            <slot />
        </div>
    </div>

    <!-- The Drawn Border (z-20): Positioned to sit 'over and outside' -->
    {!noBorder && (
        <svg class="absolute inset-0 w-full h-full pointer-events-none overflow-visible z-20" preserveAspectRatio="none">
            <defs>
                <linearGradient id="hud-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="var(--brand-primary-1, #9FFF10)" />
                    <stop offset="100%" stop-color="var(--brand-primary-2, #00F3CB)" />
                </linearGradient>
            </defs>
            <rect 
                class:list={["hud-frame-path", noRounding ? "no-round" : "rounded-corners"]}
                x="0" y="0" width="100%" height="100%" 
                fill="none" 
                stroke="url(#hud-grad)" 
                stroke-width="9" 
                stroke-linecap="round"
                stroke-linejoin="round"
                vector-effect="non-scaling-stroke"
            />
        </svg>
    )}
</div>

<style is:global>
    .hud-frame-path {
        filter: drop-shadow(0 0 8px rgba(159, 255, 16, 0.3));
    }
    .rounded-corners {
        rx: 20px;
        ry: 20px;
    }
    @media (min-width: 768px) {
        .rounded-corners {
            rx: 40px;
            ry: 40px;
        }
    }
    .no-round {
        rx: 0px;
        ry: 0px;
    }
</style>
