---
// src/components/HUDWindow.astro
interface Props {
    id?: string;
    class?: string;
    noPadding?: boolean;
    noBorder?: boolean;
    style?: any;
}

const { id, class: className, noPadding = false, noBorder = false, style = {} } = Astro.props;
---

<div 
    id={id} 
    class:list={[
        "hud-window absolute transition-opacity duration-300 hud-window-container",
        className
    ]}
    style={{ ...style, containerType: 'size' }}
>
    <!-- Solid Black Background & Content (z-10) -->
    <div class:list={[
        "absolute inset-0 bg-black rounded-[30px] md:rounded-[40px] overflow-hidden z-10",
        !noBorder && "shadow-[0_0_40px_rgba(0,0,0,0.5)]"
    ]}>
        <div class:list={[
            "relative w-full h-full flex flex-col",
            noPadding ? "p-0" : "p-6 md:p-10"
        ]}>
            <slot />
        </div>
    </div>

    <!-- The Drawn Border (z-20): Positioned to sit 'over and outside' -->
    {!noBorder && (
        <svg class="absolute inset-0 w-full h-full pointer-events-none overflow-visible z-20" preserveAspectRatio="none">
            <rect 
                class="hud-frame-path"
                x="0" y="0" width="100%" height="100%" 
                fill="none" 
                stroke="#ff8900" 
                stroke-width="9" 
                rx="40" ry="40"
                stroke-linecap="round"
                stroke-linejoin="round"
                vector-effect="non-scaling-stroke"
            />
        </svg>
    )}
</div>

<style is:global>
    .hud-frame-path {
        filter: drop-shadow(0 0 8px rgba(255, 137, 0, 0.3));
    }
</style>
