---
// src/components/MicrographicHero.astro

export interface Props {
    title: string;
    sysId?: string;
    bgClass?: string;
    heightClass?: string;
}

const { title, sysId = "00.00.01", bgClass = "bg-brand-midnight", heightClass = "min-h-[100svh]" } = Astro.props;
const coords = "40.6280° N // 22.9591° E";
---

<div class={`micro-hero relative w-full ${heightClass} flex flex-col items-center justify-center border-b border-white/10 overflow-hidden pt-16 ${bgClass}`}>
    
    <!-- Background grid -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[var(--brand-orange)]/5 via-transparent to-transparent opacity-50 pointer-events-none"></div>

    <!-- Framing container -->
    <div class="relative w-[90vw] md:w-[70vw] max-w-[1200px] flex flex-col items-center justify-center py-12 md:py-24 border border-white/10 bg-void/30 backdrop-blur-sm">
        
        <!-- Corner Crosshairs -->
        <svg class="absolute -top-3 -left-3 w-6 h-6 text-brand-orange opacity-0 micro-crosshair" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M2 12h20"/></svg>
        <svg class="absolute -top-3 -right-3 w-6 h-6 text-brand-orange opacity-0 micro-crosshair" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M2 12h20"/></svg>
        <svg class="absolute -bottom-3 -left-3 w-6 h-6 text-brand-orange opacity-0 micro-crosshair" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M2 12h20"/></svg>
        <svg class="absolute -bottom-3 -right-3 w-6 h-6 text-brand-orange opacity-0 micro-crosshair" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M2 12h20"/></svg>

        <!-- Micro Data: Top Left -->
        <div class="absolute top-4 left-4 md:top-6 md:left-6 flex flex-col gap-1 micro-data opacity-0">
            <span class="font-sans text-[9px] md:text-[11px] font-bold text-white/40 tracking-[0.3em] uppercase">SYS.ID</span>
            <span class="font-sans text-[10px] md:text-xs font-medium text-brand-orange tracking-[0.2em] uppercase">{sysId}</span>
        </div>

        <!-- Micro Data: Bottom Right -->
        <div class="absolute bottom-4 right-4 md:bottom-6 md:right-6 flex flex-col gap-1 text-right micro-data opacity-0">
            <span class="font-sans text-[9px] md:text-[11px] font-bold text-white/40 tracking-[0.3em] uppercase">LOC.COORD</span>
            <span class="font-sans text-[10px] md:text-xs font-medium text-brand-orange tracking-[0.2em]">{coords}</span>
        </div>

        <!-- Main Title -->
        <div class="overflow-hidden">
            <h1 class="micro-title font-black uppercase tracking-tight text-white leading-none text-center select-none translate-y-full opacity-0" style="font-size: clamp(3rem, 10vw, 9rem);">
                {title}
            </h1>
        </div>
        
    </div>
</div>

<script>
    import { gsap } from 'gsap';

    const initMicroHero = () => {
        // Simple sharp HUD reveal
        gsap.to('.micro-title', { 
            y: '0%', 
            opacity: 1, 
            duration: 1.2, 
            ease: 'expo.out', 
            delay: 0.1 
        });
        
        // Corner flashes
        gsap.to('.micro-crosshair', {
            opacity: 0.6, 
            scale: 1, 
            duration: 0.6, 
            stagger: 0.1, 
            ease: 'back.out(2)', 
            delay: 0.3 
        });

        // Data fade
        gsap.to('.micro-data', {
            opacity: 1,
            duration: 0.8,
            ease: 'power2.out',
            delay: 0.6
        });
    };

    // Run on load
    initMicroHero();
    document.addEventListener('astro:page-load', initMicroHero);
</script>
