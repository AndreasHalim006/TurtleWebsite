    }

    h1, h2, h3, h4 { letter-spacing: -0.04em; font-weight: 300; }
	.ease-expo { transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 137, 0, 0.3); border-radius: 10px; }
    
    /* Hide scrollbars for the cinematic homepage experience */
    html, body {
        scrollbar-width: none; /* Firefox */
    }
    html::-webkit-scrollbar, body::-webkit-scrollbar {
        display: none; /* Chrome, Safari, Opera */
    }

