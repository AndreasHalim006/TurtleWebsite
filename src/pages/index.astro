---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Hyperspeed from '../components/reactbits/Hyperspeed.jsx';

// Local assets
import heroVideo from '../assets/images/We_Are_Aristurtle_Sept2025_ForzaEnding.mp4';
import photo1 from '../assets/images/Aristurtle_photo_1-1_2.jpg';
import photo2 from '../assets/images/Aristurtle_photo_2-1_2.jpg';
import photo3 from '../assets/images/Aristurtle_photo_3-1_2.jpg';
import photo4 from '../assets/images/Untitled-7 1.jpg';
import photo5 from '../assets/images/Untitled-12 3.jpg';
import photo6 from '../assets/images/team.png';
import photo7 from '../assets/images/oikiskos.png';

// Subsystem images
import aeroImg from '../assets/showcase/aero.png';
import chassisImg from '../assets/showcase/chassis.png';
import powertrainImg from '../assets/showcase/powertrain1.jpg';
import electronicsImg from '../assets/showcase/ECU.png';

// Partner images
import protergiaLogo from '../assets/images/powered_by_protergia.png';

const galleryImages = [
	{ src: photo1, alt: "Gallery Image 1" },
	{ src: photo2, alt: "Gallery Image 2" },
	{ src: photo3, alt: "Gallery Image 3" },
	{ src: photo4, alt: "Gallery Image 4" },
	{ src: photo5, alt: "Gallery Image 5" },
	{ src: photo6, alt: "Gallery Image 6" },
	{ src: photo7, alt: "Gallery Image 7" },
];

const subsystems = [
    { title: "Aerodynamics", tag: "AERO", src: aeroImg, desc: "High-downforce carbon fiber aerodynamic package optimized for tight Formula Student circuits." },
    { title: "Chassis & Suspension", tag: "CHASSIS", src: chassisImg, desc: "Bespoke steel spaceframe and carbon fiber monocoque integration with decoupled suspension geometry." },
    { title: "Powertrain", tag: "MOTOR", src: powertrainImg, desc: "Dual-motor electric drive system with high-precision torque vectoring and custom battery pack." },
    { title: "Electronics", tag: "ECU", src: electronicsImg, desc: "In-house developed ECUs, telemetry systems, and driver interfaces for real-time performance monitoring." },
];

const history = [
    { year: "2013", event: "Foundation of Aristurtle. The journey begins." },
    { year: "2015", event: "First electric car, Electra, competes in Formula Student." },
    { year: "2018", event: "Iris is born, our most reliable car to date." },
    { year: "2021", event: "The team transitions to Driverless technology." },
    { year: "2024", event: "Next-gen vehicle development for worldwide competitions." },
];

const sponsors = [
    { name: "Protergia", tier: "Gold" },
    { name: "Tesla", tier: "Silver" },
    { name: "Bosch", tier: "Silver" },
    { name: "Ansys", tier: "Software" },
    { name: "Solidworks", tier: "Software" },
];

const aboutHyperspeedOptions = {
    distortion: 'turbulentDistortion',
    length: 320,
    roadWidth: 7,
    islandWidth: 1.4,
    lanesPerRoad: 3,
    fov: 95,
    fovSpeedUp: 140,
    speedUp: 1.8,
    carLightsFade: 0.6,
    totalSideLightSticks: 14,
    lightPairsPerRoadWay: 28,
    colors: {
        roadColor: 0x000000,
        islandColor: 0x020202,
        background: 0x000000,
        shoulderLines: 0xff8900,
        brokenLines: 0xff8900,
        leftCars: [0xff8900, 0xffbd5a, 0xffffff],
        rightCars: [0xff4d00, 0xff8900, 0xfff0d0],
        sticks: 0xff8900,
    },
};
---

<BaseLayout title="ARISTURTLE | Bespoke Engineering Excellence">
	
	<div class="bg-void min-h-screen w-full relative overflow-x-clip text-foreground selection:bg-brand-orange selection:text-brand-emerald">
		
		<div class="fixed inset-0 z-0 bg-brand-emerald pointer-events-none opacity-20"></div>

		<section id="hero" class="relative h-screen w-full flex flex-col items-center justify-center z-10 overflow-hidden bg-brand-midnight m-0 p-0">
			
			<div class="absolute inset-0 z-0">
				<video 
					autoplay 
					muted 
					loop 
					playsinline 
					class="w-full h-full object-cover"
				>
					<source src={heroVideo} type="video/mp4" />
				</video>
			</div>

			<div id="hero-parallax-wrapper" class="relative w-full max-w-[1800px] mx-auto h-full flex z-10 px-[6vw] pb-[5vh] pt-[5vh]">
			</div>
		</section>

		<div class="relative w-full h-[56px] md:h-[74px] z-50">
			<div class="absolute top-0 left-0 w-full h-[4px] -translate-y-1/2 bg-brand-orange">
				<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
					<div class="w-24 h-[110.85px] md:w-32 md:h-[147.8px] bg-brand-orange flex items-center justify-center rotate-90" style="clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);">
						<div class="w-[calc(100%-8px)] h-[calc(100%-8px)] bg-void flex items-center justify-center p-6" style="clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);">
							<div class="-rotate-90 w-full flex items-center justify-center">
								<Image 
									src={protergiaLogo} 
									alt="Powered by Protergia" 
									class="w-full h-auto object-contain" 
								/>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div id="journey-container" class="relative w-full h-[1200vh]">
            <div id="journey-viewport" class="sticky top-0 left-0 w-full h-screen overflow-hidden bg-void">
                
                <div id="journey-stage" class="absolute top-0 left-0 will-change-transform origin-top-left">
                    
                    <svg id="journey-svg" viewBox="0 0 1774 887" preserveAspectRatio="none" class="absolute inset-0 w-full h-full pointer-events-none z-0">
                        <g transform="translate(0.000000,887.000000) scale(0.100000,-0.100000)" fill="none" stroke="#ff8900" stroke-width="15" stroke-linecap="round" stroke-linejoin="round">
