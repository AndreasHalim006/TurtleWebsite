        /* Acrostic letters should remain reasonably large */
        .acrostic-item span.acrostic-letter {
            font-size: 2.2rem !important;
        }
        .acrostic-item span:not(.acrostic-letter) {
            font-size: 1.1rem !important;
        }

        /* Sponsors CTA support button text size */
        .hud-window-container a {
            font-size: 0.9rem !important;
