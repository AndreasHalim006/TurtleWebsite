                    </svg>

                    <div id="station-about" class="absolute w-screen h-screen flex flex-col justify-center">
                        <div class="absolute inset-0 z-0 pointer-events-none">
                            <div class="about-hex-hyperspeed absolute pointer-events-auto cursor-pointer">
                                <Hyperspeed client:load effectOptions={aboutHyperspeedOptions as any} />
                            </div>
                        </div>

                        <div class="max-w-[1900px] mx-auto w-full px-[6vw] relative z-10 py-16 md:py-20 pointer-events-none">
                            <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.6fr)_minmax(20rem,0.4fr)] gap-10 lg:gap-12 items-center">
                                <div class="about-reveal about-copy-stack relative flex max-w-[64rem] flex-col justify-center gap-14 md:gap-16 lg:min-h-[56vh] lg:gap-[clamp(4rem,8vh,6rem)] lg:pr-[2vw] pointer-events-auto">
                                    <div class="journey-text w-full max-w-none font-sans text-lg md:text-2xl lg:text-[1.6rem] xl:text-[2rem] 2xl:text-[2.4rem] leading-[1.08] text-white font-light text-left lg:text-justify hyphens-auto uppercase">
                                        <span class="font-bold text-brand-orange">Aristotle University Racing Team Electric & Driverless</span>, also known as <span class="italic text-brand-orange">Aristurtle</span>, is the student research team of the Aristotle University of Thessaloniki, that designs, develops and builds electric race cars.
                                    </div>
                                    <div class="journey-text w-full max-w-none font-sans text-lg md:text-2xl lg:text-[1.6rem] xl:text-[2rem] 2xl:text-[2.4rem] leading-[1.08] text-white font-light text-left lg:text-justify hyphens-auto uppercase">
                                        Our vision is to contribute in the research around innovative technologies and to promote electric mobility in Greece and abroad, by materializing high-level pioneering products.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="station-about2" class="absolute w-screen h-screen flex flex-col justify-center">
                        <div class="max-w-[1800px] mx-auto px-[5vw]">
                            <div class="flex flex-col gap-8 max-w-3xl">
                                <span class="font-sans text-[12px] font-bold uppercase tracking-[0.8em] text-brand-orange">// THE_MISSION</span>
                                <h2 class="journey-title font-sans text-5xl md:text-7xl lg:text-8xl text-white uppercase font-light">Innovation <span class="font-bold">Driven</span></h2>
                                <p class="journey-text font-sans text-xl text-white/60 leading-relaxed font-light uppercase">
                                    We push the boundaries of electric racing through relentless optimization and data-driven engineering. Our commitment to excellence defines every curve and circuit we conquer.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div id="station-subteams" class="absolute w-screen h-screen flex flex-col justify-center">
                        <div class="max-w-[1800px] mx-auto px-[5vw]">
                            <div class="mb-16 flex flex-col gap-4">
                                <span class="font-sans text-[12px] font-bold uppercase tracking-[0.8em] text-brand-orange">// THE_SYSTEMS</span>
                                <h2 class="journey-title font-sans text-5xl md:text-7xl lg:text-8xl text-white uppercase font-light">Engineering <span class="font-bold">Subsystems</span></h2>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                                {subsystems.map((item, index) => (
                                    <div class="subsystem-card group relative flex flex-col gap-6 p-6 bg-brand-midnight/50 border border-white/5 hover:border-brand-orange/50 transition-colors duration-500 overflow-hidden">
                                        <div class="relative w-full aspect-[4/3] overflow-hidden bg-void">
                                            <Image src={item.src} alt={item.title} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000" />
                                        </div>
                                        <div class="flex flex-col gap-2">
                                            <h3 class="font-sans text-xl text-white uppercase font-bold tracking-tight">{item.title}</h3>
                                            <p class="font-sans text-xs text-white/60 leading-relaxed font-light">{item.desc}</p>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>

                    <div id="station-history" class="absolute w-screen h-screen flex flex-col justify-center">
                        <div class="max-w-[1800px] mx-auto px-[5vw]">
                            <div class="mb-16 flex flex-col gap-4">
                                <span class="font-sans text-[12px] font-bold uppercase tracking-[0.8em] text-brand-orange">// THE_JOURNEY</span>
                                <h2 class="journey-title font-sans text-5xl md:text-7xl lg:text-8xl text-white uppercase font-light">Legacy <span class="font-bold">Timeline</span></h2>
                            </div>
                            <div class="flex flex-col gap-12">
                                {history.map((item, index) => (
                                    <div class="flex items-baseline gap-8 border-l border-white/10 pl-8 relative">
                                        <div class="absolute left-[-5px] top-2 w-[10px] h-[10px] bg-brand-orange rounded-full"></div>
                                        <span class="font-sans text-4xl font-bold text-brand-orange">{item.year}</span>
                                        <p class="font-sans text-xl text-white/80 font-light uppercase">{item.event}</p>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>

                    <div id="station-sponsors" class="absolute w-screen h-screen flex flex-col justify-center">
                        <div class="max-w-[1800px] mx-auto px-[5vw]">
                            <div class="mb-16 flex flex-col gap-4">
                                <span class="font-sans text-[12px] font-bold uppercase tracking-[0.8em] text-brand-orange">// THE_PARTNERS</span>
                                <h2 class="journey-title font-sans text-5xl md:text-7xl lg:text-8xl text-white uppercase font-light">Strategic <span class="font-bold">Allies</span></h2>
                            </div>
                            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8">
                                {sponsors.map((item, index) => (
                                    <div class="flex flex-col items-center p-8 bg-brand-midnight/30 border border-white/5">
                                        <span class="font-sans text-2xl font-bold text-white mb-2">{item.name}</span>
                                        <span class="font-sans text-[10px] text-brand-orange uppercase tracking-widest">{item.tier} Partner</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
		</div>

	</div>
</BaseLayout>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
	import { SplitText } from 'gsap/SplitText';
	import { CustomEase } from 'gsap/CustomEase';

	gsap.registerPlugin(ScrollTrigger, DrawSVGPlugin, SplitText, CustomEase);

	CustomEase.create("luxe", "0.16, 1, 0.3, 1");

	window.addEventListener('DOMContentLoaded', () => {
		const mm = gsap.matchMedia();

		mm.add({
			reduceMotion: "(prefers-reduced-motion: reduce)",
			noPreference: "(prefers-reduced-motion: no-preference)"
		}, (context) => {
			const reduceMotion = (context.conditions as Record<string, boolean> | undefined)?.reduceMotion ?? false;
            
            const stage = document.querySelector('#journey-stage');
            const pathMain = document.querySelector('#journey-path-main');
            const allPaths = document.querySelectorAll('#journey-svg path');

            if (stage && pathMain) {
                // 1. Grid Definition
                const scaleFactor = 6; 
                const stageWidth = 1774 * scaleFactor;
                const stageHeight = 887 * scaleFactor;
                gsap.set(stage, { width: stageWidth, height: stageHeight });

                const journeyTimeline = gsap.timeline({
                    scrollTrigger: {
                        trigger: "#journey-container",
                        start: "top top",
                        end: "bottom bottom",
                        scrub: 1.5,
                        invalidateOnRefresh: true,
                    }
                });

                // Helper to map SVG Path coordinate to Stage Pixel
                const getTransformedPos = (progress: number) => {
                    const pathEl = pathMain as SVGPathElement;
                    // Protect against 0 length or unrendered SVG
                    const length = pathEl.getTotalLength() || 1; 
                    const pt = pathEl.getPointAtLength(progress * length);
                    return {
                        x: (pt.x * 0.1) * scaleFactor,
                        y: (887 - (pt.y * 0.1)) * scaleFactor
                    };
                };

                // Helper to center a stage coordinate in the viewport
                const getCameraPos = (px: number, py: number, currentScale = 1) => {
                    return {
                        x: -px * currentScale + window.innerWidth / 2,
                        y: -py * currentScale + window.innerHeight / 2
                    };
                };

                // 2. Waypoints Map
                const waypoints = [
                    { id: '#station-about',    p: 0.15 }, // Rear Wing
                    { id: '#station-about2',   p: 0.40 }, // Roll Hoop
                    { id: '#station-subteams', p: 0.60 }, // Cockpit
                    { id: '#station-history',  p: 0.75 }, // Front Nose
                    { id: '#station-sponsors', p: 0.90 }  // Chassis Bottom
                ];

                // Setup Initial State
                const startPos = getTransformedPos(0);
                gsap.set(stage, { x: getCameraPos(startPos.x, startPos.y).x, y: getCameraPos(startPos.x, startPos.y).y, transformOrigin: "0 0" });

                // Position Stations statically
                waypoints.forEach((wp) => {
                    const pos = getTransformedPos(wp.p);
                    const stationEl = document.querySelector(wp.id) as HTMLElement;
                    if (stationEl) {
                        gsap.set(stationEl, {
                            left: pos.x,
                            top: pos.y,
                            xPercent: -50,
                            yPercent: -50
                        });
                    }
                });

                // Set up the line drawing and continuous camera follow
                const zoomOutStart = 0.85;
                const finalScale = 0.15;
                const tracker = { progress: 0 };
                
                // Animate tracker from 0 to 1
                journeyTimeline.to(tracker, {
                    progress: 1,
                    ease: "none",
                    duration: 1,
                    onUpdate: function() {
                        const p = tracker.progress;
                        
                        // Map 0 -> zoomOutStart to 0 -> 1 for BOTH path drawing and camera tracking
                        const pathProgress = Math.min(p / zoomOutStart, 1);
                        
                        // 1. Draw paths perfectly in sync with camera progress
                        gsap.set(allPaths, { drawSVG: `${pathProgress * 100}%` });
                        
                        // 2. Camera Tracking
                        if (p <= zoomOutStart) {
                            const pos = getTransformedPos(pathProgress);
                            gsap.set(stage, {
                                scale: 1,
                                x: getCameraPos(pos.x, pos.y, 1).x,
                                y: getCameraPos(pos.x, pos.y, 1).y
                            });
                        } else {
                            // Zoom out phase
                            // pathProgress stays at 1
                            const pos = getTransformedPos(1);
                            
                            // Map zoomOutStart -> 1 to 0 -> 1 for the zoom
                            const zoomProgress = (p - zoomOutStart) / (1 - zoomOutStart);
                            // Smooth easing for zoom out
                            const easeProgress = CustomEase.get("luxe")(zoomProgress);
                            
                            const currentScale = 1 - ((1 - finalScale) * easeProgress);
                            
                            // To zoom out to the center of the entire stage
                            const stageCenterX = stageWidth / 2;
                            const stageCenterY = stageHeight / 2;
                            
                            // Interpolate between the last path point and the stage center
                            const currentTargetX = pos.x + (stageCenterX - pos.x) * easeProgress;
                            const currentTargetY = pos.y + (stageCenterY - pos.y) * easeProgress;

                            gsap.set(stage, {
                                scale: currentScale,
                                x: getCameraPos(currentTargetX, currentTargetY, currentScale).x,
                                y: getCameraPos(currentTargetX, currentTargetY, currentScale).y
                            });
                        }
                    }
                });

                // Station Reveals
                waypoints.forEach((wp) => {
                    const stationEl = document.querySelector(wp.id) as HTMLElement;
                    if (stationEl) {
                        const revealItems = stationEl.querySelectorAll('.journey-text, .journey-title, .subsystem-card, .flex.items-baseline');
                        // Trigger slightly before reaching the point
                        const timelinePosition = Math.max(0, (wp.p * zoomOutStart) - 0.05); 
                        
                        journeyTimeline.fromTo(revealItems, 
                            { opacity: 0, y: 40 },
                            { opacity: 1, y: 0, duration: 0.1, stagger: 0.02, ease: "luxe" },
                            timelinePosition
                        );
                    }
                });
            }

			return () => {
				context.revert();
			};
		});
	});
</script>

