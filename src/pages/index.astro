---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import heroPhoto from "../images/IMG_8879_1.jpeg";
import teamPhoto from "../images/Aristurtle_photo_2-1_2.jpg";
import joinPhoto from "../images/IMG_8908.jpg";
import { hero, worldClass, achievements, departments } from "../data/site";
import { carsChronological } from "../data/cars";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
---

<BaseLayout title="ARISTURTLE | Formula Student Team, Aristotle University of Thessaloniki">
    <!-- 1. HERO -->
    <section data-hero class="img-section flex min-h-[100svh] items-end">
        <Image
            src={heroPhoto}
            alt=""
            class="img-section__media"
            widths={[800, 1400, 2200]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
        />
        <div class="img-section__fade"></div>
        <div class="container-site pb-16 pt-40 md:pb-24">
            <h1 class="h-hero max-w-[16ch]" data-reveal>
                {hero.title}
            </h1>
            <p
                class="lead lead--hero mt-6 max-w-[40rem] text-white/85"
                data-reveal
            >
                {hero.subtitle}
            </p>
            <div class="mt-8 flex flex-wrap gap-3" data-reveal>
                <a href={href("/join")} class="btn btn--solid btn--lg">
                    Join the Team
                </a>
                <a href={href("/sponsors")} class="btn btn--lg">
                    Become a Partner
                </a>
            </div>
        </div>
    </section>

    <!-- 2. WORLD-CLASS TEAM -->
    <section
        class="img-section section-pad"
        aria-labelledby="world-class-title"
    >
        <Image
            src={teamPhoto}
            alt=""
            class="img-section__media"
            widths={[800, 1400, 2000]}
            sizes="100vw"
            loading="lazy"
        />
        <div class="img-section__fade"></div>
        <div class="container-site">
            <h2 id="world-class-title" class="h-section" data-reveal>
                {worldClass.title}
            </h2>
            <p class="lead mt-5 max-w-[34rem]" data-reveal>
                {worldClass.body}
            </p>
            <div class="mt-6 flex flex-wrap gap-3" data-reveal>
                <a href={href("/about")} class="btn btn--solid">
                    Explore Our Journey
                </a>
                <a href={href("/team")} class="btn">
                    Meet the Team
                </a>
            </div>
            <ul
                class="mt-14 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4"
                aria-label="Achievements"
            >
                {achievements.map((a) => (
                    <li
                        class="flex min-h-[300px] flex-col justify-end gap-2 border border-line bg-void/70 p-6 backdrop-blur-sm"
                        data-reveal
                    >
                        <p class="font-[family-name:var(--font-display)] text-3xl font-bold text-brand-orange">
                            {a.place}
                        </p>
                        <p class="eyebrow !text-muted">{a.year}</p>
                        <p class="h-card">{a.discipline}</p>
                        <p class="text-muted">{a.competition}</p>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- 3. DEPARTMENTS -->
    <section class="bg-void section-pad" aria-labelledby="departments-title">
        <div class="container-site">
            <h2
                id="departments-title"
                class="h-section max-w-[18ch]"
                data-reveal
            >
                three disciplines, one car
            </h2>
            <div class="mt-10 grid gap-3 md:grid-cols-3">
                {departments.map((d) => (
                    <article
                        class="img-section flex min-h-[400px] flex-col justify-end gap-3 overflow-hidden border border-line p-6"
                        data-reveal
                    >
                        <Image
                            src={d.image}
                            alt=""
                            class="img-section__media"
                            widths={[480, 800]}
                            sizes="(max-width: 768px) 100vw, 33vw"
                            loading="lazy"
                        />
                        <div class="img-section__fade"></div>
                        <h3 class="h-card !text-2xl">{d.name}</h3>
                        <p class="text-[#c9ccd2]">{d.blurb}</p>
                        <ul class="mt-2 flex flex-col">
                            {d.topics.map((t) => (
                                <li>
                                    <a
                                        href={href("/team")}
                                        class="flex items-center justify-between border-t border-white/20 py-2 transition-colors hover:text-brand-orange"
                                    >
                                        {t}
                                        <span aria-hidden="true">→</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </article>
                ))}
            </div>
            <div class="mt-8" data-reveal>
                <a href={href("/cars")} class="btn btn--solid">
                    Get to Know Our Cars
                </a>
            </div>
        </div>
    </section>

    <!-- 4. JOURNEY (horizontal scroll) -->
    <section
        data-journey
        class="journey border-t border-line bg-void"
        aria-labelledby="journey-title"
    >
        <div class="journey__inner">
            <div class="container-site journey__head flex flex-col md:flex-row md:items-end md:justify-between gap-6">
                <div>
                    <h2
                        id="journey-title"
                        class="h-section max-w-[16ch]"
                        data-reveal
                    >
                        one car at a time
                    </h2>
                    <p class="lead mt-4" data-reveal>
                        Every season a new car. Swipe through our journey since
                        2013.
                    </p>
                </div>
                <div class="hidden sm:flex items-center gap-3" data-reveal>
                    <button
                        type="button"
                        id="journey-prev"
                        class="btn !min-h-10 !px-4"
                        aria-label="Previous car"
                    >
                        &larr;
                    </button>
                    <button
                        type="button"
                        id="journey-next"
                        class="btn !min-h-10 !px-4"
                        aria-label="Next car"
                    >
                        &rarr;
                    </button>
                </div>
            </div>
            <div
                class="journey__viewport"
                tabindex="0"
                role="region"
                aria-label="Car timeline, scrollable"
            >
                <ol class="journey__track">
                    {carsChronological.map((c) => (
                        <li class="journey__panel">
                            <a
                                href={`${href("/cars")}#${c.id}`}
                                class="group block"
                            >
                                <div class="aspect-[4/3] overflow-hidden bg-panel-2">
                                    {c.image && (
                                        <Image
                                            src={c.image}
                                            alt={`${c.name} race car`}
                                            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                                            widths={[480, 800, 1100]}
                                            sizes="(max-width: 1024px) 80vw, 30vw"
                                            loading="lazy"
                                        />
                                    )}
                                </div>
                                <p class="eyebrow mt-4">{c.years}</p>
                                <h3 class="h-card mt-1">{c.name}</h3>
                                <p class="mt-2 line-clamp-3 text-muted">
                                    {c.description}
                                </p>
                            </a>
                        </li>
                    ))}
                    <li class="journey__panel journey__panel--end">
                        <p class="h-section">next up</p>
                        <a href={href("/cars")} class="btn mt-6 self-start">
                            Explore Our Cars
                        </a>
                    </li>
                </ol>
            </div>
        </div>
    </section>

    <!-- 5. JOIN US -->
    <section
        class="img-section section-pad flex min-h-[70svh] items-end"
        aria-labelledby="cta-title"
    >
        <Image
            src={joinPhoto}
            alt=""
            class="img-section__media"
            widths={[800, 1400, 2000]}
            sizes="100vw"
            loading="lazy"
        />
        <div class="img-section__fade"></div>
        <div class="container-site">
            <h2 id="cta-title" class="h-section" data-reveal>
                will you race with us?
            </h2>
            <div class="mt-6 flex flex-wrap gap-3" data-reveal>
                <a href={href("/join")} class="btn btn--solid btn--lg">
                    Become a Team Member
                </a>
                <a href={href("/sponsors")} class="btn btn--lg">
                    Become a Partner
                </a>
            </div>
        </div>
    </section>
</BaseLayout>

<style is:global>
    .journey__inner {
        padding-block: clamp(4rem, 8vw, 7rem);
    }
    .journey__head {
        margin-bottom: 2.5rem;
    }
    .journey__viewport {
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding-inline: var(--gutter);
        scrollbar-width: thin;
    }
    .journey__track {
        display: flex;
        gap: 1.25rem;
        list-style: none;
        padding: 0;
        margin: 0;
        width: max-content;
    }
    .journey__panel {
        flex: 0 0 min(80vw, 26rem);
        scroll-snap-align: start;
    }
    .journey__panel--end {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .journey__viewport.is-dragging {
        cursor: grabbing;
        user-select: none;
    }
    .journey__viewport:not(.is-dragging) {
        cursor: grab;
    }

    @media (min-width: 1024px) {
        .journey__panel {
            flex-basis: 28vw;
            max-width: 32rem;
        }
    }
</style>

<script>
    import "../scripts/journey";
</script>
