        /* Allow station container to stack its HUD windows vertically */
        [id^="station-"] {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 1.5rem !important;
            padding: 8vh 1.5rem 2rem 1.5rem !important; /* Spacing to prevent overlap with the header/logo */
            pointer-events: auto !important;
            overflow-y: auto !important;
        }

        /* Make HUD windows responsive block containers */
        .hud-window-container {
            position: relative !important;
