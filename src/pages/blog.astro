---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Placeholder from '../components/Placeholder.astro';

// TODO(content): replace with real posts (consider a `blog` content collection later).
const posts = [
	{ date: '20XX-XX-XX', tag: 'Season update', title: 'Placeholder blog post title', excerpt: 'Short excerpt of the post goes here. Replace with real content.' },
	{ date: '20XX-XX-XX', tag: 'Competition', title: 'Placeholder blog post title', excerpt: 'Short excerpt of the post goes here. Replace with real content.' },
	{ date: '20XX-XX-XX', tag: 'Team', title: 'Placeholder blog post title', excerpt: 'Short excerpt of the post goes here. Replace with real content.' },
];
---

<BaseLayout title="Blog | ARISTURTLE" description="News, competition reports and engineering stories from Aristurtle.">
	<PageHero
		eyebrow="Blog"
		title="stories from the paddock"
		subtitle="News, competition reports and engineering deep dives from the team."
	/>

	<section class="section-pad bg-void">
		<div class="container-site grid gap-10 md:grid-cols-2 lg:grid-cols-3">
			{posts.map((p) => (
				<article class="flex flex-col gap-5" data-reveal>
					<Placeholder label="Post cover 16:9" />
					<p class="eyebrow">{p.tag} · {p.date}</p>
					<h2 class="h-card">{p.title}</h2>
					<p class="text-muted">{p.excerpt}</p>
				</article>
			))}
		</div>
	</section>
</BaseLayout>
