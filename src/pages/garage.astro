---
// src/pages/garage.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CarSection from '../components/garage/CarSection.astro';
import garageData from '../data/garage.json';
import BlindsHero from '../components/BlindsHero.astro';

const pageGradient = ['#FF8900', '#E63900'];

const pageTitle = "Garage | ARISTURTLE";
---

<BaseLayout title={pageTitle} pageColors={pageGradient}>
  <!-- HERO SECTION -->
  <div class="sticky top-0 w-full h-[100svh] z-0">
    <BlindsHero title="GARAGE" description="The machines that drive us forward. Explore the engineering behind our fleet." gradientColors={pageGradient} />
  </div>

  <div class="bg-brand-midnight w-full min-h-screen text-white relative z-10">
    {/* Sticky Car Selector Sub-Navbar */}
    <div class="sticky top-[56px] md:top-[74px] z-40 w-full bg-brand-midnight/90 backdrop-blur-md border-b border-white/10">
      <div class="max-w-[1800px] mx-auto px-6 lg:px-12 flex items-center justify-center gap-8 md:gap-12 py-4 overflow-x-auto hide-scrollbar">
        {garageData.map((car) => (
          <a 
            href={`#${car.id}`} 
            class="gradient-underline font-jura text-sm lg:text-base font-bold uppercase text-gray-400 hover:text-[--brand-orange] transition-colors whitespace-nowrap"
          >
            {car.name}
          </a>
        ))}
      </div>
    </div>

    {/* Vertical Stack of Cars */}
    <div class="flex flex-col w-full">
      {garageData.map((car, index) => (
        <div class={`relative ${index !== 0 ? "border-t border-white/10" : "pt-8"}`}>
          <CarSection car={car} />
        </div>
      ))}
    </div>

  </div>
  </div>
</BaseLayout>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
