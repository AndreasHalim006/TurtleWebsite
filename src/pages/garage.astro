---
// src/pages/garage.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CarSection from '../components/garage/CarSection.astro';
import garageData from '../data/garage.json';
import BlindsHero from '../components/BlindsHero.astro';

const pageGradient = ['#9FFF10', '#00F3CB'];

const pageTitle = "Garage | ARISTURTLE";
---

<BaseLayout title={pageTitle} pageColors={pageGradient}>
  <!-- HERO SECTION -->
  <div class="relative lg:sticky top-0 w-full h-[100svh] z-0">
    <BlindsHero title="GARAGE" description="The machines that drive us forward. Explore the engineering behind our fleet." gradientColors={pageGradient} />
  </div>

  <div class="bg-brand-midnight w-full min-h-screen text-white relative z-10 overflow-x-clip">
    {/* Car Selector Sub-Navbar (Static) */}
    <div class="relative w-full bg-brand-midnight border-b border-white/10">
      <div class="max-w-[1800px] mx-auto px-6 lg:px-12 flex items-center justify-start md:justify-center gap-6 md:gap-12 py-4 overflow-x-auto hide-scrollbar">
        {garageData.map((car) => (
          <a 
            href={`#${car.id}`} 
            class="car-nav-link gradient-underline min-h-11 inline-flex items-center font-jura text-sm lg:text-base font-bold uppercase text-gray-400 hover:text-[--brand-orange] transition-colors whitespace-nowrap"
          >
            {car.name}
          </a>
        ))}
      </div>
    </div>

    {/* Vertical Stack of Cars */}
    <div class="flex flex-col w-full">
      {garageData.map((car, index) => (
        <div class="relative">
          {index !== 0 && (
            <div class="w-full h-[30vh] lg:h-[45vh] bg-void border-y border-white/10 relative z-20"></div>
          )}
          <CarSection car={car} isInitial={index === 0} />
        </div>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  const carSections = Array.from(document.querySelectorAll<HTMLElement>('.car-section'));
  const isMobileGarage = () => window.matchMedia('(max-width: 1023px)').matches;

  const scrollToCar = (id: string, scroll = true) => {
    if (!id) return;
    const target = document.getElementById(id);
    if (!target?.classList.contains('car-section')) return;

    if (isMobileGarage()) {
      carSections.forEach((section) => {
        const open = section === target;
        section.classList.toggle('is-mobile-open', open);
        section.querySelector<HTMLButtonElement>('.car-mobile-toggle')?.setAttribute('aria-expanded', String(open));
      });
      document.querySelectorAll('.car-nav-link').forEach((link) => link.classList.toggle('active', link.getAttribute('href') === `#${id}`));
      
      if (scroll) {
        void target.offsetHeight;
        const targetTop = target.getBoundingClientRect().top + window.scrollY - 12;
        window.scrollTo({
          top: Math.max(0, targetTop),
          behavior: 'smooth'
        });
      }
    } else if (scroll) {
      const lenis = (window as any).lenis;
      if (lenis) {
        lenis.scrollTo(target, { offset: -100, duration: 1.2 });
      } else {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  };

  carSections.forEach((section) => {
    const toggleBtn = section.querySelector<HTMLButtonElement>('.car-mobile-toggle');
    toggleBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = section.classList.contains('is-mobile-open');
      if (isOpen) {
        section.classList.remove('is-mobile-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
      } else {
        history.replaceState(null, '', `#${section.id}`);
        scrollToCar(section.id, true);
      }
    });
    const gallery = section.querySelector<HTMLElement>('.car-gallery');
    gallery?.querySelector<HTMLButtonElement>('.car-gallery-toggle')?.addEventListener('click', (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const open = gallery.classList.toggle('is-open');
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open ? 'Hide gallery' : 'View gallery';
    });
  });

  const carNavLinks = document.querySelectorAll<HTMLAnchorElement>('.car-nav-link, a[href^="#"]');
  carNavLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href && href.startsWith('#') && href.length > 1) {
        const id = href.slice(1);
        const target = document.getElementById(id);
        if (target) {
          e.preventDefault();
          history.pushState(null, '', href);
          scrollToCar(id, true);
        }
      }
    });
  });

  const openHash = () => {
    if (location.hash && location.hash.length > 1) {
      const id = location.hash.slice(1);
      setTimeout(() => scrollToCar(id, true), 200);
    }
  };

  window.addEventListener('hashchange', openHash);
  openHash();
</script>
