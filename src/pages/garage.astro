---
// src/pages/garage.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CarSection from '../components/garage/CarSection.astro';
import garageData from '../data/garage.json';
import BlindsHero from '../components/BlindsHero.astro';

const pageGradient = ['#9FFF10', '#00F3CB'];

const pageTitle = "Garage | ARISTURTLE";
---

<BaseLayout title={pageTitle} pageColors={pageGradient}>
  <!-- HERO SECTION -->
  <div class="relative lg:sticky top-0 w-full h-[100svh] z-0">
    <BlindsHero title="GARAGE" description="The machines that drive us forward. Explore the engineering behind our fleet." gradientColors={pageGradient} />
  </div>

  <div class="bg-brand-midnight w-full min-h-screen text-white relative z-10 overflow-x-clip">
    {/* Car Selector Sub-Navbar (Static) */}
    <div class="relative w-full bg-brand-midnight border-b border-white/10">
      <div class="max-w-[1800px] mx-auto px-6 lg:px-12 flex items-center justify-start md:justify-center gap-6 md:gap-12 py-4 overflow-x-auto hide-scrollbar">
        {garageData.map((car) => (
          <a 
            href={`#${car.id}`} 
            class="car-nav-link gradient-underline min-h-11 inline-flex items-center font-jura text-sm lg:text-base font-bold uppercase text-gray-400 hover:text-[--brand-orange] transition-colors whitespace-nowrap"
          >
            {car.name}
          </a>
        ))}
      </div>
    </div>

    {/* Vertical Stack of Cars */}
    <div class="flex flex-col w-full">
      {garageData.map((car, index) => (
        <div class="relative">
          {index !== 0 && (
            <div class="w-full h-[30vh] lg:h-[45vh] bg-void border-y border-white/10 relative z-20"></div>
          )}
          <CarSection car={car} isInitial={index === 0} />
        </div>
      ))}
    </div>

  </div>

  <dialog id="gallery-lightbox" aria-label="Garage image viewer">
    <div class="gallery-lightbox-shell" data-lenis-prevent>
      <button class="gallery-lightbox-close" type="button" aria-label="Close image viewer">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>

      <button class="gallery-lightbox-nav gallery-lightbox-prev" type="button" aria-label="Previous image">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m15 5-7 7 7 7" />
        </svg>
      </button>

      <figure class="gallery-lightbox-figure">
        <img class="gallery-lightbox-image" alt="" />
        <figcaption class="gallery-lightbox-meta" aria-live="polite">
          <span class="gallery-lightbox-caption"></span>
          <span class="gallery-lightbox-count"></span>
        </figcaption>
      </figure>

      <button class="gallery-lightbox-nav gallery-lightbox-next" type="button" aria-label="Next image">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m9 5 7 7-7 7" />
        </svg>
      </button>
    </div>
  </dialog>
</BaseLayout>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  #gallery-lightbox {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(4, 4, 4, 0.97);
    color: white;
  }

  #gallery-lightbox[open] {
    display: block;
    animation: lightbox-enter 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  #gallery-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.92);
  }

  .gallery-lightbox-shell {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    padding: max(4.5rem, env(safe-area-inset-top)) max(4.5rem, env(safe-area-inset-right)) max(2rem, env(safe-area-inset-bottom)) max(4.5rem, env(safe-area-inset-left));
  }

  .gallery-lightbox-figure {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .gallery-lightbox-image {
    display: block;
    max-width: 100%;
    max-height: calc(100% - 2.5rem);
    object-fit: contain;
    opacity: 1;
    transform: scale(1);
    transition: opacity 0.2s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-lightbox-image.is-changing {
    opacity: 0;
    transform: scale(0.985);
  }

  .gallery-lightbox-meta {
    display: flex;
    width: min(100%, 70rem);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: rgba(255, 255, 255, 0.64);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .gallery-lightbox-count {
    color: var(--brand-orange);
    white-space: nowrap;
  }

  .gallery-lightbox-close,
  .gallery-lightbox-nav {
    position: absolute;
    z-index: 2;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(10, 10, 10, 0.72);
    color: white;
    transition: border-color 0.3s ease, color 0.3s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-lightbox-close:hover,
  .gallery-lightbox-nav:hover,
  .gallery-lightbox-close:focus-visible,
  .gallery-lightbox-nav:focus-visible {
    border-color: var(--brand-orange);
    color: var(--brand-orange);
  }

  .gallery-lightbox-close:focus-visible,
  .gallery-lightbox-nav:focus-visible {
    outline: 2px solid var(--brand-orange);
    outline-offset: 3px;
  }

  .gallery-lightbox-close {
    top: max(1rem, env(safe-area-inset-top));
    right: max(1rem, env(safe-area-inset-right));
  }

  .gallery-lightbox-close span {
    position: absolute;
    width: 1.2rem;
    height: 1px;
    background: currentColor;
  }

  .gallery-lightbox-close span:first-child { transform: rotate(45deg); }
  .gallery-lightbox-close span:last-child { transform: rotate(-45deg); }

  .gallery-lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .gallery-lightbox-nav:hover { transform: translateY(-50%) scale(1.06); }
  .gallery-lightbox-prev { left: max(1rem, env(safe-area-inset-left)); }
  .gallery-lightbox-next { right: max(1rem, env(safe-area-inset-right)); }
  .gallery-lightbox-nav svg { width: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.7; }

  @keyframes lightbox-enter {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 639px) {
    .gallery-lightbox-shell {
      padding: max(4.25rem, env(safe-area-inset-top)) max(0.75rem, env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom)) max(0.75rem, env(safe-area-inset-left));
    }

    .gallery-lightbox-figure { gap: 0.75rem; }
    .gallery-lightbox-image { max-height: calc(100% - 3rem); }
    .gallery-lightbox-meta { padding-inline: 0.25rem; font-size: 0.62rem; }
    .gallery-lightbox-nav { top: auto; bottom: max(3.5rem, calc(env(safe-area-inset-bottom) + 2.5rem)); }
    .gallery-lightbox-prev { left: max(0.75rem, env(safe-area-inset-left)); }
    .gallery-lightbox-next { right: max(0.75rem, env(safe-area-inset-right)); }
  }

  @media (prefers-reduced-motion: reduce) {
    #gallery-lightbox[open] { animation: none; }
    .gallery-lightbox-image,
    .gallery-lightbox-close,
    .gallery-lightbox-nav { transition: none; }
  }
</style>

<style is:global>
  html.gallery-lightbox-open,
  html.gallery-lightbox-open body {
    overflow: hidden;
  }
</style>

<script>
  const carSections = Array.from(document.querySelectorAll<HTMLElement>('.car-section'));
  const isMobileGarage = () => window.matchMedia('(max-width: 1023px)').matches;

  const scrollToCar = (id: string, scroll = true) => {
    if (!id) return;
    const target = document.getElementById(id);
    if (!target?.classList.contains('car-section')) return;

    if (isMobileGarage()) {
      carSections.forEach((section) => {
        const open = section === target;
        section.classList.toggle('is-mobile-open', open);
        section.querySelector<HTMLButtonElement>('.car-mobile-toggle')?.setAttribute('aria-expanded', String(open));
      });
      document.querySelectorAll('.car-nav-link').forEach((link) => link.classList.toggle('active', link.getAttribute('href') === `#${id}`));
      
      if (scroll) {
        void target.offsetHeight;
        const targetTop = target.getBoundingClientRect().top + window.scrollY - 12;
        window.scrollTo({
          top: Math.max(0, targetTop),
          behavior: 'smooth'
        });
      }
    } else if (scroll) {
      const lenis = (window as any).lenis;
      if (lenis) {
        lenis.scrollTo(target, { offset: -100, duration: 1.2 });
      } else {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  };

  carSections.forEach((section) => {
    const toggleBtn = section.querySelector<HTMLButtonElement>('.car-mobile-toggle');
    toggleBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = section.classList.contains('is-mobile-open');
      if (isOpen) {
        section.classList.remove('is-mobile-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
      } else {
        history.replaceState(null, '', `#${section.id}`);
        scrollToCar(section.id, true);
      }
    });
    const gallery = section.querySelector<HTMLElement>('.car-gallery');
    gallery?.querySelector<HTMLButtonElement>('.car-gallery-toggle')?.addEventListener('click', (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const open = gallery.classList.toggle('is-open');
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open ? 'Hide gallery' : 'View gallery';
    });
  });

  const lightbox = document.querySelector<HTMLDialogElement>('#gallery-lightbox');
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>('.gallery-lightbox-image');
  const lightboxCaption = lightbox?.querySelector<HTMLElement>('.gallery-lightbox-caption');
  const lightboxCount = lightbox?.querySelector<HTMLElement>('.gallery-lightbox-count');
  const lightboxClose = lightbox?.querySelector<HTMLButtonElement>('.gallery-lightbox-close');
  const lightboxPrevious = lightbox?.querySelector<HTMLButtonElement>('.gallery-lightbox-prev');
  const lightboxNext = lightbox?.querySelector<HTMLButtonElement>('.gallery-lightbox-next');
  let activeGalleryItems: HTMLButtonElement[] = [];
  let activeGalleryIndex = 0;
  let lightboxTrigger: HTMLButtonElement | null = null;
  let lightboxImageTimer: number | undefined;

  const updateLightbox = (index: number, animate = true) => {
    if (!lightboxImage || activeGalleryItems.length === 0) return;
    window.clearTimeout(lightboxImageTimer);
    activeGalleryIndex = (index + activeGalleryItems.length) % activeGalleryItems.length;
    const item = activeGalleryItems[activeGalleryIndex];
    const thumbnail = item.querySelector<HTMLImageElement>('img');
    const applyImage = () => {
      lightboxImage.src = item.dataset.gallerySrc || thumbnail?.currentSrc || thumbnail?.src || '';
      lightboxImage.alt = thumbnail?.alt || item.dataset.galleryLabel || '';
      if (lightboxCaption) lightboxCaption.textContent = item.dataset.galleryLabel || '';
      if (lightboxCount) lightboxCount.textContent = `${activeGalleryIndex + 1} / ${activeGalleryItems.length}`;
      requestAnimationFrame(() => lightboxImage.classList.remove('is-changing'));
    };

    if (animate) {
      lightboxImage.classList.add('is-changing');
      lightboxImageTimer = window.setTimeout(applyImage, 130);
    } else {
      applyImage();
    }
  };

  const openLightbox = (trigger: HTMLButtonElement) => {
    if (!lightbox) return;
    const group = trigger.dataset.galleryGroup;
    activeGalleryItems = Array.from(document.querySelectorAll<HTMLButtonElement>(`[data-gallery-item][data-gallery-group="${CSS.escape(group || '')}"]`));
    activeGalleryIndex = Math.max(0, activeGalleryItems.indexOf(trigger));
    lightboxTrigger = trigger;
    const showNavigation = activeGalleryItems.length > 1;
    if (lightboxPrevious) lightboxPrevious.hidden = !showNavigation;
    if (lightboxNext) lightboxNext.hidden = !showNavigation;
    updateLightbox(activeGalleryIndex, false);
    document.documentElement.classList.add('gallery-lightbox-open');
    (window as any).lenis?.stop();
    lightbox.showModal();
    lightboxClose?.focus();
  };

  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element).closest<HTMLButtonElement>('[data-gallery-item]');
    if (trigger) openLightbox(trigger);
  });

  lightboxClose?.addEventListener('click', () => lightbox?.close());
  lightboxPrevious?.addEventListener('click', () => updateLightbox(activeGalleryIndex - 1));
  lightboxNext?.addEventListener('click', () => updateLightbox(activeGalleryIndex + 1));

  lightbox?.addEventListener('click', (event) => {
    const target = event.target;
    if (
      target === lightbox ||
      (target instanceof Element && target.matches('.gallery-lightbox-shell, .gallery-lightbox-figure'))
    ) {
      lightbox.close();
    }
  });

  lightbox?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      updateLightbox(activeGalleryIndex - 1);
    } else if (event.key === 'ArrowRight') {
      event.preventDefault();
      updateLightbox(activeGalleryIndex + 1);
    }
  });

  lightbox?.addEventListener('close', () => {
    window.clearTimeout(lightboxImageTimer);
    document.documentElement.classList.remove('gallery-lightbox-open');
    (window as any).lenis?.start();
    lightboxImage?.classList.remove('is-changing');
    lightboxTrigger?.focus();
  });

  const carNavLinks = document.querySelectorAll<HTMLAnchorElement>('.car-nav-link, a[href^="#"]');
  carNavLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href && href.startsWith('#') && href.length > 1) {
        const id = href.slice(1);
        const target = document.getElementById(id);
        if (target) {
          e.preventDefault();
          history.pushState(null, '', href);
          scrollToCar(id, true);
        }
      }
    });
  });

  const openHash = () => {
    if (location.hash && location.hash.length > 1) {
      const id = location.hash.slice(1);
      setTimeout(() => scrollToCar(id, true), 200);
    }
  };

  window.addEventListener('hashchange', openHash);
  openHash();
</script>
