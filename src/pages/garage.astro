---
// src/pages/garage.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CarSection from '../components/garage/CarSection.astro';
import garageData from '../data/garage.json';

const pageTitle = "Garage | ARISTURTLE";
---

<BaseLayout title={pageTitle} forceCompact={true}>
  <div class="bg-[#0A0A0A] w-full min-h-screen text-white relative">
    
    {/* Sticky Car Selector Sub-Navbar */}
    <div class="sticky top-20 z-40 w-full bg-[#0A0A0A]/90 backdrop-blur-md border-b border-gray-800">
      <div class="max-w-[1800px] mx-auto px-6 lg:px-12 flex items-center justify-center gap-8 md:gap-12 py-4 overflow-x-auto hide-scrollbar">
        {garageData.map((car) => (
          <a 
            href={`#${car.id}`} 
            class="font-jura text-sm lg:text-base font-bold uppercase text-gray-400 hover:text-[--brand-orange] transition-colors whitespace-nowrap"
          >
            {car.name}
          </a>
        ))}
      </div>
    </div>

    {/* Vertical Stack of Cars */}
    <div class="flex flex-col w-full">
      {garageData.map((car, index) => (
        <div class={index !== 0 ? "border-t border-gray-900" : ""}>
          <CarSection car={car} />
        </div>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
