---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Page not found | ARISTURTLE" forceCompact>
	<section class="flex min-h-[80svh] items-center bg-void pt-32 pb-20">
		<div class="container-site flex flex-col items-start gap-8">
			<p class="eyebrow">Error 404</p>
			<h1 class="h-hero">off track</h1>
			<p class="lead">Sorry, this page isn't available. The link may be broken, or the page may have been removed.</p>
			<a href={baseUrl} class="btn btn--solid">Go to Homepage</a>
		</div>
	</section>
</BaseLayout>
