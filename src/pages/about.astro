---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import { fsgPhotos } from '../data/fsg-media';
import tracksidePhoto from '../images/Aristurtle_photo_1-1_2.jpg';
import paddockPhoto from '../images/Aristurtle_photo_3-1_2.jpg';
import workshopPhoto from '../images/Untitled-12_3.jpg';
import testingPhoto from '../images/Untitled-7_1.jpg';
import { aboutValues } from '../data/site';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${baseUrl}${path.replace(/^\//, '')}`;
---

<BaseLayout title="About | ARISTURTLE" description="Aristurtle is the Aristotle University of Thessaloniki Formula Student team building electric and driverless race cars.">
	<PageHero
		eyebrow="About"
		title="who we are"
		subtitle="Aristotle University Racing Team Electric, better known as Aristurtle."
	/>

	<section class="section-pad bg-void">
		<div class="container-site grid gap-14 lg:grid-cols-2 lg:gap-24">
			<div class="flex flex-col gap-6">
				<p class="lead !max-w-none text-white/90" data-reveal>
					Aristurtle is a pioneering student research team at the Aristotle University of Thessaloniki, dedicated to designing, developing and building electric and driverless race cars. The team operates under the Department of Electrical and Computer Engineering and consists of students from fields ranging from Electrical and Mechanical Engineering to Physics and Economics.
				</p>
				<p class="lead !max-w-none" data-reveal>
					Working under the pressure of demanding deadlines, our members tackle tasks that demand their full theoretical and practical abilities. Our cars are built according to the rules and standards of Formula Student, and the team is organised into specialised subgroups that collaborate under the Team Captain to deliver one unified, impeccably operating result.
				</p>
			</div>
			<figure data-reveal>
				<Image src={fsgPhotos.team.image} alt={fsgPhotos.team.alt} class="block h-auto w-full border border-line" widths={[600, 1000, 1400]} sizes="(max-width: 1024px) 100vw, 50vw" loading="lazy" />
				<figcaption class="mt-3 text-xs text-muted"><a href={fsgPhotos.team.source} target="_blank" rel="noopener noreferrer" class="link-inline">{fsgPhotos.team.credit}</a></figcaption>
			</figure>
		</div>
	</section>

	<section class="purpose-section img-section section-pad border-t border-line" aria-label="Purpose and vision">
		<Image src={fsgPhotos.purpose.image} alt="" class="img-section__media" widths={[800, 1400, 2200]} sizes="100vw" loading="lazy" />
		<div class="purpose-section__fade" aria-hidden="true"></div>
		<div class="container-site grid gap-12 md:grid-cols-2 md:gap-16 lg:gap-24">
			<div class="border-t border-white/30 pt-8" data-reveal>
				<p class="eyebrow mb-5">What drives us</p>
				<h2 class="h-section !text-[clamp(1.8rem,3.5vw,3rem)]">our purpose</h2>
				<p class="lead mt-6 !text-white/90">To design, develop and build top-tier electric race cars and compete in international Formula Student competitions against academic institutions from all around the world.</p>
			</div>
			<div class="border-t border-brand-orange/60 pt-8" data-reveal>
				<p class="eyebrow mb-5">Where we are headed</p>
				<h2 class="h-section !text-[clamp(1.8rem,3.5vw,3rem)] !text-brand-orange">our vision</h2>
				<p class="lead mt-6 !text-white/90">To contribute to research around innovative technologies and to promote electric mobility in Greece and abroad, by materialising high-level pioneering products.</p>
			</div>
		</div>
		<div class="container-site mt-12 text-xs text-white/70"><a href={fsgPhotos.purpose.source} target="_blank" rel="noopener noreferrer" class="link-inline">{fsgPhotos.purpose.credit}</a></div>
	</section>

	<!-- GALLERY: LIFE AT ARISTURTLE -->
	<section class="section-pad border-t border-line bg-void" aria-labelledby="life-title">
		<div class="container-site">
			<div class="flex flex-col gap-4 max-w-2xl mb-12" data-reveal>
				<p class="eyebrow">Life at Aristurtle</p>
				<h2 id="life-title" class="h-section">from workshop to racetrack</h2>
				<p class="lead">
					Thousands of hours of research, computer-aided design, composite manufacturing, and dynamometer testing culminate in competition days at Europe's most challenging Formula Student tracks.
				</p>
			</div>

			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
				<div class="group relative aspect-[4/5] overflow-hidden bg-panel-2 border border-line" data-reveal>
					<Image src={workshopPhoto} alt="Workshop fabrication" class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" widths={[400, 700]} sizes="(max-width: 640px) 100vw, 25vw" loading="lazy" />
					<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-void/90 via-void/40 to-transparent p-5">
						<p class="text-xs font-bold uppercase tracking-wider text-brand-orange">Manufacture</p>
						<p class="text-sm font-semibold mt-1">In-house composite & electrical fabrication</p>
					</div>
				</div>

				<div class="group relative aspect-[4/5] overflow-hidden bg-panel-2 border border-line" data-reveal>
					<Image src={testingPhoto} alt="Vehicle track testing" class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" widths={[400, 700]} sizes="(max-width: 640px) 100vw, 25vw" loading="lazy" />
					<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-void/90 via-void/40 to-transparent p-5">
						<p class="text-xs font-bold uppercase tracking-wider text-brand-orange">Testing</p>
						<p class="text-sm font-semibold mt-1">Telemetry calibration and track validation</p>
					</div>
				</div>

				<div class="group relative aspect-[4/5] overflow-hidden bg-panel-2 border border-line" data-reveal>
					<Image src={paddockPhoto} alt="Paddock preparations" class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" widths={[400, 700]} sizes="(max-width: 640px) 100vw, 25vw" loading="lazy" />
					<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-void/90 via-void/40 to-transparent p-5">
						<p class="text-xs font-bold uppercase tracking-wider text-brand-orange">Paddock</p>
						<p class="text-sm font-semibold mt-1">High-pressure mechanical & electrical scrutineering</p>
					</div>
				</div>

				<div class="group relative aspect-[4/5] overflow-hidden bg-panel-2 border border-line" data-reveal>
					<Image src={tracksidePhoto} alt="Team celebration trackside" class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" widths={[400, 700]} sizes="(max-width: 640px) 100vw, 25vw" loading="lazy" />
					<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-void/90 via-void/40 to-transparent p-5">
						<p class="text-xs font-bold uppercase tracking-wider text-brand-orange">Competition</p>
						<p class="text-sm font-semibold mt-1">Racing against world-class universities</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section-pad border-t border-line bg-panel" aria-labelledby="values-title">
		<div class="container-site">
			<h2 id="values-title" class="h-section" data-reveal>what ARISTURTLE stands for</h2>
			<ol class="mt-14 grid grid-cols-1 gap-px bg-line sm:grid-cols-2 lg:grid-cols-5">
				{aboutValues.map((v) => (
					<li class="flex flex-col gap-3 bg-void p-7" data-reveal>
						<p class="text-5xl font-bold leading-none text-brand-orange" aria-hidden="true">{v.letter}</p>
						<h3 class="text-lg font-bold" aria-label={`${v.letter}${v.title}`}>{v.letter}{v.title}</h3>
						<p class="text-sm text-muted">{v.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section-pad border-t border-line bg-void">
		<div class="container-site flex flex-col items-start gap-10">
			<h2 class="h-section" data-reveal>meet the people behind the car</h2>
			<div class="flex flex-wrap gap-4" data-reveal>
				<a href={href('/subteams')} class="btn btn--solid">Explore Subteams</a>
				<a href={href('/team')} class="btn">Meet the Members</a>
				<a href={href('/cars')} class="btn">See the Cars</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.purpose-section { min-height: 36rem; display: flex; flex-direction: column; justify-content: center; }
	.purpose-section__fade {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(90deg, rgb(10 10 10 / 94%), rgb(10 10 10 / 70%)),
			linear-gradient(0deg, var(--color-void), transparent 45%, var(--color-void));
	}
</style>
