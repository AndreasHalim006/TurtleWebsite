---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Hero Image
import heroImage from '../assets/images/Aristurtle_photo_1-1_2.jpg';

// Fetch all active sponsors
const allSponsors = await getCollection('sponsors', ({ data }) => {
    return data.active === true;
});

// Fetch all categories and sort by order
const allCategories = await getCollection('sponsorCategories');
const sortedCategories = allCategories.sort((a, b) => a.data.order - b.data.order);

// Helper to group sponsors by category key
const getSponsorsByCategory = (categoryKey: string) => {
    return allSponsors
        .filter(sponsor => sponsor.data.category === categoryKey)
        .sort((a, b) => a.data.order - b.data.order);
};

const hasData = allCategories.length > 0 && allSponsors.length > 0;
---

<BaseLayout title="ARISTURTLE | Our Partners & Sponsors">
    <div class="bg-void min-h-screen w-full relative text-foreground selection:bg-brand-orange selection:text-brand-emerald">
        
        <!-- PURE BACKGROUND GRID -->
        <div class="fixed inset-0 z-0 micro-grid opacity-10 pointer-events-none"></div>

        <!-- HERO SECTION -->
        <section id="hero" class="relative h-screen w-full flex flex-col items-center justify-center z-10 overflow-hidden bg-brand-midnight">
            <div class="absolute inset-0 z-0 overflow-hidden">
                <Image 
                    src={heroImage} 
                    alt="Aristurtle Team" 
                    class="w-full h-full object-cover opacity-40 scale-105"
                    id="hero-image"
                />
                <div class="absolute inset-0 bg-gradient-to-b from-void/40 via-transparent to-void"></div>
            </div>

            <div class="relative max-w-[1800px] mx-auto w-full text-center flex flex-col items-center gap-6 z-20 px-[5vw]">
                <span class="font-sans text-[12px] font-bold uppercase tracking-[1em] text-brand-orange hero-reveal opacity-0 translate-y-8">
                    // STRATEGIC_ALLIANCE
                </span>
                <h1 class="font-sans text-6xl md:text-8xl lg:text-9xl leading-[0.85] text-white font-light hero-reveal opacity-0 translate-y-8">
                    OUR <span class="font-bold">PARTNERS</span>
                </h1>
                <div class="w-32 h-[1px] bg-brand-orange/40 mt-6 hero-reveal opacity-0 scale-x-0"></div>
                <p class="font-sans text-sm md:text-base opacity-60 max-w-xl tracking-widest mt-6 hero-reveal opacity-0 translate-y-8 leading-relaxed">
                    ENGINEERING THE FUTURE OF MOBILITY THROUGH STRATEGIC COLLABORATION AND TECHNICAL EXCELLENCE.
                </p>
            </div>

            <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4 opacity-30 hero-reveal translate-y-8">
                <span class="text-[10px] uppercase tracking-[0.5em]">Scroll to Explore</span>
                <div class="w-[1px] h-12 bg-white/40"></div>
            </div>
        </section>

        <!-- HORIZONTAL SCROLL SECTION -->
        <div id="horizontal-wrapper" class="relative w-full overflow-hidden bg-void z-20">
            <div id="horizontal-content" class="flex flex-row items-center h-screen w-max">
                
                {hasData ? (
                    sortedCategories.map((category, idx) => {
                        const categorySponsors = getSponsorsByCategory(category.data.key);
                        if (categorySponsors.length === 0) return null;

                        return (
                            <section class="tier-section flex-shrink-0 min-w-screen h-full flex flex-col justify-center px-[8vw] py-24 relative border-r border-white/5 bg-void">
                                <!-- Background Index -->
                                <span class="absolute top-12 left-12 font-sans text-[150px] font-bold opacity-[0.05] pointer-events-none select-none z-0">
                                    0{idx + 1}
                                </span>

                                <div class="flex flex-col gap-12 max-w-[1600px] w-full mx-auto z-10">
                                    <div class="flex flex-col gap-4">
                                        <h2 class="font-sans font-bold uppercase text-4xl md:text-6xl tracking-tight text-white tier-title">
                                            {category.data.title}
                                        </h2>
                                        <div class="w-16 h-[4px] bg-brand-orange"></div>
                                        {category.data.description && (
                                            <p class="font-sans text-xs md:text-sm opacity-50 tracking-widest max-w-2xl leading-relaxed tier-desc">
                                                {category.data.description}
                                            </p>
                                        )}
                                    </div>

                                    <!-- PERFECTLY SPACED 3-2 ALTERNATING HONEYCOMB GRID -->
                                    <div class="honeycomb-container flex flex-row mt-4 pb-48">
                                        {(() => {
                                            const columns = [];
                                            let i = 0;
                                            let colCounter = 0;
                                            while (i < categorySponsors.length) {
                                                const size = colCounter % 2 === 0 ? 3 : 2;
                                                columns.push(categorySponsors.slice(i, i + size));
                                                i += size;
                                                colCounter++;
                                            }
                                            
                                            // SCALED GEOMETRIC CONSTANTS
                                            const HEX_W = 190;
                                            const HEX_H = 165;
                                            const GAP = 12; 
                                            
                                            const colOffsetY = (HEX_H + GAP) / 2;
                                            const colMarginX = (HEX_W * 0.25) - GAP;
                                            
                                            return columns.map((column, colIdx) => (
                                                <div 
                                                    class="flex flex-col"
                                                    style={`
                                                        gap: ${GAP}px;
                                                        transform: translateY(${colIdx % 2 === 1 ? colOffsetY : 0}px);
                                                        margin-left: ${colIdx > 0 ? -colMarginX : 0}px;
                                                    `}
                                                >
                                                    {column.map((sponsor) => {
                                                        const isLink = !!sponsor.data.website;
                                                        const Tag = isLink ? 'a' : 'div';
                                                        const linkProps = isLink ? {
                                                            href: sponsor.data.website,
                                                            target: "_blank",
                                                            rel: "noopener noreferrer"
                                                        } : {};

                                                        return (
                                                            <div class="sponsor-item relative" style={`width: ${HEX_W}px; height: ${HEX_H}px;`}>
                                                                <Tag {...linkProps} class={`group relative w-full h-full flex items-center justify-center ${isLink ? 'cursor-pointer' : 'cursor-default'}`}>
                                                                    <svg viewBox="0 0 116 100" class="absolute inset-0 w-full h-full drop-shadow-[0_0_15px_rgba(255,255,255,0.1)]">
                                                                        <!-- Outer Border (Turns Orange on Hover) -->
                                                                        <polygon 
                                                                            points="29 0, 87 0, 116 50, 87 100, 29 100, 0 50" 
                                                                            fill="#f0f0f0" 
                                                                            class="transition-all duration-500 group-hover:fill-[#ff8900] origin-center"
                                                                        />
                                                                        <!-- Inner Core (WHITE) -->
                                                                        <polygon 
                                                                            points="31 4, 85 4, 112 50, 85 96, 31 96, 4 50" 
                                                                            fill="#ffffff" 
                                                                            class="transition-all duration-500 origin-center"
                                                                        />
                                                                    </svg>
                                                                    
                                                                    <div class="relative z-10 w-full h-full flex items-center justify-center">
                                                                        <img 
                                                                            src={sponsor.data.logo} 
                                                                            alt={sponsor.data.alt || sponsor.data.name} 
                                                                            loading="lazy"
                                                                            class="max-w-[70%] max-h-[60%] object-contain opacity-100 transition-all duration-700 group-hover:scale-110"
                                                                        />
                                                                    </div>
                                                                </Tag>
                                                            </div>
                                                        );
                                                    })}
                                                </div>
                                            ));
                                        })()}
                                    </div>
                                </div>
                            </section>
                        );
                    })
                ) : (
                    <section class="min-w-screen h-full flex items-center justify-center bg-void">
                        <p class="text-white opacity-20 text-3xl tracking-widest uppercase font-bold">// Awaiting Sponsor Data</p>
                    </section>
                )}

                <!-- FINAL CTA -->
                <section class="flex-shrink-0 min-w-[80vw] h-full flex flex-col items-center justify-center px-[10vw] bg-brand-midnight/50 border-l border-white/10">
                    <div class="max-w-[1000px] mx-auto text-center flex flex-col items-center gap-10">
                        <h2 class="font-sans text-5xl md:text-8xl text-white font-light uppercase tracking-tighter">
                            JOIN THE <span class="font-bold text-brand-orange italic">LEGACY</span>
                        </h2>
                        <div class="w-32 h-[1px] bg-brand-orange"></div>
                        <p class="font-sans text-sm md:text-base opacity-50 tracking-[0.2em] max-w-2xl leading-loose">
                            BY PARTNERING WITH ARISTURTLE, YOU DIRECTLY SUPPORT THE INNOVATION AND DEVELOPMENT OF FUTURE ENGINEERS.
                        </p>
                        <a href="mailto:contact@aristurtle.gr" class="relative group inline-flex items-center justify-center px-16 py-6 border-2 border-brand-orange text-brand-orange font-sans font-bold uppercase text-xs tracking-[0.5em] overflow-hidden transition-all duration-700 hover:text-white">
                            <span class="relative z-10">Become a Partner</span>
                            <div class="absolute inset-0 bg-brand-orange scale-x-0 origin-left group-hover:scale-x-100 transition-transform duration-700 ease-expo z-0"></div>
                        </a>
                    </div>
                </section>
            </div>
        </div>

    </div>
</BaseLayout>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { SplitText } from 'gsap/SplitText';

    gsap.registerPlugin(ScrollTrigger, SplitText);

    const LUXE_EASE = "cubic-bezier(0.16, 1, 0.3, 1)";

    window.addEventListener('DOMContentLoaded', () => {
        const mm = gsap.matchMedia();

        mm.add("(prefers-reduced-motion: no-preference)", (context) => {
            
            // Hero Title Reveal
            const heroTitle = document.querySelector('h1');
            if (heroTitle) {
                const split = new SplitText(heroTitle, { type: "lines", linesClass: "overflow-hidden" });
                const splitInner = new SplitText(heroTitle, { type: "lines" });
                
                gsap.from(splitInner.lines, {
                    yPercent: 100,
                    duration: 1.5,
                    stagger: 0.1,
                    ease: "power4.out",
                    delay: 0.4
                });
            }

            // Hero Image Parallax
            gsap.to("#hero-image", {
                scrollTrigger: {
                    trigger: "#hero",
                    start: "top top",
                    end: "bottom top",
                    scrub: true
                },
                y: 100,
                scale: 1.15,
                ease: "none"
            });

            // Hero Reveal
            gsap.to(".hero-reveal:not(h1)", {
                y: 0,
                scaleX: 1,
                opacity: 1,
                duration: 2,
                stagger: 0.15,
                ease: LUXE_EASE,
                delay: 0.2
            });

            // HORIZONTAL SCROLL
            const wrapper = document.querySelector("#horizontal-wrapper");
            const content = document.querySelector("#horizontal-content");

            if (wrapper && content) {
                const totalWidth = (content as HTMLElement).scrollWidth - window.innerWidth;

                gsap.to(content, {
                    x: -totalWidth,
                    ease: "none",
                    scrollTrigger: {
                        trigger: wrapper,
                        pin: true,
                        scrub: 1,
                        start: "top top",
                        end: () => `+=${totalWidth}`,
                        invalidateOnRefresh: true,
                        anticipatePin: 1
                    }
                });
            }

            // Force visible opacity on load to ensure hexagons aren't hidden by buggy animations
            gsap.set(".sponsor-item", { opacity: 1 });

            // Refresh ScrollTrigger
            window.addEventListener('load', () => {
                ScrollTrigger.refresh();
            });

            return () => context.revert();
        });
    });
</script>

<style>
    .min-w-screen {
        min-width: 100vw;
    }
    .w-max {
        width: max-content;
    }
    .ease-expo {
        transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
</style>
