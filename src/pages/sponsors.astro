---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { contact } from '../data/site';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${baseUrl}${path.replace(/^\//, '')}`;
const asset = (p: string) => (p.startsWith('http') ? p : `${baseUrl}${p.replace(/^\//, '')}`);

const categories = (await getCollection('sponsorCategories')).sort((a, b) => a.data.order - b.data.order);
const sponsors = (await getCollection('sponsors', ({ data }) => data.active === true)).sort((a, b) => a.data.order - b.data.order);

const groups = categories
	.map((c) => ({
		key: c.data.key,
		title: c.data.title,
		items: sponsors.filter((s) => s.data.category === c.data.key),
	}))
	.filter((g) => g.items.length > 0);
---

<BaseLayout title="Sponsors | ARISTURTLE" description="The partners and sponsors that make the Aristurtle race cars possible.">
	<PageHero
		eyebrow="Partners"
		title="the partners behind the car"
		subtitle="Our cars exist because of the companies, institutions and individuals who believe in student engineering."
	>
		<div class="mt-8 flex flex-wrap gap-4" data-reveal>
			<a href="mailto:info@aristurtle.gr?subject=Partnership%20Inquiry" class="btn btn--solid btn--lg">
				Become a Partner
			</a>
			<a href="#sponsor-categories" class="btn btn--lg">
				View Current Partners
			</a>
		</div>
	</PageHero>

	<div id="sponsor-categories"></div>

	{groups.map((g, i) => (
		<section class="border-b border-line py-16 md:py-24" style={`background:${i % 2 ? 'var(--color-panel)' : 'var(--color-void)'}`} aria-labelledby={`cat-${g.key}`}>
			<div class="container-site">
				<h2 id={`cat-${g.key}`} class="h-section !text-[clamp(1.8rem,3.5vw,3rem)]" data-reveal>{g.title.toLowerCase()}</h2>
				<ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6">
					{g.items.map((s) => (
						<li class="aspect-[3/2]" data-reveal>
							{(() => {
								const img = (
									<img
										src={asset(s.data.logo)}
										alt={s.data.alt || `${s.data.name} logo`}
										class="max-h-full max-w-full object-contain"
										loading="lazy"
										decoding="async"
									/>
								);
								return s.data.website ? (
									<a href={s.data.website} target="_blank" rel="noopener noreferrer" aria-label={s.data.name} class="flex h-full w-full items-center justify-center bg-[#F9F8F6] p-5 transition-opacity duration-500 hover:opacity-80">{img}</a>
								) : (
									<div class="flex h-full w-full items-center justify-center bg-[#F9F8F6] p-5">{img}</div>
								);
							})()}
						</li>
					))}
				</ul>
			</div>
		</section>
	))}

	<section class="section-pad bg-panel" aria-labelledby="partner-cta">
		<div class="container-site flex flex-col items-start gap-8">
			<h2 id="partner-cta" class="h-section" data-reveal>become a partner</h2>
			<p class="lead" data-reveal>Join the companies that support the next generation of engineers. Get in touch and we will send you our sponsorship package.</p>
			<div class="flex flex-wrap gap-4" data-reveal>
				<a href={`mailto:${contact.email}?subject=Partnership`} class="btn btn--solid">Become a Partner</a>
				<a href={href('/sponsor-portal')} class="btn">Sponsor Portal</a>
			</div>
		</div>
	</section>
</BaseLayout>
