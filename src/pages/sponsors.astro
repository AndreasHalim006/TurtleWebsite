---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Grainient from '../components/reactbits/Grainient';
import TargetCursor from '../components/reactbits/TargetCursor';

import heroImage from '../images/Aristurtle_photo_2-1_2.jpg';

const allSponsors = await getCollection('sponsors', ({ data }) => data.active === true);
const allCategories = await getCollection('sponsorCategories');
const sortedCategories = allCategories.sort((a, b) => a.data.order - b.data.order);

const getSponsorsByCategory = (categoryKey: string) =>
  allSponsors
    .filter((sponsor) => sponsor.data.category === categoryKey)
    .sort((a, b) => a.data.order - b.data.order);

const tiers = sortedCategories
  .map((category) => ({
    id: category.data.key,
    title: category.data.title,
    description: category.data.description,
    sponsors: getSponsorsByCategory(category.data.key).map((sponsor) => ({
      name: sponsor.data.name,
      logo: sponsor.data.logo,
      website: sponsor.data.website,
      alt: sponsor.data.alt || sponsor.data.name,
    })),
  }))
  .filter((tier) => tier.sponsors.length > 0);

const totalSponsors = tiers.reduce((sum, tier) => sum + tier.sponsors.length, 0);
const tierData = tiers.map((tier) => ({
  id: tier.id,
  title: tier.title,
  countLabel: `${tier.sponsors.length} partners indexed`,
  sponsors: tier.sponsors,
}));
const sponsorLogoUrls = Array.from(
  new Set(tiers.flatMap((tier) => tier.sponsors.map((sponsor) => sponsor.logo).filter(Boolean)))
);
---

<BaseLayout title="ARISTURTLE | Partners" description="The official partners and sponsors supporting Aristurtle Racing Team." forceCompact={true}>
  <Fragment slot="head">
    {sponsorLogoUrls.map((logo) => (
      <link rel="preload" as="image" href={logo} fetchpriority="low" />
    ))}
  </Fragment>

  <div class="sponsors-page bg-void text-foreground selection:bg-brand-orange selection:text-brand-emerald">
    <TargetCursor client:only="react" targetSelector=".honeycomb-slot.is-active[href]" spinDuration={2.6} hoverDuration={0.18} />

    <section id="hero" class="sponsors-hero">
      <Image src={heroImage} alt="Aristurtle race car with partner markings" class="hero-image" priority />
      <div class="hero-shade"></div>
      <div class="hero-copy">
        <p class="terminal-kicker hero-reveal">// PARTNER_NETWORK</p>
        <h1 class="hero-title hero-reveal">Partners</h1>
        <p class="hero-text hero-reveal">
          The technical, industrial, academic, and media partners powering Aristurtle on and off track.
        </p>
        <div class="hero-actions hero-reveal">
          <a href="mailto:contact@aristurtle.gr" class="primary-action">Become a Partner</a>
          <a href="#sponsor-assembly" class="secondary-action">View Network</a>
        </div>
      </div>
      <div class="hero-meta hero-reveal" aria-label={`${totalSponsors} active partners across ${tiers.length} tiers`}>
        <span>{String(tiers.length).padStart(2, '0')} tiers</span>
        <span>{String(totalSponsors).padStart(2, '0')} partners</span>
      </div>
    </section>

    <section id="sponsor-assembly" class="sponsor-assembly" style={`--tier-count: ${tiers.length};`}>
      <div class="assembly-shell">
        <div class="assembly-bg" aria-hidden="true">
          <Grainient
            client:load
            color1="#171717"
            color2="#4a2605"
            color3="#050505"
            timeSpeed={0.08}
            colorBalance={0.35}
            warpStrength={0.28}
            warpFrequency={1.8}
            warpSpeed={0.35}
            warpAmplitude={42}
            blendSoftness={0.18}
            noiseScale={1.1}
            grainAmount={0.08}
            contrast={1.35}
            saturation={0.72}
            zoom={1.05}
          />
          <div class="grid-overlay"></div>
          <div class="assembly-vignette"></div>
        </div>

        <header class="assembly-hud" aria-live="polite">
          <p class="terminal-kicker">// ACTIVE_TIER</p>
          <h2 id="active-tier-title">{tiers[0]?.title}</h2>
          <p id="active-tier-count">{tiers[0]?.sponsors.length ?? 0} partners indexed</p>
        </header>

        <nav class="tier-rail" aria-label="Sponsor tiers">
          {tiers.map((tier, index) => (
            <a href={`#tier-step-${tier.id}`} class:list={['tier-rail-link', index === 0 && 'is-active']} data-tier-link={index}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{tier.title}</strong>
            </a>
          ))}
        </nav>

        <div id="honeycomb-field" class="honeycomb-field" aria-label="Interactive sponsor honeycomb">
          <svg class="honeycomb-idle-layer" aria-hidden="true"></svg>
          <div class="honeycomb-active-layer"></div>
        </div>

        <div class="fallback-stage">
          {tiers.map((tier, index) => (
            <section class="fallback-tier" aria-labelledby={`tier-title-${tier.id}`}>
              <div class="mobile-tier-heading">
                <p class="terminal-kicker">// {String(index + 1).padStart(2, '0')}</p>
                <h2 id={`tier-title-${tier.id}`}>{tier.title}</h2>
              </div>

              <div class:list={['fallback-logo-grid', tier.sponsors.length >= 18 && 'is-dense']}>
                {tier.sponsors.map((sponsor) => {
                  const content = (
                    <>
                      <span class="fallback-cell-frame" aria-hidden="true"></span>
                      <img src={sponsor.logo} alt={sponsor.alt} loading="lazy" decoding="async" />
                    </>
                  );

                  return sponsor.website ? (
                    <a
                      class="fallback-cell"
                      href={sponsor.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Visit ${sponsor.name}`}
                    >
                      {content}
                    </a>
                  ) : (
                    <div class="fallback-cell" aria-label={sponsor.name}>
                      {content}
                    </div>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </div>

      <div class="assembly-steps" aria-hidden="true">
        {tiers.map((tier) => (
          <div id={`tier-step-${tier.id}`} class="tier-step"></div>
        ))}
      </div>
    </section>

    <section class="partner-cta">
      <div>
        <p class="terminal-kicker">// OPEN_CHANNEL</p>
        <h2>Partner with Aristurtle</h2>
      </div>
      <p>
        Support a student team building race-ready engineering, autonomous systems, and the next generation of motorsport talent.
      </p>
      <a href="mailto:contact@aristurtle.gr" class="primary-action">Become a Partner</a>
    </section>
  </div>
</BaseLayout>

<noscript>
  <style>
    .honeycomb-field,
    .tier-rail,
    .assembly-hud,
    .assembly-steps {
      display: none !important;
    }

    .fallback-stage {
      display: grid !important;
    }

    .sponsor-assembly,
    .assembly-shell {
      min-height: auto !important;
    }

    .assembly-shell {
      position: relative !important;
      padding: 6rem clamp(1.25rem, 5vw, 5rem) !important;
    }
  </style>
</noscript>

<script is:inline define:vars={{ tierData }}>
  window.SPONSOR_TIERS = tierData;
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    const tiers = (window as any).SPONSOR_TIERS || [];
    const field = document.querySelector<HTMLElement>('#honeycomb-field');
    const idleLayer = document.querySelector<SVGSVGElement>('.honeycomb-idle-layer');
    const activeLayer = document.querySelector<HTMLElement>('.honeycomb-active-layer');
    const steps = gsap.utils.toArray<HTMLElement>('.tier-step');
    const railLinks = gsap.utils.toArray<HTMLElement>('[data-tier-link]');
    const title = document.querySelector<HTMLElement>('#active-tier-title');
    const count = document.querySelector<HTMLElement>('#active-tier-count');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = window.matchMedia('(max-width: 767px)').matches;

    const preloadSponsorLogos = () => {
      const logos = new Set<string>();
      tiers.forEach((tier: any) => {
        tier.sponsors?.forEach((sponsor: any) => {
          if (sponsor.logo) logos.add(sponsor.logo);
        });
      });

      logos.forEach((logo) => {
        const img = new window.Image();
        img.decoding = 'async';
        img.src = logo;
      });
    };

    preloadSponsorLogos();

    gsap.to('.hero-reveal', {
      y: 0,
      opacity: 1,
      duration: reduceMotion ? 0 : 1,
      stagger: reduceMotion ? 0 : 0.08,
      ease: 'power3.out',
    });

    if (!field || !idleLayer || !activeLayer || reduceMotion || mobile || tiers.length === 0) {
      return;
    }

    const IDLE_SCALE = 0.16;
    const ACTIVE_SEED_SCALE = 0.42;
    const IDLE_OPACITY = 0.46;
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const maxSponsorCount = Math.max(...tiers.map((tier: any) => tier.sponsors.length));
    let slots: any[] = [];
    let activeSlots: any[] = [];
    let activePool: any[] = [];
    let activeTimeline: gsap.core.Timeline | null = null;
    let activeIndex = -1;
    let geometry = { w: 104, h: 90 };

    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

    const resetSlot = (slot: any) => {
      if (!slot?.el) return;
      slot.el.classList.remove('is-active');
      slot.el.removeAttribute('href');
      slot.el.removeAttribute('target');
      slot.el.removeAttribute('rel');
      slot.el.removeAttribute('aria-label');
      slot.el.setAttribute('aria-hidden', 'true');
      slot.img.removeAttribute('src');
      slot.img.removeAttribute('alt');
    };

    const setRail = (index: number) => {
      const tier = tiers[index];
      if (!tier) return;
      if (title) title.textContent = tier.title;
      if (count) count.textContent = tier.countLabel;
      railLinks.forEach((link, linkIndex) => {
        link.classList.toggle('is-active', linkIndex === index);
      });
    };

    const createActiveSlot = (parent: DocumentFragment) => {
      const el = document.createElement('a');
      el.className = 'honeycomb-slot';
      el.setAttribute('aria-hidden', 'true');
      el.innerHTML = `
        <span class="honeycomb-frame" aria-hidden="true"></span>
        <img loading="lazy" decoding="async" />
      `;
      parent.appendChild(el);
      return { el, img: el.querySelector('img') };
    };

    const createIdleHex = (parent: DocumentFragment, slot: any, index: number) => {
      const polygon = document.createElementNS(SVG_NS, 'polygon');
      const cx = slot.x + geometry.w / 2;
      const cy = slot.y + geometry.h / 2;
      const radius = Math.min(geometry.w, geometry.h) * 0.5 * IDLE_SCALE;
      const points = Array.from({ length: 6 }, (_, i) => {
        const angle = (Math.PI / 180) * (60 * i);
        return `${(cx + Math.cos(angle) * radius).toFixed(2)},${(cy + Math.sin(angle) * radius).toFixed(2)}`;
      }).join(' ');

      polygon.setAttribute('points', points);
      polygon.setAttribute('class', 'honeycomb-idle-hex');
      polygon.setAttribute('opacity', String(IDLE_OPACITY * slot.idleTone));
      polygon.setAttribute('data-slot-index', String(index));
      parent.appendChild(polygon);
      slot.idleEl = polygon;
    };

    const buildField = () => {
      idleLayer.innerHTML = '';
      activeLayer.innerHTML = '';
      activeSlots = [];
      slots = [];
      activePool = [];

      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const w = clamp(vw / 11, 92, 128);
      const h = w * 0.8660254;
      const gap = clamp(vw / 100, 10, 16);
      const centerDistance = h + gap;
      const dx = centerDistance * 0.8660254;
      const dy = centerDistance;
      const cols = Math.ceil(vw / dx) + 4;
      const rows = Math.ceil(vh / dy) + 4;
      const startX = -w;
      const startY = -h;
      const centerX = vw / 2;
      const centerY = vh / 2;
      const idleFragment = document.createDocumentFragment();
      const activeFragment = document.createDocumentFragment();

      geometry = { w, h };
      idleLayer.setAttribute('viewBox', `0 0 ${vw} ${vh}`);
      idleLayer.setAttribute('width', String(vw));
      idleLayer.setAttribute('height', String(vh));

      for (let c = 0; c < cols; c++) {
        for (let r = 0; r < rows; r++) {
          const x = startX + c * dx;
          const y = startY + r * dy + (c % 2 === 1 ? dy / 2 : 0);
          const dist = Math.hypot(x + w / 2 - centerX, y + h / 2 - centerY);
          const idleTone = clamp(1 - dist / Math.hypot(centerX, centerY), 0.16, 0.82);
          const slot = { x, y, dist, idleTone, idleEl: null, el: null, img: null, activeScale: 1 };
          slots.push(slot);
        }
      }

      slots.sort((a, b) => a.dist - b.dist);
      slots.forEach((slot, index) => createIdleHex(idleFragment, slot, index));

      for (let i = 0; i < maxSponsorCount; i++) {
        const active = createActiveSlot(activeFragment);
        const poolSlot = { ...active, activeScale: 1 };

        poolSlot.el.addEventListener('mouseenter', () => {
          if (!poolSlot.el.classList.contains('is-active')) return;
          gsap.to(poolSlot.el, { scale: (poolSlot.activeScale || 1) * 1.035, duration: 0.18, ease: 'power2.out', overwrite: 'auto' });
        });
        poolSlot.el.addEventListener('mouseleave', () => {
          if (!poolSlot.el.classList.contains('is-active')) return;
          gsap.to(poolSlot.el, { scale: poolSlot.activeScale || 1, duration: 0.18, ease: 'power2.out', overwrite: 'auto' });
        });

        poolSlot.el.style.width = `${w}px`;
        poolSlot.el.style.height = `${h}px`;
        gsap.set(poolSlot.el, { autoAlpha: 0, scale: IDLE_SCALE, x: -9999, y: -9999 });
        activePool.push(poolSlot);
      }

      idleLayer.appendChild(idleFragment);
      activeLayer.appendChild(activeFragment);
    };

    const getActiveScale = (selected: any[]) => {
      if (!selected.length) return 1;
      const minX = Math.min(...selected.map((slot) => slot.x));
      const maxX = Math.max(...selected.map((slot) => slot.x + geometry.w));
      const minY = Math.min(...selected.map((slot) => slot.y));
      const maxY = Math.max(...selected.map((slot) => slot.y + geometry.h));
      const clusterW = maxX - minX;
      const clusterH = maxY - minY;
      const availableW = window.innerWidth * 0.66;
      const availableH = window.innerHeight * 0.6;
      const margin = 18;
      const edgeScale = selected.reduce((scale: number, slot: any) => {
        const cx = slot.x + geometry.w / 2;
        const cy = slot.y + geometry.h / 2;
        const leftScale = (2 * Math.max(0, cx - margin)) / geometry.w;
        const rightScale = (2 * Math.max(0, window.innerWidth - margin - cx)) / geometry.w;
        const topScale = (2 * Math.max(0, cy - margin)) / geometry.h;
        const bottomScale = (2 * Math.max(0, window.innerHeight - margin - cy)) / geometry.h;
        return Math.min(scale, leftScale, rightScale, topScale, bottomScale);
      }, 1);
      return clamp(Math.min(1, availableW / clusterW, availableH / clusterH, edgeScale), 0.58, 1);
    };

    const prepareSlot = (slot: any, sponsor: any) => {
      slot.activeScale = slot.activeScale || 1;
      slot.el.classList.add('is-active');
      slot.el.removeAttribute('aria-hidden');
      slot.el.setAttribute('aria-label', sponsor.website ? `Visit ${sponsor.name}` : sponsor.name);
      if (sponsor.website) {
        slot.el.href = sponsor.website;
        slot.el.target = '_blank';
        slot.el.rel = 'noopener noreferrer';
      } else {
        slot.el.removeAttribute('href');
        slot.el.removeAttribute('target');
        slot.el.removeAttribute('rel');
      }
      slot.img.src = sponsor.logo;
      slot.img.alt = sponsor.alt || sponsor.name;
    };

    const setActiveTier = (index: number, immediate = false) => {
      const tier = tiers[index];
      if (!tier || index === activeIndex || slots.length === 0) return;

      activeTimeline?.kill();
      activeTimeline = gsap.timeline();
      setRail(index);

      const selectedGeometry = slots.slice(0, tier.sponsors.length);
      const selected = activePool.slice(0, tier.sponsors.length);
      const activeScale = getActiveScale(selectedGeometry);
      const previous = [...activeSlots];

      if (previous.length) {
        activeTimeline.to(previous.map((slot) => slot.el), {
          scale: IDLE_SCALE,
          autoAlpha: 0,
          duration: immediate ? 0 : 0.34,
          stagger: immediate ? 0 : { each: 0.008, from: 'center' },
          ease: 'power2.inOut',
          onComplete: () => {
            previous.forEach((slot) => {
              resetSlot(slot);
              gsap.set(slot.el, { x: -9999, y: -9999 });
            });
          },
        });
      }

      activeTimeline.add(() => {
        selected.forEach((slot, slotIndex) => {
          slot.activeScale = activeScale;
          slot.x = selectedGeometry[slotIndex].x;
          slot.y = selectedGeometry[slotIndex].y;
          prepareSlot(slot, tier.sponsors[slotIndex]);
          gsap.set(slot.el, {
            x: slot.x,
            y: slot.y,
            width: geometry.w,
            height: geometry.h,
            scale: immediate ? activeScale : ACTIVE_SEED_SCALE,
            autoAlpha: 1,
          });
          gsap.set(slot.img, { opacity: 1, scale: 1 });
        });
        activeSlots = selected;
      });

      const growDuration = immediate ? 0 : 0.66;
      const waveStep = immediate ? 0 : 0.025;

      activeTimeline.addLabel('hexGrow');
      activeTimeline.to(
        selected.map((slot) => slot.el),
        {
          scale: activeScale,
          duration: growDuration,
          stagger: immediate ? 0 : { each: waveStep, from: 0 },
          ease: 'back.out(1.15)',
          overwrite: true,
        },
        'hexGrow'
      );
      activeIndex = index;
    };

    buildField();
    setActiveTier(0, true);

    steps.forEach((step, index) => {
      ScrollTrigger.create({
        trigger: step,
        start: 'top center',
        end: 'bottom center',
        onEnter: () => setActiveTier(index),
        onEnterBack: () => setActiveTier(index),
      });
    });

    gsap.to('.assembly-shell', {
      scrollTrigger: {
        trigger: '#sponsor-assembly',
        start: 'top top',
        end: 'bottom bottom',
        scrub: true,
      },
      '--assembly-progress': 1,
      ease: 'none',
    });

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        buildField();
        const indexToRestore = Math.max(activeIndex, 0);
        activeIndex = -1;
        setActiveTier(indexToRestore, true);
        ScrollTrigger.refresh();
      }, 180);
    });
  });
</script>

<style is:global>
  .sponsors-page {
    min-height: 100vh;
    overflow: clip;
  }

  .terminal-kicker {
    color: var(--brand-orange);
    font-size: clamp(0.65rem, 0.58rem + 0.2vw, 0.82rem);
    font-weight: 700;
    letter-spacing: 0.48em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .sponsors-hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    place-items: end start;
    overflow: hidden;
    padding: clamp(8rem, 12vw, 13rem) clamp(1.25rem, 5vw, 5rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }

  .hero-image,
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero-image {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.8) contrast(1.08);
    transform: scale(1.03);
  }

  .hero-shade {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(5, 5, 5, 0.94) 0%, rgba(5, 5, 5, 0.64) 42%, rgba(5, 5, 5, 0.16) 100%),
      linear-gradient(0deg, #050505 0%, rgba(5, 5, 5, 0.08) 45%, rgba(5, 5, 5, 0.35) 100%);
  }

  .hero-copy {
    display: grid;
    max-width: 58rem;
    gap: 1.25rem;
  }

  .hero-title {
    color: #fff;
    font-size: clamp(4.8rem, 16vw, 15rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 0.78;
    text-transform: uppercase;
  }

  .hero-text {
    max-width: 42rem;
    color: rgba(246, 247, 251, 0.78);
    font-size: clamp(1rem, 1.4vw, 1.35rem);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.75rem;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 137, 0, 0.72);
    padding: 0 1.25rem;
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
  }

  .primary-action {
    background: var(--brand-orange);
    color: #050505;
  }

  .secondary-action {
    background: rgba(5, 5, 5, 0.28);
  }

  .primary-action:hover,
  .secondary-action:hover {
    transform: translateY(-2px);
    border-color: #fff;
  }

  .hero-meta {
    position: absolute;
    right: clamp(1.25rem, 4vw, 4rem);
    bottom: clamp(1.25rem, 4vw, 3rem);
    display: flex;
    gap: 1rem;
    color: rgba(246, 247, 251, 0.62);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .hero-reveal {
    opacity: 0;
    transform: translateY(1.5rem);
  }

  .sponsor-assembly {
    position: relative;
    min-height: calc(var(--tier-count) * 160svh);
    background: #050505;
  }

  .assembly-shell {
    --assembly-progress: 0;
    position: sticky;
    top: 0;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }

  .assembly-bg,
  .grid-overlay,
  .assembly-vignette {
    position: absolute;
    inset: 0;
    z-index: -3;
  }

  .grid-overlay {
    z-index: -2;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(circle at 55% 52%, #000 0%, rgba(0, 0, 0, 0.74) 44%, transparent 82%);
    opacity: calc(0.22 + (var(--assembly-progress) * 0.12));
  }

  .assembly-vignette {
    z-index: -1;
    background:
      radial-gradient(circle at 50% 44%, transparent 0%, rgba(5, 5, 5, 0.16) 50%, #050505 100%),
      linear-gradient(90deg, rgba(5, 5, 5, 0.91) 0%, transparent 28%, transparent 70%, rgba(5, 5, 5, 0.92) 100%);
  }

  .assembly-hud {
    position: absolute;
    left: clamp(1.25rem, 4vw, 4rem);
    top: clamp(4rem, 8vh, 6rem);
    z-index: 5;
    display: grid;
    max-width: min(30rem, 36vw);
    gap: 0.6rem;
