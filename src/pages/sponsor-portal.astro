---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { contact } from '../data/site';
---

<BaseLayout title="Sponsor Portal | ARISTURTLE" description="A private area for Aristurtle sponsors.">
	<PageHero
		eyebrow="Sponsor portal"
		title="a home for our partners"
		subtitle="A private area for sponsors is coming soon."
	/>

	<section class="section-pad bg-void">
		<div class="container-site grid gap-14 lg:grid-cols-2 lg:gap-24">
			<div class="flex flex-col gap-6">
				<h2 class="h-section" data-reveal>coming soon</h2>
				{/* TODO(content): decide scope of the portal (benefits, assets, reports). No authentication is implemented. */}
				<p class="lead" data-reveal>
					The portal will give partners access to their benefits, brand assets and season reports. Until it launches, your contact on the team is the fastest way to get what you need.
				</p>
				<div data-reveal>
					<a href={`mailto:${contact.email}?subject=Sponsor%20portal`} class="btn btn--solid">Contact the team</a>
				</div>
			</div>
			<div class="ph-box min-h-64" data-reveal role="img" aria-label="Placeholder: portal preview">
				<span>Placeholder<br />Portal preview</span>
			</div>
		</div>
	</section>
</BaseLayout>
