---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeasonSection from '../components/seasons/SeasonSection.astro';
import BlindsHero from '../components/BlindsHero.astro';
import { getCollection } from 'astro:content';

const pageGradient = ['#9FFF10', '#00F3CB'];

const seasons = await getCollection('seasons');
seasons.sort((a, b) => a.data.order - b.data.order);

const pageTitle = "Seasons | ARISTURTLE";
---

<BaseLayout title={pageTitle} pageColors={pageGradient}>
  <!-- HERO SECTION -->
  <div class="relative lg:sticky top-0 w-full h-[100svh] z-0">
    <BlindsHero title="SEASONS" description="A legacy of engineering excellence. Explore our past cars and the teams that built them." gradientColors={pageGradient} />
  </div>

  <div class="bg-brand-midnight w-full min-h-screen text-white relative z-10 overflow-x-clip">
    {/* Season Selector Sub-Navbar (Static) */}
    <div class="relative w-full bg-brand-midnight border-b border-white/10">
      <div class="max-w-[1800px] mx-auto px-6 lg:px-12 flex items-center justify-start md:justify-center gap-8 md:gap-12 py-4 overflow-x-auto hide-scrollbar">
        {seasons.map((season) => (
          <a 
            href={`#${season.data.year}`} 
            class="gradient-underline season-nav-link min-h-11 inline-flex items-center font-jura text-sm lg:text-base font-bold uppercase text-gray-400 hover:text-[--brand-orange] transition-colors whitespace-nowrap"
          >
            {season.data.year}
          </a>
        ))}
      </div>
    </div>

    {/* Vertical Stack of Seasons */}
    <div class="flex flex-col w-full">
      {seasons.map((season, index) => (
        <div 
          id={season.data.year} 
          class:list={['season-section relative scroll-mt-[140px] border-b border-white/10 lg:border-0', index === 0 && 'is-mobile-open', index !== 0 ? 'lg:mt-24 lg:pt-24 lg:border-t lg:border-white/10' : 'lg:pt-8']}
        >
          <button class="season-mobile-toggle lg:hidden min-h-[76px] w-full px-[var(--mobile-gutter)] py-4 flex items-center justify-between text-left" type="button" aria-expanded={index === 0 ? 'true' : 'false'} aria-controls={`season-panel-${season.data.year}`}>
            <span class="text-2xl font-black uppercase">{season.data.year}</span><span class="season-toggle-icon text-3xl text-brand-orange" aria-hidden="true">+</span>
          </button>
          <div id={`season-panel-${season.data.year}`} class="season-mobile-panel">
            <SeasonSection season={season} isInitial={index === 0} />
          </div>
        </div>
      ))}
    </div>

    {/* Global Cursor Tracking Image Preview */}
    <img 
      id="global-member-preview" 
      src="" 
      class="hidden lg:block fixed top-0 left-0 w-[240px] h-[300px] object-cover pointer-events-none z-50 rounded border border-white/10 shadow-2xl invisible"
      alt="Preview"
    />

  </div>
</BaseLayout>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  @media (max-width: 1023px) {
    .season-mobile-panel { display: none; }
    .season-section.is-mobile-open .season-mobile-panel { display: block; }
    .season-section.is-mobile-open .season-toggle-icon { transform: rotate(45deg); }
    .season-toggle-icon { transition: transform .3s cubic-bezier(.16, 1, .3, 1); }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const mobileSeasonSections = Array.from(document.querySelectorAll<HTMLElement>('.season-section'));
  const mobileSeasons = window.matchMedia('(max-width: 1023px)').matches;

  const scrollToSeason = (id: string, scroll = true) => {
    if (!id) return;
    const target = document.getElementById(id);
    if (!target?.classList.contains('season-section')) return;

    if (mobileSeasons) {
      mobileSeasonSections.forEach((section) => {
        const open = section === target;
        section.classList.toggle('is-mobile-open', open);
        section.querySelector<HTMLButtonElement>('.season-mobile-toggle')?.setAttribute('aria-expanded', String(open));
      });
      if (scroll) requestAnimationFrame(() => target.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    } else if (scroll) {
      const lenis = (window as any).lenis;
      if (lenis) {
        lenis.scrollTo(target, { offset: -100, duration: 1.2 });
      } else {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  };

  mobileSeasonSections.forEach((section) => {
    section.querySelector<HTMLButtonElement>('.season-mobile-toggle')?.addEventListener('click', () => {
      if (section.classList.contains('is-mobile-open')) return;
      history.replaceState(null, '', `#${section.id}`);
      scrollToSeason(section.id, true);
    });
  });

  const seasonNavLinks = document.querySelectorAll<HTMLAnchorElement>('.season-nav-link, a[href^="#"]');
  seasonNavLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href && href.startsWith('#') && href.length > 1) {
        const id = href.slice(1);
        const target = document.getElementById(id);
        if (target) {
          e.preventDefault();
          history.pushState(null, '', href);
          scrollToSeason(id, true);
        }
      }
    });
  });

  const activateSeasonHash = () => {
    if (location.hash && location.hash.length > 1) {
      const id = location.hash.slice(1);
      setTimeout(() => scrollToSeason(id, true), 200);
    }
  };

  window.addEventListener('hashchange', activateSeasonHash);
  activateSeasonHash();

  const previewImg = document.getElementById('global-member-preview') as HTMLImageElement;
  const members = document.querySelectorAll('.member-item');
  const desktopFine = window.matchMedia('(min-width: 1024px) and (pointer: fine)').matches;

  const copyEmail = async (email: string) => {
    try {
      await navigator.clipboard.writeText(email);
      return true;
    } catch {
      const textarea = document.createElement('textarea');
      textarea.value = email;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      const copied = document.execCommand('copy');
      textarea.remove();
      return copied;
    }
  };

  if (desktopFine && previewImg && members.length > 0) {
    // Set initial state: centered on cursor coords, invisible
    gsap.set(previewImg, { xPercent: -50, yPercent: -50, scale: 0, autoAlpha: 0 });

    // Use quickTo for performant mouse tracking
    const xTo = gsap.quickTo(previewImg, "x", { duration: 0.4, ease: "power3" });
    const yTo = gsap.quickTo(previewImg, "y", { duration: 0.4, ease: "power3" });

    let isHovering = false;

    window.addEventListener("mousemove", (e) => {
      if (isHovering) {
        xTo(e.clientX);
        yTo(e.clientY);
      }
    });

    members.forEach(member => {
      member.addEventListener("mouseenter", (e: Event) => {
        const mouseEvent = e as MouseEvent;
        isHovering = true;
        
        // Update image source only if it changed to avoid decode lag
        const imgUrl = member.getAttribute('data-image');
        if (imgUrl && previewImg.getAttribute('src') !== imgUrl) {
          previewImg.src = imgUrl;
        }
        
        // Snap position so it doesn't fly in from previous location
        gsap.set(previewImg, { x: mouseEvent.clientX, y: mouseEvent.clientY });

        // Animate in with overwrite "auto" to only kill conflicting opacity/scale tweens, leaving x/y intact
        gsap.to(previewImg, { scale: 1, autoAlpha: 1, duration: 0.4, ease: "power3.out", overwrite: "auto" });
        gsap.to(member, { x: -10, color: '#fff', duration: 0.3, ease: "power2.out", overwrite: "auto" });
      });

      member.addEventListener("mouseleave", () => {
        isHovering = false;
        // Animate out
        gsap.to(previewImg, { scale: 0, autoAlpha: 0, duration: 0.3, ease: "power2.inOut", overwrite: "auto" });
        gsap.to(member, { x: 0, color: '', duration: 0.3, ease: "power2.inOut", overwrite: "auto" });
      });

    });
  }

  members.forEach((member) => {
    member.addEventListener('click', async () => {
      const email = member.getAttribute('data-email');
      if (!email) return;
      const copied = await copyEmail(email);
      const emailSpan = member.querySelector('.email-text');
      if (!copied || !emailSpan) return;
      const originalText = emailSpan.textContent;
      emailSpan.textContent = 'COPIED!';
      emailSpan.classList.add('text-green-400');
      window.setTimeout(() => {
        emailSpan.textContent = originalText;
        emailSpan.classList.remove('text-green-400');
      }, 2000);
    });
  });

  // ScrollSpy for updating URL hash based on visible season
  const seasonSections = mobileSeasonSections;
  const navLinks = document.querySelectorAll('.season-nav-link');
  
  if (seasonSections.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          if (id) {
            // Update URL hash without jumping
            history.replaceState(null, '', `#${id}`);
            
            // Highlight active link in the sub-navbar
            navLinks.forEach(link => {
              if (link.getAttribute('href') === `#${id}`) {
                link.classList.add('text-[--brand-orange]');
                link.classList.remove('text-gray-400');
              } else {
                link.classList.remove('text-[--brand-orange]');
                link.classList.add('text-gray-400');
              }
            });
            
            // Auto-scroll the nav container to keep active link in view
            const activeLink = document.querySelector(`.season-nav-link[href="#${id}"]`);
            if (activeLink) {
              activeLink.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
          }
          
          // Preload images for the members of this season so the hover effect is instant
          if (desktopFine && !entry.target.hasAttribute('data-preloaded')) {
            const membersInSeason = entry.target.querySelectorAll('.member-item');
            
            // Create a hidden container to force image decoding
            let hiddenContainer = document.getElementById('preload-container');
            if (!hiddenContainer) {
              hiddenContainer = document.createElement('div');
              hiddenContainer.id = 'preload-container';
              hiddenContainer.style.display = 'none';
              document.body.appendChild(hiddenContainer);
            }

            membersInSeason.forEach(member => {
              const imgUrl = member.getAttribute('data-image');
              if (imgUrl && imgUrl !== '/favicon.svg') {
                const img = new Image();
                img.src = imgUrl;
                // Appending to DOM forces the browser to decode the image, eliminating lag
                hiddenContainer.appendChild(img);
              }
            });
            entry.target.setAttribute('data-preloaded', 'true');
          }
        }
      });
    }, {
      rootMargin: '-30% 0px -60% 0px', // Triggers when element is near the middle/top of the viewport
      threshold: 0
    });

    seasonSections.forEach(section => observer.observe(section));
  }
</script>
