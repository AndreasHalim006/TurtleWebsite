---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrambledText from '../components/reactbits/ScrambledText.jsx';
import { Image } from 'astro:assets';

// Hero Image
import heroImage from '../images/Aristurtle_photo_1-1_2.jpg';
---

<BaseLayout title="Contact | ARISTURTLE" description="Get in touch with Malamas Bogatinis, Team Leader of ARISTURTLE.">
    <div class="bg-void min-h-screen w-full relative text-foreground selection:bg-brand-orange selection:text-brand-emerald">
        
        <!-- PURE BACKGROUND GRID -->
        <div class="fixed inset-0 z-0 micro-grid opacity-10 pointer-events-none"></div>

        <!-- HERO SECTION -->
        <section id="hero" class="relative h-screen w-full flex flex-col items-center justify-center z-10 overflow-hidden bg-brand-midnight">
            <div class="absolute inset-0 z-0 overflow-hidden">
                <Image 
                    src={heroImage} 
                    alt="Aristurtle Team Workshop" 
                    class="w-full h-full object-cover opacity-40 scale-105"
                    id="hero-image"
                />
                <div class="absolute inset-0 bg-gradient-to-b from-void/40 via-transparent to-void"></div>
            </div>

            <div class="relative max-w-[1800px] mx-auto w-full text-center flex flex-col items-center gap-6 z-20 px-[5vw]">
                <span class="font-sans text-[12px] font-bold uppercase tracking-[1em] text-brand-orange hero-reveal opacity-0 translate-y-8">
                    // HUMAN_CONNECTION
                </span>
                <div class="overflow-hidden hero-reveal opacity-0 translate-y-8">
                    <ScrambledText 
                        client:load 
                        className="text-6xl md:text-8xl lg:text-9xl font-bold leading-[0.85] text-white uppercase select-none"
                        scrambleChars=".:01"
                        radius={200}
                    >
                        Contact
                    </ScrambledText>
                </div>
                <div class="w-32 h-[1px] bg-brand-orange/40 mt-6 hero-reveal opacity-0 scale-x-0"></div>
                <p class="font-sans text-sm md:text-base opacity-60 max-w-xl tracking-widest mt-6 hero-reveal opacity-0 translate-y-8 leading-relaxed uppercase">
                    Engineering precision meets human connection. Get in touch with the team leader.
                </p>
            </div>

            <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4 opacity-30 hero-reveal translate-y-8">
                <span class="text-[10px] uppercase tracking-[0.5em]">Scroll to Reach Out</span>
                <div class="w-[1px] h-12 bg-white/40"></div>
            </div>
        </section>

        <!-- CONTENT SECTION -->
        <section id="contact-content" class="relative z-20 bg-void pt-32 pb-32 w-full">
            <div class="grid grid-cols-1 lg:grid-cols-2 w-full gap-20 lg:gap-0 items-center">
                <!-- Left Column: Team Leader Info -->
                <div class="flex justify-center items-center w-full px-[5vw]">
                    <section class="space-y-12 contact-info max-w-xl w-full text-center">
                        <div class="reveal-item opacity-0 translate-y-8">
                            <h2 class="micro-label mb-2 opacity-50">Team Leader</h2>
                            <p class="text-4xl md:text-5xl xl:text-6xl font-bold text-white uppercase tracking-tight">
                                Malamas Bogatinis
                            </p>
                        </div>

                        <div class="reveal-item opacity-0 translate-y-8">
                            <h2 class="micro-label mb-4 opacity-50">Email</h2>
                            <a href="mailto:bogatinis@aristurtle.gr" class="text-xl md:text-2xl xl:text-3xl font-medium hover:text-brand-orange transition-colors duration-500 ease-expo block tracking-tight">
                                bogatinis@aristurtle.gr
                            </a>
                        </div>

                        <div class="reveal-item opacity-0 translate-y-8">
                            <h2 class="micro-label mb-4 opacity-50">Phone</h2>
                            <a href="tel:+306985878769" class="text-xl md:text-2xl xl:text-3xl font-medium hover:text-brand-orange transition-colors duration-500 ease-expo block tracking-tight">
                                (+30) 6985878769
                            </a>
                        </div>

                        <div class="flex gap-8 justify-center reveal-item opacity-0 translate-y-8">
                            <a href="#" class="micro-label hover:text-brand-orange transition-colors">Instagram</a>
                            <a href="#" class="micro-label hover:text-brand-orange transition-colors">LinkedIn</a>
                            <a href="#" class="micro-label hover:text-brand-orange transition-colors">Facebook</a>
                        </div>
                    </section>
                </div>

                <!-- Right Column: Map -->
                <div class="flex justify-center w-full px-[5vw]">
                    <section class="map-container relative aspect-square lg:aspect-video w-full max-w-2xl overflow-hidden border border-white/10 rounded-sm reveal-item opacity-0 scale-95">
                        <iframe 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3907.328648322064!2d22.959176700000004!3d40.6280927!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14a83901a3583c93%3A0x45866fbb8bbb3709!2sAristurtle%20(Aristotle%20University%20Racing%20Team%20Electric%20and%20Driverless)!5e1!3m2!1sen!2sgr!4v1780139291621!5m2!1sen!2sgr" 
                            width="100%" 
                            height="100%" 
                            style="border:0; filter: grayscale(1) invert(0.9) contrast(1.2);" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade"
                        ></iframe>
                    </section>
                </div>
            </div>
        </section>

        <!-- FOOTER SECTION (EMPTY SPACE) -->
        <div class="h-[30vh] w-full" aria-hidden="true"></div>
    </div>
</BaseLayout>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const LUXE_EASE = "cubic-bezier(0.16, 1, 0.3, 1)";

    window.addEventListener('DOMContentLoaded', () => {
        const mm = gsap.matchMedia();

        mm.add("(prefers-reduced-motion: no-preference)", (context) => {
            
            // Hero Image Parallax
            gsap.to("#hero-image", {
                scrollTrigger: {
                    trigger: "#hero",
                    start: "top top",
                    end: "bottom top",
                    scrub: true
                },
                y: 100,
                scale: 1.15,
                ease: "none"
            });

            // Hero Reveal
            gsap.to(".hero-reveal", {
                y: 0,
                scaleX: 1,
                opacity: 1,
                duration: 2,
                stagger: 0.15,
                ease: LUXE_EASE,
                delay: 0.2
            });

            // Content entrance
            gsap.to(".reveal-item", {
                scrollTrigger: {
                    trigger: "#contact-content",
                    start: "top 80%",
                },
                y: 0,
                scale: 1,
                opacity: 1,
                stagger: 0.1,
                duration: 1.2,
                ease: LUXE_EASE
            });

            return () => context.revert();
        });
    });
</script>

<style>
    .ease-expo {
        transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
</style>
