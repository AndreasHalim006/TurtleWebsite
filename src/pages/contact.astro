---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlindsHero from '../components/BlindsHero.astro';

const pageGradient = ['#9FFF10', '#00F3CB'];
---

<BaseLayout title="Contact | ARISTURTLE" description="Get in touch with Malamas Bogatinis, Team Leader of ARISTURTLE." pageColors={pageGradient}>
    <div class="bg-void min-h-screen w-full relative text-foreground selection:bg-brand-orange selection:text-brand-emerald">
        
        <!-- PURE BACKGROUND GRID -->
        <div class="fixed inset-0 z-0 micro-grid opacity-10 pointer-events-none"></div>

        <!-- HERO SECTION -->
        <div class="relative lg:sticky top-0 w-full h-[78svh] lg:h-[100svh] z-0">
            <BlindsHero title="CONTACT" description="Engineering precision meets human connection. Get in touch with the team leader." gradientColors={pageGradient} />
        </div>

        <div class="bg-void w-full relative z-10">

        <!-- CONTENT SECTION -->
        <section id="contact-content" class="relative z-20 bg-void py-[var(--mobile-section-space)] lg:py-32 w-full">
            <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 w-full gap-20 lg:gap-0 items-center">
                <!-- Left Column: Team Leader Info -->
                <div class="flex justify-center items-center w-full px-[5vw]">
                    <section class="space-y-10 lg:space-y-12 contact-info max-w-xl w-full text-left lg:text-center">
                        <div class="reveal-item lg:opacity-0 lg:translate-y-8">
                            <h2 class="micro-label mb-2 opacity-50">Team Leader</h2>
                            <p class="text-4xl md:text-5xl xl:text-6xl font-bold text-white uppercase tracking-tight">
                                Malamas Bogatinis
                            </p>
                        </div>

                        <div class="reveal-item lg:opacity-0 lg:translate-y-8">
                            <h2 class="micro-label mb-4 opacity-50">Email</h2>
                            <a href="mailto:info@aristurtle.gr" class="min-h-12 inline-flex items-center text-xl md:text-2xl xl:text-3xl font-medium hover:text-brand-orange transition-colors duration-500 ease-expo tracking-tight">
                                info@aristurtle.gr
                            </a>
                        </div>

                        <div class="reveal-item lg:opacity-0 lg:translate-y-8">
                            <h2 class="micro-label mb-4 opacity-50">Phone</h2>
                            <a href="tel:+306985878769" class="min-h-12 inline-flex items-center text-xl md:text-2xl xl:text-3xl font-medium hover:text-brand-orange transition-colors duration-500 ease-expo tracking-tight">
                                (+30) 6985878769
                            </a>
                        </div>

                        <div class="flex flex-wrap gap-4 lg:justify-center reveal-item lg:opacity-0 lg:translate-y-8">
                            <a href="https://www.instagram.com/arist.u.r.t.le/" target="_blank" rel="noopener noreferrer" class="gradient-underline micro-label min-h-11 inline-flex items-center hover:text-brand-orange transition-colors">Instagram</a>
                            <a href="https://www.linkedin.com/company/aristotle.university.racing.team.electric/" target="_blank" rel="noopener noreferrer" class="gradient-underline micro-label min-h-11 inline-flex items-center hover:text-brand-orange transition-colors">LinkedIn</a>
                            <a href="https://www.facebook.com/aristurtle" target="_blank" rel="noopener noreferrer" class="gradient-underline micro-label min-h-11 inline-flex items-center hover:text-brand-orange transition-colors">Facebook</a>
                        </div>
                    </section>
                </div>

                <!-- Right Column: Map -->
                <div class="flex justify-center w-full px-[5vw]">
                    <section class="map-container relative w-full max-w-2xl reveal-item lg:opacity-0 lg:scale-95">
                        <div class="aspect-square lg:aspect-video overflow-hidden border border-white/10">
                        <iframe 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3907.328648322064!2d22.959176700000004!3d40.6280927!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14a83901a3583c93%3A0x45866fbb8bbb3709!2sAristurtle%20(Aristotle%20University%20Racing%20Team%20Electric%20and%20Driverless)!5e1!3m2!1sen!2sgr!4v1780139291621!5m2!1sen!2sgr" 
                            width="100%" 
                            height="100%" 
                            title="ARISTURTLE workshop location on Google Maps"
                            style="border:0; filter: grayscale(1) invert(0.9) contrast(1.2);" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade"
                        ></iframe>
                        </div>
                        <a href="https://www.google.com/maps/search/?api=1&query=Aristurtle%20Thessaloniki" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex min-h-12 w-full items-center justify-center border border-white/20 text-xs font-bold uppercase tracking-[.16em] hover:border-brand-orange">Open in Maps</a>
                    </section>
                </div>
            </div>
        </section>

        </div>
    </div>
</BaseLayout>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const LUXE_EASE = "cubic-bezier(0.16, 1, 0.3, 1)";

    window.addEventListener('DOMContentLoaded', () => {
        const mm = gsap.matchMedia();

        mm.add("(min-width: 1024px) and (prefers-reduced-motion: no-preference)", (context) => {
            
            // Content entrance
            gsap.to(".reveal-item", {
                scrollTrigger: {
                    trigger: "#contact-content",
                    start: "top 80%",
                },
                y: 0,
                scale: 1,
                opacity: 1,
                stagger: 0.1,
                duration: 1.2,
                ease: LUXE_EASE
            });

            return () => context.revert();
        });
    });
</script>

<style>
    .ease-expo {
        transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
</style>
