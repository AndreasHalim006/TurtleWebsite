---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import { fsgPhotos } from '../data/fsg-media';
import { joinForm, joinBenefits, subdivisions, contact } from '../data/site';
---

<BaseLayout title="Join Us | ARISTURTLE" description="Join the Aristurtle Formula Student team and help build electric and driverless race cars.">
	<PageHero
		eyebrow="Join us"
		title="will you race with us?"
		subtitle="We do not just build race cars. We build the next generation of engineers, developers and professionals."
	/>

	<section class="section-pad bg-void">
		<div class="container-site grid items-center gap-14 lg:grid-cols-2 lg:gap-24">
			<div>
				<h2 class="h-section" data-reveal>shape the future</h2>
				<p class="lead mt-8" data-reveal>Be part of something bigger. Apply to join one of our subdivisions and work on a real electric and autonomous race car from your first semester.</p>
				<div class="mt-10 flex flex-wrap gap-4" data-reveal>
					<a href={joinForm} target="_blank" rel="noopener noreferrer" class="btn btn--solid">Apply Now</a>
					<a href={`mailto:${contact.email}`} class="btn">Ask a Question</a>
				</div>
			</div>
			<figure data-reveal>
				<Image src={fsgPhotos.teamwork.image} alt={fsgPhotos.teamwork.alt} class="aspect-[4/3] w-full object-cover" widths={[600, 1000, 1400]} sizes="(max-width: 1024px) 100vw, 50vw" loading="lazy" />
				<figcaption class="mt-3 text-xs text-muted">{fsgPhotos.teamwork.credit}</figcaption>
			</figure>
		</div>
	</section>

	<section class="border-y border-line bg-panel" aria-label="Benefits">
		<ul class="container-site grid gap-px py-0 md:grid-cols-3">
			{joinBenefits.map((b) => (
				<li class="flex flex-col gap-4 py-12 md:px-8 md:first:pl-0 md:last:pr-0" data-reveal>
					<h3 class="h-card">{b.title}</h3>
					<p class="text-muted">{b.desc}</p>
				</li>
			))}
		</ul>
	</section>

	<section class="section-pad bg-void" aria-labelledby="subs-title">
		<div class="container-site">
			<h2 id="subs-title" class="h-section" data-reveal>find your place</h2>
			<ul class="mt-12 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-4">
				{subdivisions.map((s) => (
					<li class="flex flex-col gap-3 bg-void p-7" data-reveal>
						<h3 class="h-card !text-xl">{s.name}</h3>
						<p class="text-sm text-muted">{s.description}</p>
					</li>
				))}
			</ul>
			<div class="mt-12" data-reveal>
				<a href={joinForm} target="_blank" rel="noopener noreferrer" class="btn btn--solid">Become a Team Member</a>
			</div>
		</div>
	</section>
</BaseLayout>
