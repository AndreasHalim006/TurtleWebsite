---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Placeholder from '../components/Placeholder.astro';

// TODO(content): replace with real videos (YouTube embeds or self-hosted files).
const videos = ['Car unveiling', 'Competition highlights', 'Driverless run', 'Workshop timelapse', 'Season recap', 'Team introduction'];
---

<BaseLayout title="Videos | ARISTURTLE" description="Videos from the Aristurtle workshop and competitions.">
	<PageHero
		eyebrow="Videos"
		title="the team in motion"
		subtitle="Unveilings, competition runs and behind-the-scenes from the workshop."
	/>

	<section class="section-pad bg-void">
		<div class="container-site grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
			{videos.map((v) => (
				<figure class="flex flex-col gap-4" data-reveal>
					<Placeholder label="Video 16:9" />
					<figcaption class="h-card !text-xl">{v}</figcaption>
				</figure>
			))}
		</div>
	</section>
</BaseLayout>
